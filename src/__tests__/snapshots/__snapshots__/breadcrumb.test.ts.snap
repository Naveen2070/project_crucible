exports[`Breadcrumb snapshots > react tailwind mode snapshot 1`] = `
"import React from 'react';

export type BreadcrumbSize = 'sm' | 'md' | 'lg';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

type DisplayItem = BreadcrumbItem & { ellipsis?: boolean };

export interface BreadcrumbProps extends Omit<React.HTMLAttributes<HTMLElement>, 'children'> {
  /** Ordered trail of crumbs (last item is the current page) */
  items: BreadcrumbItem[];
  /** Separator between crumbs */
  separator?: React.ReactNode;
  size?: BreadcrumbSize;
  /** Collapse the middle of long trails to an ellipsis */
  maxItems?: number;
}

const SIZE_CLASSES: Record<BreadcrumbSize, string> = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
};

function buildDisplay(items: BreadcrumbItem[], maxItems?: number): DisplayItem[] {
  if (maxItems && maxItems >= 2 && items.length > maxItems) {
    return [items[0], { label: '…', ellipsis: true }, ...items.slice(items.length - (maxItems - 1))];
  }
  return items;
}

export const Breadcrumb = React.forwardRef<HTMLElement, BreadcrumbProps>(
  ({ items, separator = '/', size = 'md', maxItems, className, ...props }, ref) => {
    const display = buildDisplay(items, maxItems);
    const cls = ['font-sans', SIZE_CLASSES[size], className || ''].filter(Boolean).join(' ');

    return (
      <nav ref={ref} aria-label="Breadcrumb" className={cls} {...props}>
        <ol className="flex flex-wrap items-center gap-2 m-0 p-0 list-none">
          {display.map((item, i) => {
            const isLast = i === display.length - 1;
            return (
              <li key={i} className="inline-flex items-center gap-2">
                {item.ellipsis ? (
                  <span className="text-[var(--breadcrumb-separator-color,var(--color-text-muted))] select-none" aria-hidden="true">
                    {item.label}
                  </span>
                ) : item.href && !isLast ? (
                  <a
                    href={item.href}
                    className="text-[var(--breadcrumb-link-color,var(--color-text-muted))] no-underline hover:underline hover:text-[var(--color-text)]"
                  >
                    {item.label}
                  </a>
                ) : (
                  <span className="font-medium text-[var(--breadcrumb-active-color,var(--color-text))]" aria-current={isLast ? 'page' : undefined}>
                    {item.label}
                  </span>
                )}
                {!isLast && (
                  <span className="text-[var(--breadcrumb-separator-color,var(--color-text-muted))] select-none" aria-hidden="true">
                    {separator}
                  </span>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
    );
  }
);

Breadcrumb.displayName = 'Breadcrumb';
"
`;

exports[`Breadcrumb snapshots > vue css mode snapshot 1`] = `
"<script setup lang="ts">
import { computed } from 'vue';

export type BreadcrumbSize = 'sm' | 'md' | 'lg';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items?:     BreadcrumbItem[];
  separator?: string;
  size?:      BreadcrumbSize;
  maxItems?:  number;
}

const props = withDefaults(defineProps<Props>(), {
  items: () => [],
  separator: '/',
  size: 'md',
  maxItems: 0,
});

const display = computed<(BreadcrumbItem & { ellipsis?: boolean })[]>(() => {
  const items = props.items;
  if (props.maxItems && props.maxItems >= 2 && items.length > props.maxItems) {
    return [items[0], { label: '…', ellipsis: true }, ...items.slice(items.length - (props.maxItems - 1))];
  }
  return items.map((i) => ({ ...i }));
});
</script>

<template>
  <nav aria-label="Breadcrumb" :class="['breadcrumb', \`breadcrumb--\${size}\`]">
    <ol class="breadcrumb-list">
      <li v-for="(item, i) in display" :key="i" class="breadcrumb-item">
        <span v-if="item.ellipsis" class="breadcrumb-ellipsis" aria-hidden="true">{{ item.label }}</span>
        <a v-else-if="item.href && i !== display.length - 1" :href="item.href" class="breadcrumb-link">{{ item.label }}</a>
        <span v-else class="breadcrumb-current" :aria-current="i === display.length - 1 ? 'page' : undefined">{{ item.label }}</span>
        <span v-if="i !== display.length - 1" class="breadcrumb-separator" aria-hidden="true">{{ separator }}</span>
      </li>
    </ol>
  </nav>
</template>

<style scoped>
/* Generated by Crucible — edit freely, re-generate with --force */

.breadcrumb {
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
}

.breadcrumb--sm {
  font-size: 0.75rem;
}

.breadcrumb--md {
  font-size: 0.875rem;
}

.breadcrumb--lg {
  font-size: 1rem;
}

.breadcrumb-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--breadcrumb-gap, calc(var(--spacing-unit) * 2));
  margin: 0;
  padding: 0;
  list-style: none;
}

.breadcrumb-item {
  display: inline-flex;
  align-items: center;
  gap: var(--breadcrumb-gap, calc(var(--spacing-unit) * 2));
}

.breadcrumb-link {
  color: var(--breadcrumb-link-color, var(--color-text-muted));
  text-decoration: none;
}

.breadcrumb-link:hover {
  color: var(--breadcrumb-active-color, var(--color-text));
  text-decoration: underline;
}

.breadcrumb-current {
  color: var(--breadcrumb-active-color, var(--color-text));
  font-weight: 500;
}

.breadcrumb-separator,
.breadcrumb-ellipsis {
  color: var(--breadcrumb-separator-color, var(--color-text-muted));
  user-select: none;
}
</style>
"
`;
