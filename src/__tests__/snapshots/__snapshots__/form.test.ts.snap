  "Form.module.css": "/* Generated by Crucible — edit freely, re-generate with --force */

.form {
  display: flex;
  flex-direction: column;
  gap: var(--form-group-gap, calc(var(--spacing-unit) * 5));
  width: 100%;
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  color: var(--color-text, #1a1a2e);
}

/* Layout variants */
.variant-default {
  /* vertical stack (default) */
}

.variant-inline {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-end;
}

/* Sizes drive control height + base font-size */
.size-sm {
  --form-control-h: var(--form-control-height-sm, calc(var(--spacing-unit) * 9));
  font-size: 0.8125rem;
}
.size-md {
  --form-control-h: var(--form-control-height-md, calc(var(--spacing-unit) * 10));
  font-size: 0.875rem;
}
.size-lg {
  --form-control-h: var(--form-control-height-lg, calc(var(--spacing-unit) * 11));
  font-size: 0.9375rem;
}

/* Field is a provider only — it must not introduce a layout box */
.field {
  display: contents;
}

.item {
  display: flex;
  flex-direction: column;
  gap: var(--form-item-gap, calc(var(--spacing-unit) * 1.5));
  width: 100%;
}
.variant-inline .item {
  width: auto;
}

.label {
  display: inline-flex;
  align-items: center;
  gap: calc(var(--spacing-unit, 4px) * 0.5);
  font-size: 0.875rem;
  font-weight: var(--form-label-weight, 500);
  color: var(--form-label-color, var(--color-text));
}
.label[data-invalid='true'] {
  color: var(--form-error-color, var(--color-destructive));
}

.required {
  color: var(--form-required-color, var(--color-destructive));
}

.control {
  min-height: var(--form-control-h, var(--form-control-height-md, calc(var(--spacing-unit) * 10)));
  width: 100%;
  box-sizing: border-box;
  padding: 0 calc(var(--spacing-unit, 4px) * 3);
  border: 1px solid var(--color-border, #e2e1f0);
  border-radius: var(--form-radius, var(--radius-md));
  background: var(--color-surface, #fff);
  color: inherit;
  font: inherit;
  transition: var(--form-transition, border-color 0.2s ease, box-shadow 0.2s ease);
}
.control:focus-visible {
  outline: none;
  border-color: var(--color-primary, #6c63ff);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary, #6c63ff) 20%, transparent);
}
.control[aria-invalid='true'] {
  border-color: var(--form-error-color, var(--color-destructive));
}

.description {
  margin: 0;
  font-size: var(--form-description-size, 0.75rem);
  color: var(--form-description-color, var(--color-text-muted));
}

.message {
  margin: 0;
  font-size: var(--form-description-size, 0.75rem);
  color: var(--form-error-color, var(--color-destructive));
}
.message:empty {
  display: none;
}
.message[data-invalid='true'] {
  animation: form-message-in 120ms ease-out;
}

.submit {
  align-self: flex-start;
  min-height: var(--form-control-h, var(--form-control-height-md, calc(var(--spacing-unit) * 10)));
  padding: 0 calc(var(--spacing-unit, 4px) * 4);
  border: none;
  border-radius: var(--form-radius, var(--radius-md));
  background: var(--color-primary, #6c63ff);
  color: var(--color-primary-foreground, #fff);
  font: inherit;
  font-weight: 500;
  cursor: pointer;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}
.submit:hover:not(:disabled) {
  background: var(--color-primary-hover, var(--color-primary, #6c63ff));
}
.submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.submit:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}

@keyframes form-message-in {
  from {
    opacity: 0;
    transform: translateY(-2px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .message[data-invalid='true'] {
    animation: none;
  }
}
