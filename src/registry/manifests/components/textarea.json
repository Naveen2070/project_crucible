{
  "id": "Textarea",
  "name": "Textarea",
  "description": "Multi-line text input with label, hint, and error states",
  "frameworks": ["react", "vue", "angular", "react-native"],
  "styleSystems": ["css", "tailwind", "scss", "nativewind", "stylesheet"],
  "variants": ["default", "error"],
  "sizes": ["sm", "md", "lg"],
  "states": ["disabled", "error"],
  "props": ["rows", "maxLength", "label", "hint", "id", "required", "placeholder"],
  "prefix": "textarea",
  "a11y": { "role": "textbox" },
  "tailwindDefaults": {
    "default": "border-[var(--color-border)] focus:border-[var(--color-primary)]",
    "error": "border-[var(--color-destructive)] focus:border-[var(--color-destructive)]"
  },
  "nativewindDefaults": {
    "default": "border-border text-foreground",
    "error": "border-destructive text-foreground"
  }
}
