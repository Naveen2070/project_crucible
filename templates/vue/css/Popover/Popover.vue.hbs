<script setup lang="ts">
import { ref, onMounted, onUnmounted, computed, watch, nextTick, getCurrentInstance{{#if vueUseId}}, useId{{/if}} } from 'vue';
import { useFloating, offset, flip, shift, autoUpdate, arrow, type Placement } from '@floating-ui/vue';

interface PopoverProps {
  /** Controlled open state */
  isOpen?: boolean;
  /** Placement relative to trigger */
  placement?: 'top' | 'bottom' | 'left' | 'right';
  /** Alignment relative to trigger */
  alignment?: 'start' | 'center' | 'end';
  /** Visual variant */
  variant?: 'default' | 'minimal';
  /** Size */
  size?: 'sm' | 'md' | 'lg';
  /** Additional class name */
  className?: string;
  /** Trigger event type */
  trigger?: 'click' | 'hover';
  /** Whether to close when clicking outside */
  closeOnClickOutside?: boolean;
  /** Whether to close when pressing Escape */
  closeOnEscape?: boolean;
  /** Whether to show the arrow */
  showArrow?: boolean;
  /** Modal mode: traps focus inside the popover while open. Default false. */
  modal?: boolean;
  /** Accessible label for the popover dialog */
  ariaLabel?: string;
}

const props = withDefaults(defineProps<PopoverProps>(), {
  placement: 'bottom',
  alignment: 'center',
  variant: 'default',
  size: 'md',
  className: '',
  trigger: 'click',
  closeOnClickOutside: true,
  closeOnEscape: true,
  showArrow: true,
  modal: false,
  ariaLabel: undefined,
});

const emit = defineEmits<{
  (e: 'update:isOpen', value: boolean): void;
}>();

const instance = getCurrentInstance();
const isControlled = computed(() => {
  if (!instance) return false;
  const propsObj = instance.vnode.props || {};
  return 'isOpen' in propsObj || 'is-open' in propsObj;
});

const internalOpen = ref(false);
const isOpen = computed({
  get: () => (isControlled.value ? props.isOpen : internalOpen.value),
  set: (val) => {
    internalOpen.value = val;
    emit('update:isOpen', val);
  },
});

{{#if vueUseId}}
const uid = useId();
{{else}}
const uid = (instance?.uid ?? 0).toString(36);
{{/if}}
const contentId = `popover-content-${uid}`;

const contentRef = ref<HTMLElement | null>(null);
const triggerRef = ref<HTMLElement | null>(null);
const arrowRef = ref<HTMLElement | null>(null);

let closeTimeout: number | undefined;
let previouslyFocused: HTMLElement | null = null;

const FOCUSABLE_SELECTOR =
  'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

const toggle = () => {
  if (props.trigger === 'click') {
    isOpen.value = !isOpen.value;
  }
};

const close = () => {
  isOpen.value = false;
};

const handleMouseEnter = () => {
  if (props.trigger === 'hover') {
    if (closeTimeout) {
      clearTimeout(closeTimeout);
      closeTimeout = undefined;
    }
    isOpen.value = true;
  }
};

const handleMouseLeave = () => {
  if (props.trigger === 'hover') {
    closeTimeout = window.setTimeout(() => {
      isOpen.value = false;
    }, 150);
  }
};

const handleClickOutside = (event: MouseEvent) => {
  if (!props.closeOnClickOutside) return;
  if (
    isOpen.value &&
    contentRef.value &&
    !contentRef.value.contains(event.target as Node) &&
    triggerRef.value &&
    !triggerRef.value.contains(event.target as Node)
  ) {
    close();
  }
};

const handleKeydown = (event: KeyboardEvent) => {
  if (!isOpen.value) return;

  if (props.closeOnEscape && event.key === 'Escape') {
    close();
    return;
  }

  if (event.key === 'Tab' && props.modal && contentRef.value) {
    const focusables = Array.from(
      contentRef.value.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
    ).filter((el) => el.offsetParent !== null);

    if (focusables.length === 0) {
      event.preventDefault();
      contentRef.value.focus();
      return;
    }

    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement as HTMLElement | null;

    if (event.shiftKey && (active === first || !contentRef.value.contains(active))) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }
};

onMounted(() => {
  document.addEventListener('mousedown', handleClickOutside);
  document.addEventListener('keydown', handleKeydown);
});

onUnmounted(() => {
  document.removeEventListener('mousedown', handleClickOutside);
  document.removeEventListener('keydown', handleKeydown);
  if (closeTimeout) {
    clearTimeout(closeTimeout);
  }
});

watch(isOpen, async (open) => {
  if (open) {
    if (props.trigger === 'click') {
      previouslyFocused = document.activeElement as HTMLElement | null;
    }
    await nextTick();
    if (props.trigger === 'click' && contentRef.value) {
      const focusable = contentRef.value.querySelector<HTMLElement>(FOCUSABLE_SELECTOR);
      (focusable ?? contentRef.value).focus({ preventScroll: true });
    }
  } else if (previouslyFocused && typeof previouslyFocused.focus === 'function') {
    previouslyFocused.focus({ preventScroll: true });
    previouslyFocused = null;
  }
});

const floatingPlacement = computed<Placement>(
  () =>
    `${props.placement}${props.alignment === 'center' ? '' : '-' + props.alignment}` as Placement,
);

const middleware = computed(() => {
  const list = [offset(props.showArrow ? 12 : 8), flip(), shift({ padding: 8 })];
  if (props.showArrow && arrowRef.value) {
    list.push(arrow({ element: arrowRef }));
  }
  return list;
});

const { floatingStyles, middlewareData, placement, isPositioned } = useFloating(
  triggerRef,
  contentRef,
  {
    placement: floatingPlacement,
    open: isOpen,
    middleware,
    transform: false,
    whileElementsMounted: autoUpdate,
  },
);

const side = computed(() => placement.value.split('-')[0]);

const arrowStyle = computed(() => {
  const { x, y } = middlewareData.value.arrow || {};
  const staticSide = {
    top: 'bottom',
    right: 'left',
    bottom: 'top',
    left: 'right',
  }[side.value];

  return {
    left: x != null ? `${x}px` : '',
    top: y != null ? `${y}px` : '',
    [staticSide as string]: '-4px',
  };
});

const contentClasses = computed(() => {
  return [
    'popover-content',
    `variant-${props.variant}`,
    `size-${props.size}`,
    props.className,
  ];
});
</script>

<template>
  <div class="popover-root" @mouseenter="handleMouseEnter" @mouseleave="handleMouseLeave">
    <div
      ref="triggerRef"
      class="popover-trigger"
      @click="toggle"
      :aria-expanded="isOpen"
      :aria-controls="isOpen ? contentId : undefined"
      aria-haspopup="dialog"
    >
      {{#if features.compoundComponents}}
      <slot name="trigger" :isOpen="isOpen"></slot>
      {{else}}
      <slot name="trigger">
        <button type="button" class="px-4 py-2 bg-primary text-primary-foreground rounded-md">
          Trigger
        </button>
      </slot>
      {{/if}}
    </div>

    <Teleport to="body">
      <div
        v-if="isOpen"
        ref="contentRef"
        :id="contentId"
        :class="contentClasses"
        :style="[floatingStyles, { visibility: isPositioned ? 'visible' : 'hidden' }]"
        :data-state="isOpen && isPositioned ? 'open' : 'closed'"
        :data-placement="placement"
        :data-side="side"
        role="dialog"
        :aria-modal="modal ? 'true' : undefined"
        :aria-label="ariaLabel"
        tabindex="-1"
        @mouseenter="handleMouseEnter"
        @mouseleave="handleMouseLeave"
      >
        {{#if features.compoundComponents}}
        <slot name="content" :close="close"></slot>
        {{else}}
        <slot></slot>
        {{/if}}

        <div
          v-if="showArrow"
          ref="arrowRef"
          class="popover-arrow"
          :class="'arrow-' + side"
          :style="arrowStyle"
          aria-hidden="true"
        ></div>
      </div>
    </Teleport>
  </div>
</template>

<style scoped {{#if (eq styleSystem "scss")}}lang="scss"{{/if}}>
.popover-root {
  display: inline-block;
}

.popover-trigger {
  display: inline-block;
}

.popover-content {
  position: absolute;
  z-index: var(--popover-z-index, {{tokens.componentTokens.popover.zIndex}});
  background: var(--popover-background, {{tokens.componentTokens.popover.background}});
  color: var(--color-text, var(--foreground, #1A1A2E));
  border: 1px solid var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-radius: var(--popover-radius, {{tokens.componentTokens.popover.radius}});
  box-shadow: var(
    --popover-shadow,
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -2px rgba(0, 0, 0, 0.1)
  );
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  outline: none;
  max-width: calc(100vw - 16px);
}

.popover-content:focus-visible {
  outline: 2px solid var(--color-primary, #6C63FF);
  outline-offset: 2px;
}

.popover-arrow {
  position: absolute;
  width: 8px;
  height: 8px;
  background: inherit;
  border: 1px solid transparent;
  transform: rotate(45deg);
}

.arrow-top {
  border-right-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-bottom-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-bottom {
  border-left-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-top-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-left {
  border-top-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-right-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-right {
  border-left-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-bottom-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

/* Variants */
.variant-default {
  /* uses defaults above */
}

.variant-minimal {
  border: none;
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.08),
    0 2px 4px -1px rgba(0, 0, 0, 0.04);
}

/* Sizes */
.size-sm {
  font-size: 0.8125rem;
  min-width: 200px;
  padding: 12px;
}

.size-md {
  font-size: 0.875rem;
  min-width: 288px;
  padding: 16px;
}

.size-lg {
  font-size: 0.9375rem;
  min-width: 360px;
  padding: 20px;
}

/* Animation — gated on data-state so it only runs after positioning settles */
.popover-content[data-state='open'] {
  animation: popover-show 150ms cubic-bezier(0.16, 1, 0.3, 1);
}

.popover-content[data-state='open'][data-side='top'] {
  animation-name: popover-slide-down;
}
.popover-content[data-state='open'][data-side='bottom'] {
  animation-name: popover-slide-up;
}
.popover-content[data-state='open'][data-side='left'] {
  animation-name: popover-slide-right;
}
.popover-content[data-state='open'][data-side='right'] {
  animation-name: popover-slide-left;
}

@keyframes popover-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes popover-slide-up {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-down {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-left {
  from {
    opacity: 0;
    transform: translateX(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes popover-slide-right {
  from {
    opacity: 0;
    transform: translateX(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .popover-content[data-state='open'] {
    animation: none;
  }
}
</style>
