export const AllPlacements: Story = {
  parameters: { layout: 'centered' },
  decorators: [
    () => ({
      template: '<div style="min-height: 480px; display: flex; align-items: center; justify-content: center; padding: 80px;"><story /></div>',
    }),
  ],
  render: (args) => ({
    components: { Popover, Button },
    setup() {
      const sides = ['top', 'bottom', 'left', 'right'] as const;
      const alignments = ['start', 'center', 'end'] as const;
      const placements = sides.flatMap((side) =>
        alignments.map((alignment) => ({ side, alignment, label: `${side}-${alignment}` })),
      );
      return { args, placements };
    },
    template: `
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
        <Popover
          v-for="p in placements"
          :key="p.label"
          v-bind="args"
          :placement="p.side"
          :alignment="p.alignment"
        >
          {{#if features.compoundComponents}}
          <template #trigger>
            <Button size="sm" variant="outline" v-text="p.label"></Button>
          </template>
          <template #content>
            <p style="margin: 0; font-size: 0.8125rem;">
              Placement: <strong v-text="p.label"></strong>
            </p>
          </template>
          {{else}}
          <template #trigger>
            <Button size="sm" variant="outline" v-text="p.label"></Button>
          </template>
          <p style="margin: 0; font-size: 0.8125rem;">
            Placement: <strong v-text="p.label"></strong>
          </p>
          {{/if}}
        </Popover>
      </div>
    `,
  }),
};

export const VariantsAndSizes: Story = {
  render: (args) => ({
    components: { Popover, Button },
    setup() {
      const variants = ['default', 'minimal'] as const;
      const sizes = ['sm', 'md', 'lg'] as const;
      const cells = variants.flatMap((variant) =>
        sizes.map((size) => ({
          variant,
          size,
          buttonLabel: `${variant} / ${size}`,
          headingLabel: `${variant} · ${size}`,
        })),
      );
      return { args, cells };
    },
    template: `
      <div style="display: grid; grid-template-columns: repeat(3, auto); gap: 24px; align-items: center; justify-items: center;">
        <Popover
          v-for="cell in cells"
          :key="cell.buttonLabel"
          v-bind="args"
          :variant="cell.variant"
          :size="cell.size"
        >
          {{#if features.compoundComponents}}
          <template #trigger>
            <Button :size="cell.size" v-text="cell.buttonLabel"></Button>
          </template>
          <template #content>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <strong style="font-size: 0.875rem;" v-text="cell.headingLabel"></strong>
              <p style="margin: 0; font-size: inherit; color: var(--color-text-muted, #6B6B8A);">
                Body text scales with the size token.
              </p>
            </div>
          </template>
          {{else}}
          <template #trigger>
            <Button :size="cell.size" v-text="cell.buttonLabel"></Button>
          </template>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <strong style="font-size: 0.875rem;" v-text="cell.headingLabel"></strong>
            <p style="margin: 0; font-size: inherit; color: var(--color-text-muted, #6B6B8A);">
              Body text scales with the size token.
            </p>
          </div>
          {{/if}}
        </Popover>
      </div>
    `,
  }),
};

export const Controlled: Story = {
  render: (args) => ({
    components: { Popover, Button },
    setup() {
      const isOpen = ref(false);
      return { args, isOpen };
    },
    template: `
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: center;">
        <Button variant="ghost" @click="isOpen = !isOpen">
          External toggle &mdash; currently \{{ isOpen ? 'open' : 'closed' }}
        </Button>

        <Popover v-bind="args" v-model:isOpen="isOpen">
          {{#if features.compoundComponents}}
          <template #trigger>
            <Button variant="outline">Popover Trigger</Button>
          </template>
          <template #content>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <p style="margin: 0; font-size: 0.875rem;">
                This popover's open state is controlled by the parent component.
              </p>
              <Button size="sm" @click="isOpen = false">Close from inside</Button>
            </div>
          </template>
          {{else}}
          <template #trigger>
            <Button variant="outline">Popover Trigger</Button>
          </template>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <p style="margin: 0; font-size: 0.875rem;">
              This popover's open state is controlled by the parent component.
            </p>
            <Button size="sm" @click="isOpen = false">Close from inside</Button>
          </div>
          {{/if}}
        </Popover>
      </div>
    `,
  }),
};

