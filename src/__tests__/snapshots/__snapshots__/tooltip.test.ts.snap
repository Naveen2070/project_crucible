  "Tooltip.module.css": ".trigger {
  all: unset;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.content {
  position: absolute;
  z-index: var(--tooltip-z-index, 60);
  background-color: var(--tooltip-background, var(--color-surface));
  color: var(--tooltip-text, var(--color-text, #1A1A2E));
  border: 1px solid var(--tooltip-border, var(--color-border));
  border-radius: var(--tooltip-radius, var(--radius-md));
  box-shadow: var(
    --tooltip-shadow,
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -1px rgba(0, 0, 0, 0.06)
  );
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  line-height: 1.4;
  outline: none;
  pointer-events: none;
  max-width: 280px;
  transform-origin: var(--floating-ui-transform-origin);
}

/* Variants */
.variant-default {
  /* uses defaults above */
}

.variant-minimal {
  border: none;
  box-shadow:
    0 2px 4px -1px rgba(0, 0, 0, 0.08),
    0 1px 2px -1px rgba(0, 0, 0, 0.04);
}

/* Sizes */
.size-sm {
  font-size: 0.75rem;
  padding: 4px 8px;
}

.size-md {
  font-size: 0.8125rem;
  padding: 6px 10px;
}

.size-lg {
  font-size: 0.875rem;
  padding: 8px 12px;
}

/* Animation — gated on data-state so it only runs after positioning settles */
.content[data-state='open'] {
  animation: tooltip-show 150ms cubic-bezier(0.16, 1, 0.3, 1);
}

.content[data-state='open'][data-side='top'] {
  animation-name: tooltip-slide-down;
}
.content[data-state='open'][data-side='bottom'] {
  animation-name: tooltip-slide-up;
}
.content[data-state='open'][data-side='left'] {
  animation-name: tooltip-slide-right;
}
.content[data-state='open'][data-side='right'] {
  animation-name: tooltip-slide-left;
}

@keyframes tooltip-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes tooltip-slide-up {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tooltip-slide-down {
