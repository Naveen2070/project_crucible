import { Meta, StoryObj } from '@storybook/angular';
import { BadgeComponent } from './badge.component';

const meta: Meta<BadgeComponent> = {
  title: 'Crucible/Badge',
  component: BadgeComponent,
  tags: ['autodocs'],
  argTypes: {
    variant: { control: 'select', options: {{> shared/variant-options}} },
    size:    { control: 'select', options: {{> shared/size-options}} },
  },
};

export default meta;
type Story = StoryObj<BadgeComponent>;

export const Default: Story = {
  args: { variant: 'default', size: 'md' },
  render: (args) => ({
    props: args,
    template: `<app-badge [variant]="variant" [size]="size">Badge</app-badge>`,
  }),
};

{{#each variants}}
{{#unless (eq this "default")}}
export const {{capitalize this}}: Story = {
  args: { variant: '{{this}}' },
  render: (args) => ({
    props: args,
    template: `<app-badge [variant]="variant" [size]="size">{{capitalize this}}</app-badge>`,
  }),
};
{{/unless}}
{{/each}}

{{#each sizes}}
export const Size{{capitalize this}}: Story = {
  args: { size: '{{this}}' },
  render: (args) => ({
    props: args,
    template: `<app-badge [variant]="variant" [size]="size">{{capitalize this}}</app-badge>`,
  }),
};
{{/each}}
