export const HoverTrigger: Story = {
  args: {
    trigger: 'hover',
  },
  render: (args) => (
    <Popover.Root {...args}>
      <Popover.Trigger asChild>
        <span style=\{{ textDecoration: 'underline', cursor: 'help' }}>Hover me for info</span>
      </Popover.Trigger>
      <Popover.Portal>
        <Popover.Content style=\{{ maxWidth: '200px' }}>
          <p style=\{{ margin: 0, fontSize: '0.875rem' }}>
            This popover opens on hover and uses a safe polygon to stay open while moving to the content.
          </p>
        </Popover.Content>
      </Popover.Portal>
    </Popover.Root>
  ),
