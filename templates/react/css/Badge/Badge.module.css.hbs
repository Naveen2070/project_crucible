.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--badge-gap, {{tokens.componentTokens.badge.gap}});
  border: 1px solid transparent;
  border-radius: var(--badge-radius, {{tokens.componentTokens.badge.radius}});
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  font-weight: var(--badge-font-weight, {{tokens.componentTokens.badge.fontWeight}});
  line-height: 1;
  white-space: nowrap;
}

/* Sizes */
.badge--sm {
  font-size: 0.6875rem;
  padding: 2px 6px;
}

.badge--md {
  font-size: var(--badge-font-size, {{tokens.componentTokens.badge.fontSize}});
  padding: 3px 8px;
}

.badge--lg {
  font-size: 0.8125rem;
  padding: 4px 10px;
}

/* Variants */
.badge--default {
  background-color: var(--badge-secondary-bg, {{tokens.componentTokens.badge.secondaryBg}});
  color: var(--color-text, #1A1A2E);
}

.badge--primary {
  background-color: var(--badge-primary-bg, {{tokens.componentTokens.badge.primaryBg}});
  color: var(--badge-on-color, {{tokens.componentTokens.badge.onColor}});
}

.badge--secondary {
  background-color: var(--badge-secondary-bg, {{tokens.componentTokens.badge.secondaryBg}});
  color: var(--color-text, #1A1A2E);
}

.badge--outline {
  background-color: transparent;
  border-color: var(--color-border, #E2E1F0);
  color: var(--color-text, #1A1A2E);
}

.badge--success {
  background-color: var(--badge-success-bg, {{tokens.componentTokens.badge.successBg}});
  color: var(--badge-on-color, {{tokens.componentTokens.badge.onColor}});
}

.badge--warning {
  background-color: var(--badge-warning-bg, {{tokens.componentTokens.badge.warningBg}});
  color: var(--badge-on-color, {{tokens.componentTokens.badge.onColor}});
}

.badge--destructive {
  background-color: var(--badge-destructive-bg, {{tokens.componentTokens.badge.destructiveBg}});
  color: var(--badge-on-color, {{tokens.componentTokens.badge.onColor}});
}
