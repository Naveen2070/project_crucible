exports[`React Native snapshots > StyleSystem: stylesheet > Component: Alert > renders correctly 1`] = `
{
  "Alert.stories.tsx": "// Crucible preview examples for Alert (React Native / StyleSheet).
// ponytail: Storybook for React Native isn't wired up in this release (needs Expo +
// @storybook/react-native) — these are ready-to-spread prop presets for manual/visual QA
// (e.g. \`<Alert {...AlertPreviews.info}>Message</Alert>\`), not a Storybook CSF file.
import type { AlertProps } from './Alert';

export const AlertPreviews: Record<string, AlertProps> = {
  default: { variant: 'default', title: 'Default' },
  info: { variant: 'info', title: 'Info' },
  success: { variant: 'success', title: 'Success' },
  warning: { variant: 'warning', title: 'Warning' },
  destructive: { variant: 'destructive', title: 'Destructive' },
  closeable: { variant: 'info', title: 'Dismissible', closeable: true },
};
",
  "Alert.tsx": "import React from 'react';
import { View, Text, Pressable, StyleSheet, type ViewProps } from 'react-native';
import { theme } from '../../../theme';

export type AlertVariant = 'default' | 'info' | 'success' | 'warning' | 'destructive';

export interface AlertProps extends ViewProps {
  variant?:   AlertVariant;
  title?:     string;
  closeable?: boolean;
  onClose?:   () => void;
  icon?:      React.ReactNode;
  children?:  React.ReactNode;
}

const DEFAULT_ICONS: Record<AlertVariant, string> = {
  default: 'ℹ',
  info: 'ℹ',
  success: '✓',
  warning: '⚠',
  destructive: '✕',
};

function withAlpha(hex: string, alpha: string): string {
  return hex + alpha;
}

const variantStyles: Record<AlertVariant, { container: object; text: object }> = {
  default:     { container: { backgroundColor: theme.colorSurface, borderColor: theme.colorBorder }, text: { color: theme.foreground } },
  info:        { container: { backgroundColor: withAlpha(theme.colorPrimary, '1A'), borderColor: theme.colorPrimary }, text: { color: theme.foreground } },
  success:     { container: { backgroundColor: withAlpha(theme.colorSuccess, '1A'), borderColor: theme.colorSuccess }, text: { color: theme.foreground } },
  warning:     { container: { backgroundColor: '#f59e0b1A', borderColor: '#f59e0b' }, text: { color: theme.foreground } },
  destructive: { container: { backgroundColor: withAlpha(theme.colorDestructive, '1A'), borderColor: theme.colorDestructive }, text: { color: theme.foreground } },
};

const styles = StyleSheet.create({
  base: { flexDirection: 'row', alignItems: 'flex-start', gap: 12, padding: 12, borderRadius: Number.parseInt(theme.radiusMd, 10) || 8, borderWidth: 1 },
  icon: { lineHeight: 18 },
  body: { flex: 1 },
  title: { fontWeight: '600', fontSize: 14, marginBottom: 2 },
  description: { fontSize: 13 },
  close: { lineHeight: 18, fontSize: 18 },
});

// StyleSheet variant sets color directly on each Text (no compound sub-components, so — unlike
// Button — no context/inheritance trick is needed; every element here is rendered by this file).
export const Alert = React.forwardRef<View, AlertProps>(
  ({ variant = 'default', title, closeable = false, onClose, icon, style, children }, ref) => {
    const variantStyle = variantStyles[variant];

    return (
      <View ref={ref} accessibilityRole="alert" style={[styles.base, variantStyle.container, style]}>
        <Text style={[styles.icon, variantStyle.text]} accessibilityElementsHidden importantForAccessibility="no-hide-descendants">
          {icon ?? DEFAULT_ICONS[variant]}
        </Text>
        <View style={styles.body}>
          {title && <Text style={[styles.title, variantStyle.text]}>{title}</Text>}
          {children && (typeof children === 'string' ? <Text style={[styles.description, variantStyle.text]}>{children}</Text> : children)}
        </View>
        {closeable && (
          <Pressable onPress={onClose} accessibilityRole="button" accessibilityLabel="Dismiss">
            <Text style={[styles.close, variantStyle.text]}>×</Text>
          </Pressable>
        )}
      </View>
    );
  }
);

Alert.displayName = 'Alert';
",
  "README.md": "# Alert

