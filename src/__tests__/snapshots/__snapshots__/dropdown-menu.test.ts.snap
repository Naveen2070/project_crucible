  border: none;
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.08),
    0 2px 4px -1px rgba(0, 0, 0, 0.04);
}
.menu-content.size-sm {
  font-size: 0.8125rem;
}
.menu-content.size-md {
  font-size: 0.875rem;
}
.menu-content.size-lg {
  font-size: 0.9375rem;
}
.menu-content .item {
  all: unset;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: calc(var(--spacing-unit, 4px) * 2);
  width: 100%;
  padding: var(--menu-item-padding-y, calc(var(--spacing-unit) * 2))
    var(--menu-item-padding-x, calc(var(--spacing-unit) * 3));
  border-radius: calc(var(--menu-radius, var(--radius-md)) - 2px);
  cursor: pointer;
  color: inherit;
  user-select: none;
}
.menu-content .item:hover:not([data-disabled]),
.menu-content .item:focus-visible {
  background-color: var(--menu-item-hover-bg, var(--color-secondary));
  outline: none;
}
.menu-content .item[data-disabled] {
