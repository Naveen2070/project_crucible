{
  "Button.stories.tsx": "// Crucible preview examples for Button (React Native / NativeWind).
// ponytail: Storybook for React Native isn't wired up in this release (needs Expo +
// @storybook/react-native) — these are ready-to-spread prop presets for manual/visual QA
// (e.g. \`<Button {...ButtonPreviews.primary}>Button</Button>\`), not a Storybook CSF file.
import type { ButtonProps } from './Button';

export const ButtonPreviews: Record<string, Omit<ButtonProps, 'children'>> = {
  default: { variant: 'default' },
  primary: { variant: 'primary' },
  secondary: { variant: 'secondary' },
  outline: { variant: 'outline' },
  ghost: { variant: 'ghost' },
  link: { variant: 'link' },
  destructive: { variant: 'destructive' },
  xsSize: { variant: 'primary', size: 'xs' },
  smSize: { variant: 'primary', size: 'sm' },
  mdSize: { variant: 'primary', size: 'md' },
  lgSize: { variant: 'primary', size: 'lg' },
  iconSize: { variant: 'primary', size: 'icon' },
  loading: { variant: 'primary', loading: true },
  disabled: { variant: 'primary', disabled: true },
};
",
  "Button.tsx": "import React from 'react';
import { Pressable, Text, View, ActivityIndicator, type PressableProps, type ViewProps, type TextProps } from 'react-native';

const variantClasses: Record<string, string> = {
  default: 'bg-primary text-primary-foreground border border-transparent',
  primary: 'bg-primary text-primary-foreground border border-transparent',
  secondary: 'bg-secondary text-secondary-foreground border border-transparent',
  outline: 'bg-transparent text-foreground border border-border',
  ghost: 'bg-transparent text-foreground border border-transparent',
  link: 'bg-transparent text-primary underline border border-transparent',
  destructive: 'bg-destructive text-destructive-foreground border border-transparent',
 };

const sizeClasses: Record<string, string> = {
  xs: 'px-2 py-1 text-xs',
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-5 py-2.5 text-base',
  lg: 'px-7 py-3.5 text-lg',
  icon: 'p-2.5 text-base',
};

export type ButtonVariant = 'default' | 'primary' | 'secondary' | 'outline' | 'ghost' | 'link' | 'destructive';
export type ButtonSize    = 'xs' | 'sm' | 'md' | 'lg' | 'icon';

export interface ButtonProps extends PressableProps {
  variant?:  ButtonVariant;
  size?:     ButtonSize;
  loading?:  boolean;
  children:  React.ReactNode;
  className?: string;
}

export const ButtonRoot = React.forwardRef<View, ButtonProps>(
  ({ variant = 'primary', size = 'md', loading = false, disabled, children, className, ...props }, ref) => {
    const cls = [
      'flex-row items-center justify-center rounded-md active:opacity-80',
      variantClasses[variant],
      sizeClasses[size],
      (disabled || loading) && 'opacity-45',
      className,
    ].filter(Boolean).join(' ');
    const a11yState = { disabled: !!(disabled || loading), busy: loading };

    return (
      <Pressable
        ref={ref}
        className={cls}
        disabled={disabled || loading}
        accessibilityRole="button"
        accessibilityState={a11yState}
        {...props}
      >
        {children}
      </Pressable>
    );
  }
);

// ponytail: text color/size are read from the parent Pressable's className via NativeWind's
// style inheritance (color, fontSize, … cascade to Text like CSS) — the same pattern used by
// established NativeWind component kits. Pass an explicit className to override.
export const ButtonLabel = ({ children, className, ...props }: TextProps & { className?: string }) => (
  <Text className={className} {...props}>{children}</Text>
);

export const ButtonSpinner = ({ className, ...props }: Omit<React.ComponentProps<typeof ActivityIndicator>, 'size'> & { className?: string }) => (
  <ActivityIndicator size="small" className={['mr-2', className].filter(Boolean).join(' ')} {...props} />
);

export const ButtonIcon = ({ children, className, ...props }: ViewProps & { className?: string }) => (
  <View className={className} {...props}>{children}</View>
);

export const Button = Object.assign(ButtonRoot, {
  Label: ButtonLabel,
  Spinner: ButtonSpinner,
  Icon: ButtonIcon,
});

Button.displayName = 'Button';
ButtonRoot.displayName = 'Button.Root';
ButtonLabel.displayName = 'Button.Label';
ButtonSpinner.displayName = 'Button.Spinner';
ButtonIcon.displayName = 'Button.Icon';
",
  "README.md": "# Button

Generated by Crucible v1.2.1 | Theme: minimal | Framework: react-native

