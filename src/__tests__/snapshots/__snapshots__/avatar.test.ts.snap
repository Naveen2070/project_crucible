  font-weight: var(--avatar-font-weight, 600);
  line-height: 1;
  user-select: none;
}

.avatar--circle {
  border-radius: 9999px;
}

.avatar--square {
  border-radius: var(--avatar-radius, var(--radius-md));
}

.avatar--xs {
  width: 24px;
  height: 24px;
  font-size: 0.625rem;
}

.avatar--sm {
  width: 32px;
  height: 32px;
  font-size: 0.75rem;
}

.avatar--md {
  width: 40px;
  height: 40px;
  font-size: 0.875rem;
}

.avatar--lg {
  width: 56px;
  height: 56px;
  font-size: 1.125rem;
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

