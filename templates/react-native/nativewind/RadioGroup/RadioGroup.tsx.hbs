import React, { createContext, useContext, useState } from 'react';
import { View, Text, Pressable, type PressableProps } from 'react-native';

export type RadioGroupSize = {{#each sizes}}'{{this}}'{{#unless @last}} | {{/unless}}{{/each}};
export type RadioGroupOrientation = 'vertical' | 'horizontal';

export interface RadioGroupOptions {
  /** Controlled selected value */
  value?: string;
  /** Initial selected value when uncontrolled */
  defaultValue?: string;
  /** Called with the next selected value */
  onValueChange?: (value: string) => void;
  /** Layout direction of the group */
  orientation?: RadioGroupOrientation;
  /** Form association name (metadata only on mobile — no native form submission) */
  name?: string;
}

export interface RadioGroupProps extends RadioGroupOptions {
  size?: RadioGroupSize;
}

const CIRCLE_CLASSES: Record<string, string> = {
  sm: 'w-4 h-4',
  md: 'w-[18px] h-[18px]',
  lg: 'w-[22px] h-[22px]',
};

const DOT_CLASSES: Record<string, string> = {
  sm: 'w-2 h-2',
  md: 'w-2.5 h-2.5',
  lg: 'w-3 h-3',
};

const LABEL_CLASSES: Record<string, string> = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
};

// ponytail: roving tabindex / arrow-key handling from the web version is intentionally
// omitted — focus navigation is touch/screen-reader driven on mobile.
{{#if features.compoundComponents}}
interface RadioGroupContextValue {
  value?: string;
  setValue: (next: string) => void;
  size: RadioGroupSize;
}

const RadioGroupContext = createContext<RadioGroupContextValue | undefined>(undefined);

const useRadioGroupContext = () => {
  const context = useContext(RadioGroupContext);
  if (!context) throw new Error('RadioGroup sub-components must be used within RadioGroup');
  return context;
};

export const RadioGroupRoot = ({
  children,
  value: controlled,
  defaultValue,
  onValueChange,
  orientation = 'vertical',
  size = 'md',
  className,
}: RadioGroupProps & {
  children: React.ReactNode;
  className?: string;
}) => {
  const [uncontrolled, setUncontrolled] = useState(defaultValue);
  const value = controlled ?? uncontrolled;

  const setValue = (next: string) => {
    if (controlled === undefined) setUncontrolled(next);
    onValueChange?.(next);
  };

  const contextValue = { value, setValue, size };
  return (
    <RadioGroupContext.Provider value={contextValue}>
      <View
        className={[orientation === 'horizontal' ? 'flex-row flex-wrap items-center' : 'flex-col', 'gap-2', className].filter(Boolean).join(' ')}
        accessibilityRole="radiogroup"
      >
        {children}
      </View>
    </RadioGroupContext.Provider>
  );
};

export const RadioGroupItem = ({
  value,
  label,
  description,
  disabled,
  className,
  ...props
}: {
  value: string;
  label?: string;
  description?: string;
  disabled?: boolean;
  className?: string;
} & PressableProps) => {
  const { value: selectedValue, size, setValue } = useRadioGroupContext();
  const selected = selectedValue === value;
  const a11yState = { checked: selected, disabled: !!disabled };

  return (
    <Pressable
      className={['flex-row items-center gap-2', disabled && 'opacity-50', className].filter(Boolean).join(' ')}
      disabled={disabled}
      onPress={() => setValue(value)}
      accessibilityRole="radio"
      accessibilityState={a11yState}
      {...props}
    >
      <View
        className={[
          'items-center justify-center rounded-full border-2',
          CIRCLE_CLASSES[size],
          selected ? 'border-primary' : 'border-border',
        ].filter(Boolean).join(' ')}
      >
        {selected && <View className={['rounded-full bg-primary', DOT_CLASSES[size]].filter(Boolean).join(' ')} />}
      </View>
      {(label || description) && (
        <View className="flex-col">
          {label && <Text className={['leading-snug text-foreground', LABEL_CLASSES[size]].filter(Boolean).join(' ')}>{label}</Text>}
          {description && <Text className="text-xs leading-snug text-text-muted">{description}</Text>}
        </View>
      )}
    </Pressable>
  );
};

export const RadioGroup = Object.assign(RadioGroupRoot, {
  Item: RadioGroupItem,
});

RadioGroup.displayName = 'RadioGroup';
RadioGroupRoot.displayName = 'RadioGroup.Root';
RadioGroupItem.displayName = 'RadioGroup.Item';
{{else}}
export interface RadioGroupItemData {
  value: string;
  label?: string;
  description?: string;
  disabled?: boolean;
}

export const RadioGroup = ({
  items,
  value: controlled,
  defaultValue,
  onValueChange,
  orientation = 'vertical',
  size = 'md',
}: RadioGroupProps & {
  items: RadioGroupItemData[];
}) => {
  const [uncontrolled, setUncontrolled] = useState(defaultValue);
  const value = controlled ?? uncontrolled;

  const setValue = (next: string) => {
    if (controlled === undefined) setUncontrolled(next);
    onValueChange?.(next);
  };

  return (
    <View
      className={[orientation === 'horizontal' ? 'flex-row flex-wrap items-center' : 'flex-col', 'gap-2'].filter(Boolean).join(' ')}
      accessibilityRole="radiogroup"
    >
      {items.map((item) => {
        const selected = value === item.value;
        const a11yState = { checked: selected, disabled: !!item.disabled };
        return (
          <Pressable
            key={item.value}
            className={['flex-row items-center gap-2', item.disabled && 'opacity-50'].filter(Boolean).join(' ')}
            disabled={item.disabled}
            onPress={() => setValue(item.value)}
            accessibilityRole="radio"
            accessibilityState={a11yState}
          >
            <View
              className={[
                'items-center justify-center rounded-full border-2',
                CIRCLE_CLASSES[size],
                selected ? 'border-primary' : 'border-border',
              ].filter(Boolean).join(' ')}
            >
              {selected && <View className={['rounded-full bg-primary', DOT_CLASSES[size]].filter(Boolean).join(' ')} />}
            </View>
            {(item.label || item.description) && (
              <View className="flex-col">
                {item.label && <Text className={['leading-snug text-foreground', LABEL_CLASSES[size]].filter(Boolean).join(' ')}>{item.label}</Text>}
                {item.description && <Text className="text-xs leading-snug text-text-muted">{item.description}</Text>}
              </View>
            )}
          </Pressable>
        );
      })}
    </View>
  );
};

RadioGroup.displayName = 'RadioGroup';
{{/if}}
