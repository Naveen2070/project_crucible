export const PromiseToast: Story = {
  render: (args) => {
    const runPromise = (shouldFail = false) => {
      const p = new Promise<{ name: string }>((resolve, reject) =>
        window.setTimeout(() => {
          if (shouldFail) reject(new Error('Network error'));
          else resolve({ name: 'document.pdf' });
        }, 2000),
      );
      toast.promise(p, {
        loading: 'Saving file…',
        success: (data) => `${data.name} saved successfully`,
        error: (err) => `Error: ${(err as Error).message}`,
      });
    };
    return (
      <>
        <Toaster {...args} />
        <div style={row}>
          <Button onClick={() => runPromise(false)}>Run promise (succeeds)</Button>
          <Button variant="destructive" onClick={() => runPromise(true)}>
            Run promise (fails)
          </Button>
        </div>
        <p style=\{{ margin: 0, fontSize: '0.875rem', color: 'var(--color-text-muted, #6B6B8A)' }}>
          Loading toast appears immediately, then replaces in place after 2s.
        </p>
      </>
    );
  },
};

export const AllPositions: Story = {
  render: (args) => {
    const [pos, setPos] = React.useState<ToastPosition>('bottom-right');
    const positions: ToastPosition[] = [
      'top-left',
      'top-center',
      'top-right',
      'bottom-left',
      'bottom-center',
      'bottom-right',
    ];
    return (
      <>
        <Toaster {...args} position={pos} />
        <p style=\{{ margin: '0 0 12px 0', fontSize: '0.875rem' }}>
          Active position: <code>{pos}</code>
        </p>
        <div style=\{{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '8px' }}>
          {positions.map((p) => (
            <Button
              key={p}
              variant={p === pos ? 'default' : 'outline'}
              onClick={() => {
                setPos(p);
                window.setTimeout(() => toast(`Toast at ${p}`), 50);
              }}
            >
              {p}
            </Button>
          ))}
        </div>
      </>
    );
  },
};

