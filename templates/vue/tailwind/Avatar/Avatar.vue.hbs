<script setup lang="ts">
import { ref, computed } from 'vue';

export type AvatarVariant = {{> shared/variant-types}};
export type AvatarSize    = {{> shared/size-types}};

interface Props {
  src?:      string;
  alt?:      string;
  fallback?: string;
  variant?:  AvatarVariant;
  size?:     AvatarSize;
}

const props = withDefaults(defineProps<Props>(), {
  src: '',
  alt: '',
  fallback: '',
  variant: 'circle',
  size: 'md',
});

const errored = ref(false);
const showImage = computed(() => Boolean(props.src) && !errored.value);
const initials = computed(() => (props.fallback || props.alt || '').trim().slice(0, 2).toUpperCase());

const shapeClasses: Record<AvatarVariant, string> = {
  circle: 'rounded-full',
  square: 'rounded-[var(--avatar-radius,var(--radius-md))]',
};

const sizeClasses: Record<AvatarSize, string> = {
  xs: 'w-6 h-6 text-[0.625rem]',
  sm: 'w-8 h-8 text-xs',
  md: 'w-10 h-10 text-sm',
  lg: 'w-14 h-14 text-lg',
};

const avatarClasses = computed(() => [
  'inline-flex items-center justify-center shrink-0 overflow-hidden select-none font-semibold leading-none',
  'bg-[var(--avatar-fallback-bg,var(--color-secondary))] text-[var(--avatar-fallback-color,var(--color-text))]',
  shapeClasses[props.variant],
  sizeClasses[props.size],
]);
</script>

<template>
  <div :class="avatarClasses" role="img" :aria-label="alt || fallback || undefined">
    <img
      v-if="showImage"
      class="w-full h-full object-cover"
      :src="src"
      :alt="alt"
      @error="errored = true"
    />
    <span v-else aria-hidden="true">\{{ initials }}</span>
  </div>
</template>
