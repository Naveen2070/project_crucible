<script lang="ts">
import {
  defineComponent,
  h,
  inject,
  provide,
  reactive,
{{#if vueUseId}}  useId,{{else}}  getCurrentInstance,{{/if}}
  onMounted,
  onBeforeUnmount,
  ref,
  type InjectionKey,
  type PropType,
} from 'vue';
import { RovingFocusManager } from './utils/roving-focus';

export type RadioGroupSize = {{> shared/size-types}};
export type RadioGroupOrientation = 'vertical' | 'horizontal';

export interface RadioGroupItem {
  value: string;
  label: string;
  disabled?: boolean;
}

export interface RadioGroupApi {
  readonly value: string | undefined;
  setValue: (next: string) => void;
  orientation: RadioGroupOrientation;
  name: string | undefined;
  size: RadioGroupSize;
  rootId: string;
  registerItem: (val: string, disabled: boolean, el: HTMLButtonElement | null) => void;
  firstEnabled: () => string | null;
}

export const RadioGroupContextKey: InjectionKey<RadioGroupApi> = Symbol('crucible-radio-group');

function useRadioGroupApi(): RadioGroupApi {
  const ctx = inject(RadioGroupContextKey, null);
  if (!ctx) throw new Error('RadioGroup items must be used inside <RadioGroup />');
  return ctx;
}

export const buildItemId = (rootId: string, value: string) =>
  `${rootId}-radio-${value.replace(/[^a-zA-Z0-9_-]/g, '_')}`;

const CONTROL_BASE =
  'shrink-0 inline-flex items-center justify-center rounded-full border-2 border-[var(--color-border)] bg-[var(--color-surface)] cursor-pointer transition-[border-color,box-shadow] duration-150 data-[state=checked]:border-[var(--radio-accent,var(--color-primary))] data-[disabled]:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]';

const INDICATOR_BASE =
  'w-1/2 h-1/2 rounded-full bg-[var(--radio-accent,var(--color-primary))] scale-0 transition-transform duration-150 [button[data-state=checked]_&]:scale-100';

const LABEL_BASE = 'text-[var(--radio-label-color,var(--color-text))] leading-snug';

const SIZE_CONTROL: Record<RadioGroupSize, string> = {
  sm: 'w-[calc(var(--radio-size,16px)*0.8)] h-[calc(var(--radio-size,16px)*0.8)]',
  md: 'w-[var(--radio-size,16px)] h-[var(--radio-size,16px)]',
  lg: 'w-[calc(var(--radio-size,16px)*1.25)] h-[calc(var(--radio-size,16px)*1.25)]',
};

const SIZE_LABEL: Record<RadioGroupSize, string> = {
  sm: 'text-[0.8125rem]',
  md: 'text-sm',
  lg: 'text-[0.9375rem]',
};

export const RadioGroupItemComp = defineComponent({
  name: 'RadioGroupItem',
  props: {
    value: { type: String, required: true },
    label: { type: String, default: '' },
    disabled: { type: Boolean, default: false },
  },
  setup(props, { slots }) {
    const group = useRadioGroupApi();
    const elRef = ref<HTMLButtonElement | null>(null);

    onMounted(() => group.registerItem(props.value, props.disabled, elRef.value));
    onBeforeUnmount(() => group.registerItem(props.value, props.disabled, null));

    return () => {
      const isSelected = group.value === props.value;
      const noneSelected = group.value === undefined;
      const isTabStop = isSelected || (noneSelected && group.firstEnabled() === props.value);
      return h(
        'label',
        {
          class: 'inline-flex items-center gap-[var(--radio-gap,8px)] cursor-pointer data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed',
          'data-disabled': props.disabled ? '' : undefined,
        },
        [
          h(
            'button',
            {
              ref: (el: any) => (elRef.value = el as HTMLButtonElement | null),
              type: 'button',
              role: 'radio',
              id: buildItemId(group.rootId, props.value),
              name: group.name,
              'aria-checked': isSelected,
              'data-state': isSelected ? 'checked' : 'unchecked',
              'data-value': props.value,
              'data-disabled': props.disabled ? '' : undefined,
              disabled: props.disabled,
              tabindex: isTabStop ? 0 : -1,
              class: [CONTROL_BASE, SIZE_CONTROL[group.size]].join(' '),
              onClick: () => {
                if (props.disabled) return;
                group.setValue(props.value);
              },
            },
            [h('span', { class: INDICATOR_BASE, 'aria-hidden': 'true' })],
          ),
          h(
            'span',
            { class: [LABEL_BASE, SIZE_LABEL[group.size]].join(' ') },
            slots.default ? slots.default() : props.label,
          ),
        ],
      );
    };
  },
});
</script>

<script setup lang="ts">
const props = withDefaults(
  defineProps<{
    size?: RadioGroupSize;
    value?: string;
    defaultValue?: string;
    orientation?: RadioGroupOrientation;
    name?: string;
    /** Schema-driven (monolithic) */
    items?: RadioGroupItem[];
  }>(),
  { size: 'md', orientation: 'vertical', items: () => [] },
);

const emit = defineEmits<{
  (e: 'update:value', value: string): void;
  (e: 'valueChange', value: string): void;
}>();

{{#if vueUseId}}
const uid = useId();
{{else}}
const uid = (getCurrentInstance()?.uid ?? 0).toString(36);
{{/if}}
const rootId = `radio-${uid}`;

const roving = new RovingFocusManager();

const internal = reactive({ value: props.value ?? props.defaultValue });

const setValue = (next: string) => {
  if (props.value === undefined) internal.value = next;
  emit('update:value', next);
  emit('valueChange', next);
};

const registerItem = (val: string, disabled: boolean, el: HTMLButtonElement | null) =>
  roving.register(val, disabled, el);

const focusItem = (val: string) => roving.focus(val);

const enabledOrder = () => roving.enabled();

const firstEnabled = () => enabledOrder()[0] ?? null;

const moveFocus = (current: string, direction: 1 | -1) => roving.moveFocus(current, direction);

const focusEdge = (edge: 'first' | 'last') => roving.focusEdge(edge);

const onKeydown = (e: KeyboardEvent) => {
  const target = e.target as HTMLElement;
  const currentValue = target.getAttribute('data-value') ?? props.value ?? internal.value ?? '';
  const isHorizontal = props.orientation === 'horizontal';
  const nextKey = isHorizontal ? 'ArrowRight' : 'ArrowDown';
  const prevKey = isHorizontal ? 'ArrowLeft' : 'ArrowUp';

  let nextValue: string | null = null;
  if (e.key === nextKey) {
    e.preventDefault();
    nextValue = moveFocus(currentValue, 1);
  } else if (e.key === prevKey) {
    e.preventDefault();
    nextValue = moveFocus(currentValue, -1);
  } else if (e.key === 'Home') {
    e.preventDefault();
    nextValue = focusEdge('first');
  } else if (e.key === 'End') {
    e.preventDefault();
    nextValue = focusEdge('last');
  }
  if (nextValue) setValue(nextValue);
};

const api: RadioGroupApi = {
  get value() {
    return props.value ?? internal.value;
  },
  setValue,
  get orientation() {
    return props.orientation;
  },
  get name() {
    return props.name;
  },
  get size() {
    return props.size;
  },
  rootId,
  registerItem,
  firstEnabled,
};

provide(RadioGroupContextKey, api);

const rootClass =
  'flex flex-col gap-[var(--radio-group-gap,8px)] data-[orientation=horizontal]:flex-row data-[orientation=horizontal]:flex-wrap data-[orientation=horizontal]:items-center';
</script>

<template>
  <div
    :class="rootClass"
    role="radiogroup"
    :aria-orientation="orientation"
    :data-orientation="orientation"
    @keydown="onKeydown"
  >
    {{#if features.compoundComponents}}
    <slot :api="api" />
    {{else}}
    <RadioGroupItemComp
      v-for="item in items"
      :key="item.value"
      :value="item.value"
      :label="item.label"
      :disabled="item.disabled"
    />
    {{/if}}
  </div>
</template>
