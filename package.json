{
  "name": "@cruciblelab/crucible",
  "version": "1.1.0",
  "description": "Crucible — Code Generation Engine that generates style system/spec-based components for React, Vue, and Angular. No runtime dependencies. You own every file generated.",
  "docs": "https://crucible-docs.naveenr.in",
  "main": "dist/cli/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "audit:templates": "tsx scripts/audit-templates.ts",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run audit:templates",
    "build": "npm run clean:dist && tsc && tsx scripts/copy-manifests.ts",
    "build:watch": "tsc --watch",
    "dev": "concurrently \"npm run build:watch\" \"npm run playground\"",
    "playground": "npm --prefix playground/react run dev",
    "storybook": "npm --prefix playground/react run storybook",
    "generate:dev": "node dist/cli/index.js add Button --dev",
    "test": "vitest",
    "test:bun": "bunx vitest run --config vitest.config.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:coverage": "vitest --coverage",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "pg": "tsx scripts/generate-playground.ts",
    "pg:all": "tsx scripts/generate-playground.ts",
    "pg:react": "tsx scripts/generate-playground.ts react",
    "pg:angular": "tsx scripts/generate-playground.ts angular",
    "pg:vue": "tsx scripts/generate-playground.ts vue",
    "po": "tsx scripts/open-playground.ts",
    "po:react": "tsx scripts/open-playground.ts react",
    "po:angular": "tsx scripts/open-playground.ts angular",
    "po:vue": "tsx scripts/open-playground.ts vue",
    "pd": "tsx scripts/open-playground.ts dev",
    "pd:react": "tsx scripts/open-playground.ts dev react",
    "pd:angular": "tsx scripts/open-playground.ts dev angular",
    "pd:vue": "tsx scripts/open-playground.ts dev vue"
  },
  "bin": {
    "crucible": "./bin/crucible.js"
  },
  "keywords": [
    "code-generation",
    "component-generator",
    "design-system",
    "style-system",
    "react-components",
    "vue-components",
    "angular-components",
    "tailwind",
    "css-modules",
    "scss",
    "cli",
    "scaffolding",
    "component-library",
    "style-system-engine",
    "component-spec",
    "aria",
    "accessibility",
    "dark-mode",
    "oklch"
  ],
  "author": "Naveen R",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Naveen2070/project_crucible"
  },
  "bugs": {
    "url": "https://github.com/Naveen2070/project_crucible"
  },
  "homepage": "https://github.com/Naveen2070/project_crucible#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "ajv": "^8.20.0",
    "ansis": "^4.3.1",
    "chokidar": "^5.0.0",
    "colorjs.io": "^0.6.1",
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "prettier": "^3.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "glob": "^13.0.6",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.3": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "lmdb@3.5.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "msgpackr-extract@3.0.4": true
  }
}