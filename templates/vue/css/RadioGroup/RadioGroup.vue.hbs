  background-color: var(--radio-accent, {{tokens.componentTokens.radio.accent}});
  transform: scale(0);
  transition: transform 0.15s ease;
}
.radio-group-root .control[data-state='checked'] .indicator {
  transform: scale(1);
}
.radio-group-root .label {
  color: var(--radio-label-color, {{tokens.componentTokens.radio.labelColor}});
  line-height: 1.4;
  font-size: 0.875rem;
}
{{#if a11y.focusRing}}
.radio-group-root .control:focus-visible {
  outline: {{a11y.focusRingWidth}} solid {{a11y.focusRingColor}};
  outline-offset: {{a11y.focusRingOffset}};
}
{{/if}}
.radio-group-root.size-sm .control { width: calc(var(--radio-size, {{tokens.componentTokens.radio.size}}) * 0.8); height: calc(var(--radio-size, {{tokens.componentTokens.radio.size}}) * 0.8); }
.radio-group-root.size-sm .label { font-size: 0.8125rem; }
.radio-group-root.size-md .control { width: var(--radio-size, {{tokens.componentTokens.radio.size}}); height: var(--radio-size, {{tokens.componentTokens.radio.size}}); }
.radio-group-root.size-md .label { font-size: 0.875rem; }
.radio-group-root.size-lg .control { width: calc(var(--radio-size, {{tokens.componentTokens.radio.size}}) * 1.25); height: calc(var(--radio-size, {{tokens.componentTokens.radio.size}}) * 1.25); }
.radio-group-root.size-lg .label { font-size: 0.9375rem; }
{{#if a11y.reduceMotion}}
@media (prefers-reduced-motion: reduce) {
  .radio-group-root .control,
  .radio-group-root .indicator { transition: none; }
}
