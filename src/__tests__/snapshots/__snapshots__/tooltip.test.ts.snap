});

/**
 * Tooltip - Monolithic wrapper for the compound components
 */
export const Tooltip: React.FC<TooltipOptions & { children: React.ReactNode }> = ({
  children,
  ...options
}) => {
  const childrenArray = React.Children.toArray(children);
  const trigger = childrenArray[0];
  const content = childrenArray.slice(1);

  return (
    <InternalRoot {...options}>
      <InternalTrigger asChild>{trigger}</InternalTrigger>
      <InternalPortal>
        <InternalContent>
          {content}
        </InternalContent>
      </InternalPortal>
    </InternalRoot>
  );
};

export default Tooltip;
",
}
`;
