  },
  render: (args) => ({
    components: { Popover, Button },
    setup() {
      return { args };
    },
    template: `
      <Popover v-bind="args">
        {{#if features.compoundComponents}}
        <template #trigger>
          <span style="text-decoration: underline; cursor: help;">Hover me for info</span>
        </template>
        <template #content>
