      <div style={{ maxWidth: '480px', display: 'flex', flexDirection: 'column', gap: '12px' }}>
        <div style={{ display: 'flex', gap: '8px' }}>
          <button type="button" onClick={() => setValue('one')}>Open One</button>
          <button type="button" onClick={() => setValue('two')}>Open Two</button>
          <button type="button" onClick={() => setValue('')}>Close all</button>
        </div>
        <Accordion type="single" value={value} onValueChange={setValue}>
          <Accordion.Item value="one">
            <Accordion.Trigger>One</Accordion.Trigger>
            <Accordion.Content>Current value: <strong>{String(value)}</strong></Accordion.Content>
          </Accordion.Item>
          <Accordion.Item value="two">
            <Accordion.Trigger>Two</Accordion.Trigger>
            <Accordion.Content>Current value: <strong>{String(value)}</strong></Accordion.Content>
          </Accordion.Item>
        </Accordion>
      </div>
    );
  },
};
