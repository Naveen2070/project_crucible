import React, {
  createContext,
  useContext,
  useState,
  useMemo,
  useCallback,
  useEffect,
  useRef,
  useId,
} from 'react';
{{> react/styles-import}}

export type TabsSize = 'sm' | 'md' | 'lg';
export type TabsVariant = 'default' | 'underline' | 'pills';
export type TabsOrientation = 'horizontal' | 'vertical';
export type TabsActivationMode = 'manual' | 'automatic';

export interface TabsOptions {
  value?: string;
  defaultValue?: string;
  onValueChange?: (value: string) => void;
  orientation?: TabsOrientation;
  activationMode?: TabsActivationMode;
}

interface TriggerRegistration {
  value: string;
  disabled: boolean;
  el: HTMLButtonElement | null;
}

export function useTabs({
  value: controlledValue,
  defaultValue,
  onValueChange,
  orientation = 'horizontal',
  activationMode = 'manual',
}: TabsOptions = {}) {
  const [uncontrolledValue, setUncontrolledValue] = useState<string | undefined>(defaultValue);
  const value = controlledValue ?? uncontrolledValue;
  const rootId = useId();
  const triggersRef = useRef<Map<string, TriggerRegistration>>(new Map());
  const orderRef = useRef<string[]>([]);

  const setValue = useCallback(
    (next: string) => {
      if (controlledValue === undefined) {
        setUncontrolledValue(next);
      }
      onValueChange?.(next);
    },
    [controlledValue, onValueChange]
  );

  const registerTrigger = useCallback(
    (val: string, disabled: boolean, el: HTMLButtonElement | null) => {
      const map = triggersRef.current;
      if (el === null) {
        map.delete(val);
        orderRef.current = orderRef.current.filter((v) => v !== val);
        return;
      }
      if (!map.has(val)) {
        orderRef.current.push(val);
      }
      map.set(val, { value: val, disabled, el });
    },
    []
  );

  const focusTrigger = useCallback((val: string) => {
    const entry = triggersRef.current.get(val);
    entry?.el?.focus();
  }, []);

  const moveFocus = useCallback(
    (current: string, direction: 1 | -1) => {
      const order = orderRef.current;
      const enabled = order.filter((v) => !triggersRef.current.get(v)?.disabled);
      if (enabled.length === 0) return null;
      const idx = enabled.indexOf(current);
      const nextIdx = idx === -1 ? 0 : (idx + direction + enabled.length) % enabled.length;
      const next = enabled[nextIdx];
      focusTrigger(next);
      return next;
    },
    [focusTrigger]
  );

  const focusEdge = useCallback(
    (edge: 'first' | 'last') => {
      const enabled = orderRef.current.filter((v) => !triggersRef.current.get(v)?.disabled);
      if (enabled.length === 0) return null;
      const next = edge === 'first' ? enabled[0] : enabled[enabled.length - 1];
      focusTrigger(next);
      return next;
    },
    [focusTrigger]
  );

  return useMemo(
    () => ({
      value,
      setValue,
      orientation,
      activationMode,
      rootId,
      registerTrigger,
      focusTrigger,
      moveFocus,
      focusEdge,
    }),
    [value, setValue, orientation, activationMode, rootId, registerTrigger, focusTrigger, moveFocus, focusEdge]
  );
}

type TabsContextType = ReturnType<typeof useTabs> | null;
const TabsContext = createContext<TabsContextType>(null);

const useTabsContext = () => {
  const context = useContext(TabsContext);
  if (context == null) {
    throw new Error('Tabs components must be wrapped in <Tabs.Root />');
  }
  return context;
};

const buildTriggerId = (rootId: string, value: string) =>
  `${rootId}-trigger-${value.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
const buildContentId = (rootId: string, value: string) =>
  `${rootId}-content-${value.replace(/[^a-zA-Z0-9_-]/g, '_')}`;

const joinClasses = (...parts: Array<string | false | null | undefined>) =>
  parts.filter(Boolean).join(' ');

/**
 * Internal Tabs Components
 */
export interface TabsRootProps extends TabsOptions {
  children: React.ReactNode;
  variant?: TabsVariant;
  size?: TabsSize;
  className?: string;
}

const InternalRoot = React.forwardRef<HTMLDivElement, TabsRootProps>(
  function TabsRoot(
    { children, variant = 'default', size = 'md', className, ...options },
    ref
  ) {
    const tabs = useTabs(options);
    return (
      <TabsContext.Provider value={tabs}>
        <div
          ref={ref}
          className={joinClasses(
            styles.root,
            styles[`variant-${variant}`],
            styles[`size-${size}`],
            className
          )}
          data-orientation={tabs.orientation}
        >
          {children}
        </div>
      </TabsContext.Provider>
    );
  }
);

export interface TabsListProps extends React.HTMLAttributes<HTMLDivElement> {
  loop?: boolean;
}

const InternalList = React.forwardRef<HTMLDivElement, TabsListProps>(
  function TabsList({ children, className, onKeyDown, ...props }, ref) {
    const ctx = useTabsContext();

    const handleKeyDown = (e: React.KeyboardEvent<HTMLDivElement>) => {
      onKeyDown?.(e);
      if (e.defaultPrevented) return;

      const target = e.target as HTMLElement;
      const currentValue = target.getAttribute('data-value') ?? ctx.value ?? '';

      const isHorizontal = ctx.orientation === 'horizontal';
      const nextKey = isHorizontal ? 'ArrowRight' : 'ArrowDown';
      const prevKey = isHorizontal ? 'ArrowLeft' : 'ArrowUp';

      let nextValue: string | null = null;

      if (e.key === nextKey) {
        e.preventDefault();
        nextValue = ctx.moveFocus(currentValue, 1);
      } else if (e.key === prevKey) {
        e.preventDefault();
        nextValue = ctx.moveFocus(currentValue, -1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        nextValue = ctx.focusEdge('first');
      } else if (e.key === 'End') {
        e.preventDefault();
        nextValue = ctx.focusEdge('last');
      }

      if (nextValue && ctx.activationMode === 'automatic') {
        ctx.setValue(nextValue);
      }
    };

    return (
      <div
        ref={ref}
        role="tablist"
        aria-orientation={ctx.orientation}
        className={joinClasses(styles.list, className)}
        onKeyDown={handleKeyDown}
        {...props}
      >
        {children}
      </div>
    );
  }
);

export interface TabsTriggerProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  value: string;
}

const InternalTrigger = React.forwardRef<HTMLButtonElement, TabsTriggerProps>(
  function TabsTrigger(
    { value, disabled = false, className, onClick, children, ...props },
    propRef
  ) {
    const ctx = useTabsContext();
    const isActive = ctx.value === value;
    const innerRef = useRef<HTMLButtonElement | null>(null);

    const setRef = useCallback(
      (el: HTMLButtonElement | null) => {
        innerRef.current = el;
        if (typeof propRef === 'function') propRef(el);
        else if (propRef) (propRef as React.MutableRefObject<HTMLButtonElement | null>).current = el;
        ctx.registerTrigger(value, disabled, el);
      },
      [ctx, value, disabled, propRef]
    );

    useEffect(() => () => ctx.registerTrigger(value, disabled, null), [ctx, value, disabled]);

    const handleClick = (e: React.MouseEvent<HTMLButtonElement>) => {
      onClick?.(e);
      if (e.defaultPrevented || disabled) return;
      ctx.setValue(value);
    };

    return (
      <button
        ref={setRef}
        type="button"
        role="tab"
        id={buildTriggerId(ctx.rootId, value)}
        aria-selected={isActive}
        aria-controls={buildContentId(ctx.rootId, value)}
        data-state={isActive ? 'active' : 'inactive'}
        data-value={value}
        data-disabled={disabled || undefined}
        disabled={disabled}
        tabIndex={isActive ? 0 : -1}
        className={joinClasses(styles.trigger, className)}
        onClick={handleClick}
        {...props}
      >
        {children}
      </button>
    );
  }
);

export interface TabsContentProps extends React.HTMLAttributes<HTMLDivElement> {
  value: string;
  forceMount?: boolean;
}

const InternalContent = React.forwardRef<HTMLDivElement, TabsContentProps>(
  function TabsContent({ value, forceMount = false, className, children, ...props }, ref) {
    const ctx = useTabsContext();
    const isActive = ctx.value === value;

    if (!isActive && !forceMount) {
      return null;
    }

    return (
      <div
        ref={ref}
        role="tabpanel"
        id={buildContentId(ctx.rootId, value)}
        aria-labelledby={buildTriggerId(ctx.rootId, value)}
        data-state={isActive ? 'active' : 'inactive'}
        hidden={!isActive}
        tabIndex={0}
        className={joinClasses(styles.content, className)}
        {...props}
      >
        {children}
      </div>
    );
  }
);

InternalRoot.displayName = 'Tabs.Root';
InternalList.displayName = 'Tabs.List';
InternalTrigger.displayName = 'Tabs.Trigger';
InternalContent.displayName = 'Tabs.Content';

{{#if features.compoundComponents}}
export const TabsRoot = InternalRoot;
export const TabsList = InternalList;
export const TabsTrigger = InternalTrigger;
export const TabsContent = InternalContent;

/**
 * Tabs - Main export with compound components
 *
 * @example
 * <Tabs defaultValue="overview">
 *   <Tabs.List>
 *     <Tabs.Trigger value="overview">Overview</Tabs.Trigger>
 *     <Tabs.Trigger value="settings">Settings</Tabs.Trigger>
 *   </Tabs.List>
 *   <Tabs.Content value="overview">...</Tabs.Content>
 *   <Tabs.Content value="settings">...</Tabs.Content>
 * </Tabs>
 */
export const Tabs = Object.assign(TabsRoot, {
  Root: TabsRoot,
  List: TabsList,
  Trigger: TabsTrigger,
  Content: TabsContent,
});
{{else}}
export interface TabsItem {
  value: string;
  label: React.ReactNode;
  content: React.ReactNode;
  disabled?: boolean;
}

export interface TabsProps extends TabsOptions {
  items: TabsItem[];
  variant?: TabsVariant;
  size?: TabsSize;
  className?: string;
}

/**
 * Tabs - Monolithic schema-driven wrapper
 *
 * @example
 * <Tabs
 *   defaultValue="overview"
 *   items={[
 *     { value: 'overview', label: 'Overview', content: <p>...</p> },
 *     { value: 'settings', label: 'Settings', content: <p>...</p> },
 *   ]}
 * />
 */
export const Tabs: React.FC<TabsProps> = ({
  items,
  variant,
  size,
  className,
  ...options
}) => {
  return (
    <InternalRoot variant={variant} size={size} className={className} {...options}>
      <InternalList>
        {items.map((item) => (
          <InternalTrigger key={item.value} value={item.value} disabled={item.disabled}>
            {item.label}
          </InternalTrigger>
        ))}
      </InternalList>
      {items.map((item) => (
        <InternalContent key={item.value} value={item.value}>
          {item.content}
        </InternalContent>
      ))}
    </InternalRoot>
  );
};
{{/if}}
