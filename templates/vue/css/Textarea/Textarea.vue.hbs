<script setup lang="ts">
import { computed{{#if vueUseId}}, useId{{else}}, getCurrentInstance{{/if}} } from 'vue';

export type TextareaVariant = {{> shared/variant-types}};
export type TextareaSize    = {{> shared/size-types}};

interface Props {
  id?:          string;
  modelValue?:  string;
  label?:       string;
  placeholder?: string;
  variant?:     TextareaVariant;
  size?:        TextareaSize;
  error?:       string;
  hint?:        string;
  disabled?:    boolean;
  required?:    boolean;
  rows?:        number;
}

const props = withDefaults(defineProps<Props>(), {
  id: '',
  modelValue: '',
  label: '',
  placeholder: '',
  variant: 'default',
  size: 'md',
  error: '',
  hint: '',
  disabled: false,
  required: false,
  rows: 4,
});

const emit = defineEmits(['update:modelValue']);

const generatedId = {{#if vueUseId}}`textarea-${useId()}`{{else}}`textarea-${getCurrentInstance()?.uid ?? 0}`{{/if}};
const textareaId = computed(() => props.id || generatedId);
const errorId = computed(() => `${textareaId.value}-error`);
const hintId = computed(() => `${textareaId.value}-hint`);

const describedBy = computed(() => {
  const ids = [];
  if (props.error) ids.push(errorId.value);
  if (props.hint) ids.push(hintId.value);
  return ids.join(' ') || undefined;
});

const onInput = (event: Event) => {
  emit('update:modelValue', (event.target as HTMLTextAreaElement).value);
};

const textareaClasses = computed(() => [
  'textarea',
  `textarea--${props.size}`,
  {
    'textarea--error': props.variant === 'error' || !!props.error,
    'textarea--disabled': props.disabled,
  },
]);
</script>

<template>
  <div class="textarea-container">
    <label v-if="label" :for="textareaId" class="label">
      \{{ label }}
      <span v-if="required" class="required" aria-hidden="true">*</span>
    </label>

    <textarea
      :id="textareaId"
      :class="textareaClasses"
      :rows="rows"
      :placeholder="placeholder"
      :disabled="disabled"
      :value="modelValue"
      @input="onInput"
      :aria-invalid="!!error"
      :aria-required="required"
      :aria-describedby="describedBy"
    />

    <span v-if="hint && !error" :id="hintId" class="hint">\{{ hint }}</span>
    <span v-if="error" :id="errorId" class="error" role="alert">\{{ error }}</span>
  </div>
</template>

