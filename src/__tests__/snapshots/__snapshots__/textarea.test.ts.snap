exports[`Textarea snapshots > angular css mode snapshot (monolithic) 1`] = `
"import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-textarea',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './textarea.component.html',
  styleUrls: ['./textarea.component.css'],
})
export class TextareaComponent {
  @Input() label = '';
  @Input() placeholder = '';
  @Input() value = '';
  @Input() error = '';
  @Input() hint = '';
  @Input() disabled = false;
  @Input() required = false;
  @Input() rows = 4;
  @Input() variant: 'default' | 'error' = 'default';
  @Input() size: 'sm' | 'md' | 'lg' = 'md';

  id = 'textarea-' + Math.random().toString(36).substring(2, 9);

  get isError(): boolean {
    return this.variant === 'error' || !!this.error;
  }
}
"
`;

exports[`Textarea snapshots > angular css mode snapshot (monolithic) 2`] = `
"<div class="textarea-container">
  @if (label) {
    <label [attr.for]="id" class="label">
      {{ label }}
      @if (required) {
        <span class="required" aria-hidden="true">*</span>
      }
    </label>
  }

  <textarea
    [id]="id"
    class="textarea"
    [class.textarea--sm]="size === 'sm'"
    [class.textarea--md]="size === 'md'"
    [class.textarea--lg]="size === 'lg'"
    [class.textarea--error]="isError"
    [class.textarea--disabled]="disabled"
    [rows]="rows"
    [placeholder]="placeholder"
    [disabled]="disabled"
    [value]="value"
    [attr.aria-invalid]="!!error"
    [attr.aria-required]="required"
  ></textarea>

  @if (hint && !error) {
    <span class="hint">{{ hint }}</span>
  }
  @if (error) {
    <span class="error" role="alert">{{ error }}</span>
  }
</div>
"
`;

exports[`Textarea snapshots > react css mode snapshot 1`] = `
"import React, { useId } from 'react';
import styles from './Textarea.module.css';
export type TextareaVariant = 'default' | 'error';
export type TextareaSize    = 'sm' | 'md' | 'lg';

export interface TextareaProps extends Omit<React.TextareaHTMLAttributes<HTMLTextAreaElement>, 'size'> {
  label?:    string;
  variant?:  TextareaVariant;
  size?:     TextareaSize;
  error?:    string;
  hint?:     string;
  required?: boolean;
}

export const Textarea = React.forwardRef<HTMLTextAreaElement, TextareaProps>(
  (
    { label, variant = 'default', size = 'md', error, hint, required, id: providedId, className, rows = 4, ...props },
    ref
  ) => {
    const generatedId = useId();
    const id = providedId || generatedId;
    const errorId = \`\${id}-error\`;
    const hintId = \`\${id}-hint\`;

    const cls = [
      styles.textarea,
      styles[\`textarea--\${variant}\`],
      styles[\`textarea--\${size}\`],
      (error || variant === 'error') && styles['textarea--error'],
      props.disabled && styles['textarea--disabled'],
      className,
    ].filter(Boolean).join(' ');

    const describedBy = [
      error ? errorId : null,
      hint ? hintId : null,
    ].filter(Boolean).join(' ') || undefined;

    return (
      <div className={styles['textarea-container']}>
        {label && (
          <label htmlFor={id} className={styles.label}>
            {label}
            {required && <span className={styles.required} aria-hidden="true">*</span>}
          </label>
        )}
        <textarea
          ref={ref}
          id={id}
          rows={rows}
          className={cls}
          aria-invalid={!!error}
          aria-describedby={describedBy}
          aria-required={required}
          {...props}
        />
        {hint && !error && (
          <span id={hintId} className={styles.hint}>
            {hint}
          </span>
        )}
        {error && (
          <span id={errorId} className={styles.error} role="alert">
            {error}
          </span>
        )}
      </div>
    );
  }
);

Textarea.displayName = 'Textarea';
"
`;

exports[`Textarea snapshots > react css mode snapshot 2`] = `
".textarea-container {
  display: flex;
  flex-direction: column;
  gap: calc(var(--spacing-unit, 4px) * 1.5);
}

.label {
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  font-weight: 500;
  font-size: 0.875rem;
  color: var(--color-text, #1A1A2E);
}

.required {
  color: var(--color-destructive, #E24B4A);
  margin-left: 2px;
}

.textarea {
  width: 100%;
  min-height: var(--textarea-min-height, calc(var(--spacing-unit) * 20));
  padding: var(--textarea-padding-y, calc(var(--spacing-unit) * 2))
    var(--textarea-padding-x, calc(var(--spacing-unit) * 3));
  border: 1px solid var(--textarea-border-color, var(--color-border));
  border-radius: var(--textarea-radius, var(--radius-md));
  font-family: inherit;
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--color-text, #1A1A2E);
  background-color: var(--color-surface, #FFFFFF);
  resize: vertical;
  outline: none;
  transition: var(--textarea-transition, border-color 0.2s ease, box-shadow 0.2s ease);
}

.textarea:focus-visible {
  border-color: var(--color-primary, #6C63FF);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary, #6C63FF) 20%, transparent);
}

.textarea::placeholder {
  color: var(--color-text-muted, #6B6B8A);
}

/* Sizes */
.textarea--sm {
  font-size: 0.8125rem;
  min-height: calc(var(--spacing-unit, 4px) * 16);
}

.textarea--md {
  font-size: 0.875rem;
}

.textarea--lg {
  font-size: 1rem;
  min-height: calc(var(--spacing-unit, 4px) * 28);
}

/* States */
.textarea--error {
  border-color: var(--color-destructive, #E24B4A);
}

.textarea--error:focus-visible {
  border-color: var(--color-destructive, #E24B4A);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-destructive, #E24B4A) 20%, transparent);
}

.textarea--disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background-color: var(--color-background, #F8F9FA);
}

.hint {
  font-size: 0.75rem;
  color: var(--color-text-muted, #6B6B8A);
}

.error {
  font-size: 0.75rem;
  color: var(--color-destructive, #E24B4A);
}
"
`;

