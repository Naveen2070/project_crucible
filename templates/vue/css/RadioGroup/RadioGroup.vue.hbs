  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--radio-size, {{tokens.componentTokens.radio.size}});
  height: var(--radio-size, {{tokens.componentTokens.radio.size}});
  border: 2px solid var(--color-border, #e5e7eb);
  border-radius: 50%;
  background-color: var(--color-surface, #ffffff);
  cursor: pointer;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.radio-group-root .control[data-state='checked'] {
  border-color: var(--radio-accent, {{tokens.componentTokens.radio.accent}});
}
