export const PromiseToast: Story = {
  render: (args) => {
    const runPromise = (shouldFail = false) => {
      const p = new Promise<{ name: string }>((resolve, reject) =>
        window.setTimeout(() => {
          if (shouldFail) reject(new Error('Network error'));
          else resolve({ name: 'document.pdf' });
        }, 2000),
      );
      toast.promise(p, {
        loading: 'Saving file…',
        success: (data) => `${data.name} saved successfully`,
        error: (err) => `Error: ${(err as Error).message}`,
      });
    };
    return {
      props: { ...args, runOk: () => runPromise(false), runFail: () => runPromise(true) },
      template: `
        <app-toaster
          [position]="position"
          [duration]="duration"
          [maxToasts]="maxToasts"
          [richColors]="richColors"
          [closeButton]="closeButton"
        ></app-toaster>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          <app-button (click)="runOk()">Run promise (succeeds)</app-button>
          <app-button variant="destructive" (click)="runFail()">Run promise (fails)</app-button>
        </div>
        <p style="margin: 8px 0 0 0; font-size: 0.875rem; color: var(--color-text-muted, #6B6B8A);">
          Loading toast appears immediately, then replaces in place after 2s.
        </p>
      `,
    };
  },
};

export const AllPositions: Story = {
  render: (args) => {
    const positions: ToastPosition[] = [
      'top-left',
      'top-center',
      'top-right',
      'bottom-left',
      'bottom-center',
      'bottom-right',
    ];
    return {
      props: {
        ...args,
        positions,
        activePos: args.position,
        switchTo(this: any, p: ToastPosition) {
          this.activePos = p;
          window.setTimeout(() => toast(`Toast at ${p}`), 50);
        },
      },
      template: `
        <app-toaster
          [position]="activePos"
          [duration]="duration"
          [maxToasts]="maxToasts"
          [richColors]="richColors"
          [closeButton]="closeButton"
        ></app-toaster>
        <p style="margin: 0 0 12px 0; font-size: 0.875rem;">
          Active position: <code [innerText]="activePos"></code>
        </p>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
          @for (p of positions; track p) {
            <app-button
              [variant]="p === activePos ? 'default' : 'outline'"
              (click)="switchTo(p)"
              [innerText]="p"
            ></app-button>
          }
        </div>
      `,
    };
  },
};

