exports[`Progress snapshots > angular css mode snapshot (monolithic) 1`] = `
"import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-progress',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './progress.component.html',
  styleUrls: ['./progress.component.css'],
})
export class ProgressComponent {
  @Input() value = 0;
  @Input() max = 100;
  @Input() label = '';
  @Input() indeterminate = false;
  @Input() variant: 'linear' | 'circular' = 'linear';
  @Input() size: 'sm' | 'md' | 'lg' = 'md';

  readonly radius = 16;
  readonly circumference = 2 * Math.PI * 16;

  get clamped(): number {
    return Math.min(Math.max(this.value, 0), this.max);
  }

  get pct(): number {
    return this.max > 0 ? (this.clamped / this.max) * 100 : 0;
  }

  get barWidth(): string | null {
    return this.indeterminate ? null : \`\${this.pct}%\`;
  }

  get dashOffset(): number {
    return this.indeterminate ? this.circumference * 0.75 : this.circumference * (1 - this.pct / 100);
  }

  get ariaNow(): number | null {
    return this.indeterminate ? null : this.clamped;
  }
}
"
`;

exports[`Progress snapshots > angular css mode snapshot (monolithic) 2`] = `
"@if (variant === 'circular') {
  <div
    role="progressbar"
    [attr.aria-valuemin]="0"
    [attr.aria-valuemax]="max"
    [attr.aria-valuenow]="ariaNow"
    [attr.aria-label]="label || null"
    class="progress-circular"
    [class.progress-circular--sm]="size === 'sm'"
    [class.progress-circular--md]="size === 'md'"
    [class.progress-circular--lg]="size === 'lg'"
    [class.progress-circular--indeterminate]="indeterminate"
  >
    <svg class="progress-circular-svg" viewBox="0 0 36 36">
      <circle class="progress-circular-track" cx="18" cy="18" r="16" fill="none"></circle>
      <circle
        class="progress-circular-bar"
        cx="18"
        cy="18"
        r="16"
        fill="none"
        [attr.stroke-dasharray]="circumference"
        [attr.stroke-dashoffset]="dashOffset"
      ></circle>
    </svg>
  </div>
} @else {
  <div
    role="progressbar"
    [attr.aria-valuemin]="0"
    [attr.aria-valuemax]="max"
    [attr.aria-valuenow]="ariaNow"
    [attr.aria-label]="label || null"
    class="progress"
    [class.progress--sm]="size === 'sm'"
    [class.progress--md]="size === 'md'"
    [class.progress--lg]="size === 'lg'"
  >
    <div class="progress-bar" [class.progress-bar--indeterminate]="indeterminate" [style.width]="barWidth"></div>
  </div>
}
"
`;

exports[`Progress snapshots > react css mode snapshot 1`] = `
"import React from 'react';
import styles from './Progress.module.css';
export type ProgressVariant = 'linear' | 'circular';
export type ProgressSize    = 'sm' | 'md' | 'lg';

export interface ProgressProps extends Omit<React.HTMLAttributes<HTMLDivElement>, 'role'> {
  /** Current value (0..max) */
  value?: number;
  /** Maximum value */
  max?: number;
  /** Linear bar or circular ring */
  variant?: ProgressVariant;
  /** Bar thickness / ring diameter */
  size?: ProgressSize;
  /** Accessible label */
  label?: string;
  /** Show a continuous (looping) animation instead of a fixed value */
  indeterminate?: boolean;
}

const RADIUS = 16;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;

export const Progress = React.forwardRef<HTMLDivElement, ProgressProps>(
  ({ value = 0, max = 100, variant = 'linear', size = 'md', label, indeterminate = false, className, ...props }, ref) => {
    const clamped = Math.min(Math.max(value, 0), max);
    const pct = max > 0 ? (clamped / max) * 100 : 0;

    const ariaProps = {
      role: 'progressbar' as const,
      'aria-valuemin': 0,
      'aria-valuemax': max,
      'aria-valuenow': indeterminate ? undefined : clamped,
      'aria-label': label,
    };

    if (variant === 'circular') {
      const dashoffset = indeterminate ? CIRCUMFERENCE * 0.75 : CIRCUMFERENCE * (1 - pct / 100);
      const ringStyle = { strokeDasharray: CIRCUMFERENCE, strokeDashoffset: dashoffset };
      const wrapCls = [
        styles['progress-circular'],
        styles[\`progress-circular--\${size}\`],
        indeterminate && styles['progress-circular--indeterminate'],
        className,
      ].filter(Boolean).join(' ');

      return (
        <div ref={ref} className={wrapCls} {...ariaProps} {...props}>
          <svg className={styles['progress-circular-svg']} viewBox="0 0 36 36">
            <circle className={styles['progress-circular-track']} cx="18" cy="18" r={RADIUS} fill="none" />
            <circle className={styles['progress-circular-bar']} cx="18" cy="18" r={RADIUS} fill="none" style={ringStyle} />
          </svg>
        </div>
      );
    }

    const barStyle = indeterminate ? undefined : { width: \`\${pct}%\` };
    const cls = [styles.progress, styles[\`progress--\${size}\`], className].filter(Boolean).join(' ');
    const barCls = [
      styles['progress-bar'],
      indeterminate && styles['progress-bar--indeterminate'],
    ].filter(Boolean).join(' ');

    return (
      <div ref={ref} className={cls} {...ariaProps} {...props}>
        <div className={barCls} style={barStyle} />
      </div>
    );
  }
);

Progress.displayName = 'Progress';
"
`;

exports[`Progress snapshots > react css mode snapshot 2`] = `
"/* Linear */
.progress {
  width: 100%;
  overflow: hidden;
  background-color: var(--progress-track-bg, var(--color-secondary));
  border-radius: var(--progress-radius, 9999px);
}

.progress--sm {
  height: 4px;
}

.progress--md {
  height: 8px;
}

.progress--lg {
  height: 12px;
}

.progress-bar {
  height: 100%;
  background-color: var(--progress-bar-bg, var(--color-primary));
  border-radius: inherit;
  transition: var(--progress-transition, width 0.3s ease);
}

.progress-bar--indeterminate {
  width: 40%;
  animation: progress-indeterminate 1.2s ease-in-out infinite;
}

@keyframes progress-indeterminate {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(350%);
  }
}

/* Circular */
.progress-circular {
  display: inline-flex;
}

.progress-circular--sm {
  width: 24px;
  height: 24px;
}

.progress-circular--md {
  width: 40px;
  height: 40px;
}

.progress-circular--lg {
  width: 56px;
  height: 56px;
}

.progress-circular-svg {
  width: 100%;
  height: 100%;
}

.progress-circular:not(.progress-circular--indeterminate) .progress-circular-svg {
  transform: rotate(-90deg);
}

.progress-circular-track {
  stroke: var(--progress-track-bg, var(--color-secondary));
  stroke-width: 4;
}

.progress-circular-bar {
  stroke: var(--progress-bar-bg, var(--color-primary));
  stroke-width: 4;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.3s ease;
}

.progress-circular--indeterminate .progress-circular-svg {
  animation: progress-spin 0.9s linear infinite;
}

@keyframes progress-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .progress-bar--indeterminate {
    animation: none;
    width: 100%;
  }
  .progress-circular--indeterminate .progress-circular-svg {
    animation-duration: 2.4s;
  }
}
"
`;

