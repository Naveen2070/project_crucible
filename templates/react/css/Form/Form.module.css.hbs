.form {
  display: flex;
  flex-direction: column;
  gap: var(--form-group-gap, {{tokens.componentTokens.form.groupGap}});
  width: 100%;
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  color: var(--color-text, #1a1a2e);
}

/* Layout variants */
.variant-default {
  /* vertical stack (default) */
}

.variant-inline {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-end;
}

/* Sizes drive control height + base font-size */
.size-sm {
  --form-control-h: var(--form-control-height-sm, {{tokens.componentTokens.form.controlHeightSm}});
  font-size: 0.8125rem;
}
.size-md {
  --form-control-h: var(--form-control-height-md, {{tokens.componentTokens.form.controlHeightMd}});
  font-size: 0.875rem;
}
.size-lg {
  --form-control-h: var(--form-control-height-lg, {{tokens.componentTokens.form.controlHeightLg}});
  font-size: 0.9375rem;
}

/* Field is a provider only — it must not introduce a layout box */
.field {
  display: contents;
}

.item {
  display: flex;
  flex-direction: column;
  gap: var(--form-item-gap, {{tokens.componentTokens.form.itemGap}});
  width: 100%;
}
.variant-inline .item {
  width: auto;
}

.label {
  display: inline-flex;
  align-items: center;
  gap: calc(var(--spacing-unit, 4px) * 0.5);
  font-size: 0.875rem;
  font-weight: var(--form-label-weight, {{tokens.componentTokens.form.labelWeight}});
  color: var(--form-label-color, {{tokens.componentTokens.form.labelColor}});
}
.label[data-invalid='true'] {
  color: var(--form-error-color, {{tokens.componentTokens.form.errorColor}});
}

.required {
  color: var(--form-required-color, {{tokens.componentTokens.form.requiredColor}});
}

.control {
  min-height: var(--form-control-h, var(--form-control-height-md, {{tokens.componentTokens.form.controlHeightMd}}));
  width: 100%;
  box-sizing: border-box;
  padding: 0 calc(var(--spacing-unit, 4px) * 3);
  border: 1px solid var(--color-border, #e2e1f0);
  border-radius: var(--form-radius, {{tokens.componentTokens.form.radius}});
  background: var(--color-surface, #fff);
  color: inherit;
  font: inherit;
  transition: var(--form-transition, {{tokens.componentTokens.form.transition}});
}
.control:focus-visible {
  outline: none;
  border-color: var(--color-primary, #6c63ff);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary, #6c63ff) 20%, transparent);
}
.control[aria-invalid='true'] {
  border-color: var(--form-error-color, {{tokens.componentTokens.form.errorColor}});
}

.description {
  margin: 0;
  font-size: var(--form-description-size, {{tokens.componentTokens.form.descriptionSize}});
  color: var(--form-description-color, {{tokens.componentTokens.form.descriptionColor}});
}

.message {
  margin: 0;
  font-size: var(--form-description-size, {{tokens.componentTokens.form.descriptionSize}});
  color: var(--form-error-color, {{tokens.componentTokens.form.errorColor}});
}
.message:empty {
  display: none;
}
.message[data-invalid='true'] {
  animation: form-message-in 120ms ease-out;
}

.submit {
  align-self: flex-start;
  min-height: var(--form-control-h, var(--form-control-height-md, {{tokens.componentTokens.form.controlHeightMd}}));
  padding: 0 calc(var(--spacing-unit, 4px) * 4);
  border: none;
  border-radius: var(--form-radius, {{tokens.componentTokens.form.radius}});
  background: var(--color-primary, #6c63ff);
  color: var(--color-primary-foreground, #fff);
  font: inherit;
  font-weight: 500;
  cursor: pointer;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}
.submit:hover:not(:disabled) {
  background: var(--color-primary-hover, var(--color-primary, #6c63ff));
}
.submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
{{#if a11y.focusRing}}
.submit:focus-visible {
  outline: {{a11y.focusRingWidth}} solid {{a11y.focusRingColor}};
  outline-offset: {{a11y.focusRingOffset}};
}
{{/if}}

@keyframes form-message-in {
  from {
    opacity: 0;
    transform: translateY(-2px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .message[data-invalid='true'] {
    animation: none;
  }
}
