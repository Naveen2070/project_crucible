}
.menu-content .label {
  padding: calc(var(--spacing-unit, 4px) * 1.5) var(--menu-item-padding-x, calc(var(--spacing-unit) * 3));
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--menu-label-color, var(--color-text-muted));
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
@keyframes menu-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
@media (prefers-reduced-motion: reduce) {
