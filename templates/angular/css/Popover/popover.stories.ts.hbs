      control: 'select',
      options: ['sm', 'md', 'lg'],
    },
    showArrow: { control: 'boolean' },
    modal: { control: 'boolean' },
    closeOnClickOutside: { control: 'boolean' },
    closeOnEscape: { control: 'boolean' },
    ariaLabel: { control: 'text' },
  },
  args: {
    placement: 'bottom',
    alignment: 'center',
    trigger: 'click',
    variant: 'default',
    size: 'md',
    showArrow: true,
    modal: false,
    closeOnClickOutside: true,
    closeOnEscape: true,
  },

};

export default meta;
type Story = StoryObj<PopoverComponent>;

export const Default: Story = {
  render: (args) => ({
    moduleMetadata: { imports: [ButtonComponent] },
    props: args,
    template: `
      <app-popover
        #popover
        [placement]="placement"
        [alignment]="alignment"
        [trigger]="trigger"
        [variant]="variant"
        [size]="size"
        [showArrow]="showArrow"
        [modal]="modal"
        [closeOnClickOutside]="closeOnClickOutside"
        [closeOnEscape]="closeOnEscape"
        [ariaLabel]="ariaLabel"
      >
        <app-button trigger variant="primary">Open Popover</app-button>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div>
            <h3 style="margin: 0 0 4px 0; font-size: 0.9375rem; font-weight: 600;">Dimensions</h3>
            <p style="margin: 0; font-size: 0.8125rem; color: var(--color-text-muted, #6B6B8A);">
              Set the dimensions for the layer.
            </p>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 8px;">
            <app-button variant="ghost" size="sm" (click)="popover.close()">Cancel</app-button>
            <app-button variant="primary" size="sm" (click)="popover.close()">Apply</app-button>
          </div>
        </div>
      </app-popover>
    `,
  }),
};

export const AllPlacements: Story = {
  parameters: { layout: 'centered' },

  render: (args) => {
    const sides = ['top', 'bottom', 'left', 'right'] as const;
    const alignments = ['start', 'center', 'end'] as const;
    const placements = sides.flatMap((side) =>
      alignments.map((alignment) => ({ side, alignment, label: `${side}-${alignment}` })),
    );
    return {
      props: { ...args, placements },
      template: `
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
          @for (p of placements; track p.label) {
            <app-popover
              [placement]="p.side"
              [alignment]="p.alignment"
              [trigger]="trigger"
              [variant]="variant"
              [size]="'sm'"
              [showArrow]="showArrow"
              [modal]="modal"
            >
              <app-button trigger variant="outline" size="sm">\{{ p.label }}</app-button>
              <p style="margin: 0; font-size: 0.8125rem;">
                Placement: <strong>\{{ p.label }}</strong>
              </p>
            </app-popover>
          }
        </div>
      `,
    };
  },
};

export const VariantsAndSizes: Story = {
  render: (args) => {
    const variants = ['default', 'minimal'] as const;
    const sizes = ['sm', 'md', 'lg'] as const;
    const cells = variants.flatMap((variant) =>
      sizes.map((size) => ({
        variant,
        size,
        buttonLabel: `${variant} / ${size}`,
        headingLabel: `${variant} · ${size}`,
      })),
    );
    return {
      props: { ...args, cells },
      template: `
        <div style="display: grid; grid-template-columns: repeat(3, auto); gap: 24px; align-items: center; justify-items: center;">
          @for (cell of cells; track cell.buttonLabel) {
            <app-popover
              [placement]="placement"
              [alignment]="alignment"
              [trigger]="trigger"
              [variant]="cell.variant"
              [size]="cell.size"
              [showArrow]="showArrow"
            >
              <app-button trigger variant="primary" [size]="cell.size">\{{ cell.buttonLabel }}</app-button>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <strong style="font-size: 0.875rem;">\{{ cell.headingLabel }}</strong>
                <p style="margin: 0; font-size: inherit; color: var(--color-text-muted, #6B6B8A);">
                  Body text scales with the size token.
                </p>
              </div>
            </app-popover>
          }
        </div>
      `,
    };
  },
};

export const Controlled: Story = {
  render: (args) => ({
    moduleMetadata: { imports: [ButtonComponent] },
    props: {
      ...args,
      controlledOpen: false,
      setOpen(this: any, val: boolean) {
        this.controlledOpen = val;
      },
    },
    template: `
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: center;">
        <app-button variant="ghost" (click)="controlledOpen = !controlledOpen">
          External toggle &mdash; currently \{{ controlledOpen ? 'open' : 'closed' }}
        </app-button>

        <app-popover
          [placement]="placement"
          [alignment]="alignment"
          [trigger]="trigger"
          [variant]="variant"
          [size]="size"
          [showArrow]="showArrow"
          [modal]="modal"
          [isOpen]="controlledOpen"
          (isOpenChange)="setOpen($event)"
        >
          <app-button trigger variant="outline">Popover Trigger</app-button>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <p style="margin: 0; font-size: 0.875rem;">
              This popover's open state is controlled by the parent component.
            </p>
            <app-button variant="primary" size="sm" (click)="setOpen(false)">Close from inside</app-button>
          </div>
        </app-popover>
      </div>
    `,
  }),
};

