import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-skeleton',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './skeleton.component.html',
})
export class SkeletonComponent {
  @Input() variant: {{> shared/variant-types}} = 'default';
  @Input() width?: string | number;
  @Input() height?: string | number;
  @Input() animated = true;

  getTailwindClasses() {
    const variantClasses: Record<string, string> = {
      default: 'w-full h-4 rounded-[var(--skeleton-radius,var(--radius-md))]',
      text: 'w-full h-[0.8em] rounded-sm',
      circle: 'w-10 h-10 rounded-full',
      rect: 'w-full h-4 rounded-none',
    };

    return [
      'block bg-[var(--skeleton-base-color,var(--color-secondary))]',
      variantClasses[this.variant],
      this.animated ? 'motion-safe:animate-pulse' : '',
    ].join(' ');
  }

  get sizeStyle() {
    return {
      width: typeof this.width === 'number' ? `${this.width}px` : this.width,
      height: typeof this.height === 'number' ? `${this.height}px` : this.height,
    };
  }
}
