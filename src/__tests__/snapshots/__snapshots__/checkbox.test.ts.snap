exports[`Checkbox snapshots > angular css mode snapshot (monolithic) 1`] = `
"import { Component, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-checkbox',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './checkbox.component.html',
  styleUrls: ['./checkbox.component.css'],
})
export class CheckboxComponent {
  @Input() label = '';
  @Input() checked = false;
  @Input() indeterminate = false;
  @Input() disabled = false;
  @Input() error = '';
  @Input() variant: 'default' | 'error' = 'default';
  @Input() size: 'sm' | 'md' | 'lg' = 'md';

  @Output() checkedChange = new EventEmitter<boolean>();

  id = 'checkbox-' + Math.random().toString(36).substring(2, 9);

  get isError(): boolean {
    return this.variant === 'error' || !!this.error;
  }

  onChange(event: Event): void {
    this.checkedChange.emit((event.target as HTMLInputElement).checked);
  }
}
"
`;

exports[`Checkbox snapshots > angular css mode snapshot (monolithic) 2`] = `
"<div class="checkbox-field" [class.checkbox-field--disabled]="disabled">
  <div class="checkbox-row">
    <input
      type="checkbox"
      [id]="id"
      class="checkbox"
      [class.checkbox--sm]="size === 'sm'"
      [class.checkbox--md]="size === 'md'"
      [class.checkbox--lg]="size === 'lg'"
      [class.checkbox--error]="isError"
      [checked]="checked"
      [indeterminate]="indeterminate"
      [disabled]="disabled"
      [attr.aria-invalid]="isError"
      [attr.aria-describedby]="error ? id + '-error' : null"
      (change)="onChange($event)"
    />
    @if (label) {
      <label [attr.for]="id" class="label">{{ label }}</label>
    }
  </div>
  @if (error) {
    <span [id]="id + '-error'" class="error" role="alert">{{ error }}</span>
  }
</div>
"
`;

exports[`Checkbox snapshots > react css mode snapshot 1`] = `
"import React, { useId, useRef, useEffect } from 'react';
import styles from './Checkbox.module.css';
export type CheckboxVariant = 'default' | 'error';
export type CheckboxSize    = 'sm' | 'md' | 'lg';

export interface CheckboxProps
  extends Omit<React.InputHTMLAttributes<HTMLInputElement>, 'size' | 'type' | 'onChange'> {
  label?:    string;
  variant?:  CheckboxVariant;
  size?:     CheckboxSize;
  error?:    string;
  /** Render the indeterminate (mixed) visual state */
  indeterminate?: boolean;
  /** Convenience change handler returning the checked boolean */
  onCheckedChange?: (checked: boolean) => void;
}

export const Checkbox = React.forwardRef<HTMLInputElement, CheckboxProps>(
  (
    { label, variant = 'default', size = 'md', error, indeterminate = false, onCheckedChange, id: providedId, className, disabled, ...props },
    ref
  ) => {
    const generatedId = useId();
    const id = providedId || generatedId;
    const errorId = \`\${id}-error\`;
    const isError = !!error || variant === 'error';
    const innerRef = useRef<HTMLInputElement>(null);

    useEffect(() => {
      if (innerRef.current) {
        innerRef.current.indeterminate = indeterminate;
      }
    }, [indeterminate]);

    const setRefs = (node: HTMLInputElement | null) => {
      innerRef.current = node;
      if (typeof ref === 'function') ref(node);
      else if (ref) (ref as React.MutableRefObject<HTMLInputElement | null>).current = node;
    };

    const inputCls = [
      styles.checkbox,
      styles[\`checkbox--\${size}\`],
      isError && styles['checkbox--error'],
      className,
    ].filter(Boolean).join(' ');

    return (
      <div className={[styles['checkbox-field'], disabled && styles['checkbox-field--disabled']].filter(Boolean).join(' ')}>
        <div className={styles['checkbox-row']}>
          <input
            ref={setRefs}
            type="checkbox"
            id={id}
            className={inputCls}
            disabled={disabled}
            aria-invalid={isError}
            aria-describedby={error ? errorId : undefined}
            onChange={(e) => onCheckedChange?.(e.target.checked)}
            {...props}
          />
          {label && (
            <label htmlFor={id} className={styles.label}>
              {label}
            </label>
          )}
        </div>
        {error && (
          <span id={errorId} className={styles.error} role="alert">
            {error}
          </span>
        )}
      </div>
    );
  }
);

Checkbox.displayName = 'Checkbox';
"
`;

exports[`Checkbox snapshots > react css mode snapshot 2`] = `
".checkbox-field {
  display: flex;
  flex-direction: column;
  gap: calc(var(--spacing-unit, 4px) * 1);
}

.checkbox-field--disabled {
  opacity: 0.6;
}

.checkbox-row {
  display: inline-flex;
  align-items: center;
  gap: var(--checkbox-gap, calc(var(--spacing-unit) * 2));
}

.checkbox {
  width: var(--checkbox-size, calc(var(--spacing-unit) * 4));
  height: var(--checkbox-size, calc(var(--spacing-unit) * 4));
  accent-color: var(--checkbox-accent, var(--color-primary));
  border-radius: var(--checkbox-radius, var(--radius-sm));
  cursor: pointer;
  flex-shrink: 0;
  margin: 0;
}

.checkbox:focus-visible {
  outline: 2px solid var(--color-primary, #6C63FF);
  outline-offset: 2px;
}

.checkbox:disabled {
  cursor: not-allowed;
}

/* Sizes */
.checkbox--sm {
  width: 14px;
  height: 14px;
}

.checkbox--md {
  width: 16px;
  height: 16px;
}

.checkbox--lg {
  width: 20px;
  height: 20px;
}

/* States */
.checkbox--error {
  accent-color: var(--color-destructive, #E24B4A);
  outline-color: var(--color-destructive, #E24B4A);
}

.label {
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  font-size: 0.875rem;
  color: var(--checkbox-label-color, var(--color-text));
  cursor: pointer;
  user-select: none;
}

.error {
  font-size: 0.75rem;
  color: var(--color-destructive, #E24B4A);
}
"
`;

