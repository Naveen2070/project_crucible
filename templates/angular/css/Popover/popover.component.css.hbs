.popover-root {
  position: relative;
  display: inline-block;
}

.popover-trigger {
  cursor: pointer;
  display: inline-block;
}

.popover-content {
  position: absolute;
  z-index: var(--popover-z-index, {{tokens.componentTokens.popover.zIndex}});
  background: var(--popover-background, {{tokens.componentTokens.popover.background}});
  color: var(--color-text, var(--foreground, #1A1A2E));
  border: 1px solid var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-radius: var(--popover-radius, {{tokens.componentTokens.popover.radius}});
  box-shadow: var(
    --popover-shadow,
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -2px rgba(0, 0, 0, 0.1)
  );
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  outline: none;
  max-width: calc(100vw - 16px);
}

.popover-content:focus-visible {
  outline: 2px solid var(--color-primary, #6C63FF);
  outline-offset: 2px;
}

.popover-arrow {
  position: absolute;
  width: 8px;
  height: 8px;
  background: inherit;
  border: 1px solid transparent;
  transform: rotate(45deg);
}

.arrow-top {
  border-right-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-bottom-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-bottom {
  border-left-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-top-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-left {
  border-top-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-right-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-right {
  border-left-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-bottom-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

/* Variants */
.variant-default {
  /* uses defaults above */
}

.variant-minimal {
  border: none;
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.08),
    0 2px 4px -1px rgba(0, 0, 0, 0.04);
}

/* Sizes */
.size-sm {
  font-size: 0.8125rem;
  min-width: 200px;
  padding: 12px;
}

.size-md {
  font-size: 0.875rem;
  min-width: 288px;
  padding: 16px;
}

.size-lg {
  font-size: 0.9375rem;
  min-width: 360px;
  padding: 20px;
}

/* Animation — gated on data-state so it only runs after positioning settles */
.popover-content[data-state='open'] {
  animation: popover-show 150ms cubic-bezier(0.16, 1, 0.3, 1);
}

.popover-content[data-state='open'][data-side='top'] {
  animation-name: popover-slide-down;
}
.popover-content[data-state='open'][data-side='bottom'] {
  animation-name: popover-slide-up;
}
.popover-content[data-state='open'][data-side='left'] {
  animation-name: popover-slide-right;
}
.popover-content[data-state='open'][data-side='right'] {
  animation-name: popover-slide-left;
}

@keyframes popover-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes popover-slide-up {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-down {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-left {
  from {
    opacity: 0;
    transform: translateX(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes popover-slide-right {
  from {
    opacity: 0;
    transform: translateX(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .popover-content[data-state='open'] {
    animation: none;
  }
}
