<script setup lang="ts">
import { computed } from 'vue';

export type ProgressVariant = {{> shared/variant-types}};
export type ProgressSize    = {{> shared/size-types}};

interface Props {
  value?:         number;
  max?:           number;
  variant?:       ProgressVariant;
  size?:          ProgressSize;
  label?:         string;
  indeterminate?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
  value: 0,
  max: 100,
  variant: 'linear',
  size: 'md',
  label: '',
  indeterminate: false,
});

const RADIUS = 16;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;

const clamped = computed(() => Math.min(Math.max(props.value, 0), props.max));
const pct = computed(() => (props.max > 0 ? (clamped.value / props.max) * 100 : 0));
const ariaNow = computed(() => (props.indeterminate ? undefined : clamped.value));
const barStyle = computed(() => (props.indeterminate ? {} : { width: `${pct.value}%` }));
const ringStyle = computed(() => ({
  strokeDasharray: CIRCUMFERENCE,
  strokeDashoffset: props.indeterminate ? CIRCUMFERENCE * 0.75 : CIRCUMFERENCE * (1 - pct.value / 100),
}));
</script>

<template>
  <div
    v-if="variant === 'circular'"
    role="progressbar"
    :aria-valuemin="0"
    :aria-valuemax="max"
    :aria-valuenow="ariaNow"
    :aria-label="label || undefined"
    :class="['progress-circular', `progress-circular--${size}`, { 'progress-circular--indeterminate': indeterminate }]"
  >
    <svg class="progress-circular-svg" viewBox="0 0 36 36">
      <circle class="progress-circular-track" cx="18" cy="18" r="16" fill="none" />
      <circle class="progress-circular-bar" cx="18" cy="18" r="16" fill="none" :style="ringStyle" />
    </svg>
  </div>
  <div
    v-else
    role="progressbar"
    :aria-valuemin="0"
    :aria-valuemax="max"
    :aria-valuenow="ariaNow"
    :aria-label="label || undefined"
    :class="['progress', `progress--${size}`]"
  >
    <div :class="['progress-bar', { 'progress-bar--indeterminate': indeterminate }]" :style="barStyle" />
  </div>
</template>

