import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-progress',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './progress.component.html',
  styleUrls: ['./progress.component.{{#if (eq styleSystem "scss")}}scss{{else}}css{{/if}}'],
})
export class ProgressComponent {
  @Input() value = 0;
  @Input() max = 100;
  @Input() label = '';
  @Input() indeterminate = false;
  @Input() variant: {{> shared/variant-types}} = 'linear';
  @Input() size: {{> shared/size-types}} = 'md';

  readonly radius = 16;
  readonly circumference = 2 * Math.PI * 16;

  get clamped(): number {
    return Math.min(Math.max(this.value, 0), this.max);
  }

  get pct(): number {
    return this.max > 0 ? (this.clamped / this.max) * 100 : 0;
  }

  get barWidth(): string | null {
    return this.indeterminate ? null : `${this.pct}%`;
  }

  get dashOffset(): number {
    return this.indeterminate ? this.circumference * 0.75 : this.circumference * (1 - this.pct / 100);
  }

  get ariaNow(): number | null {
    return this.indeterminate ? null : this.clamped;
  }
}
