exports[`Popover Component Snapshots > renders basic Popover correctly 1`] = `
{
  "Popover.module.css": ".trigger {
  all: unset;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.content {
  position: absolute;
  z-index: var(--popover-z-index, 50);
  background-color: var(--popover-background, var(--color-surface));
  color: var(--color-text, var(--foreground, #1A1A2E));
  border: 1px solid var(--popover-border, var(--color-border));
  border-radius: var(--popover-radius, var(--radius-md));
  box-shadow: var(
    --popover-shadow,
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -2px rgba(0, 0, 0, 0.1)
  );
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  outline: none;
  max-width: calc(100vw - 16px);
  transform-origin: var(--floating-ui-transform-origin);
}

.content:focus-visible {
  outline: 2px solid var(--color-primary, #6C63FF);
  outline-offset: 2px;
}

/* Variants */
.variant-default {
  /* uses defaults above */
}

.variant-minimal {
  border: none;
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.08),
    0 2px 4px -1px rgba(0, 0, 0, 0.04);
}

/* Sizes */
.size-sm {
  font-size: 0.8125rem;
  min-width: 200px;
  padding: 12px;
}

.size-md {
  font-size: 0.875rem;
  min-width: 288px;
  padding: 16px;
}

.size-lg {
  font-size: 0.9375rem;
  min-width: 360px;
  padding: 20px;
}

/* Animation — gated on data-state so it only runs after positioning settles */
.content[data-state='open'] {
  animation: popover-show 150ms cubic-bezier(0.16, 1, 0.3, 1);
}

.content[data-state='open'][data-side='top'] {
  animation-name: popover-slide-down;
}
.content[data-state='open'][data-side='bottom'] {
  animation-name: popover-slide-up;
}
.content[data-state='open'][data-side='left'] {
  animation-name: popover-slide-right;
}
.content[data-state='open'][data-side='right'] {
  animation-name: popover-slide-left;
}

@keyframes popover-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes popover-slide-up {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-down {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-left {
  from {
    opacity: 0;
    transform: translateX(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes popover-slide-right {
  from {
    opacity: 0;
    transform: translateX(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .content[data-state='open'] {
    animation: none;
  }
}

.item {
  padding: 8px 12px;
  cursor: pointer;
  border-radius: 4px;
  transition: background-color 0.2s;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.875rem;
}

.item:hover {
  background-color: var(--color-accent, #f3f4f6);
}

.separator {
  height: 1px;
  background-color: var(--color-border, #e5e7eb);
  margin: 4px 0;
}
