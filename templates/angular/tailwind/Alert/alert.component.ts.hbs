import { Component, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-alert',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './alert.component.html',
})
export class AlertComponent {
  @Input() variant: {{> shared/variant-types}} = 'default';
  @Input() title = '';
  @Input() closeable = false;
  @Input() icon = '';

  @Output() close = new EventEmitter<void>();

  private readonly defaultIcons: Record<string, string> = {
    default: 'ℹ',
    info: 'ℹ',
    success: '✓',
    warning: '⚠',
    destructive: '✕',
  };

  get displayIcon(): string {
    return this.icon || this.defaultIcons[this.variant];
  }

  getAlertClasses() {
    const variantClasses: Record<string, string> = {
{{#each variants}}      {{this}}: '{{lookup ../tailwindVariants this}}',
{{/each}}    };

    return ['flex items-start gap-3 p-3 rounded-[var(--radius-md)] border', variantClasses[this.variant]].join(' ');
  }
}
