export const Controlled: Story = {
  render: function ControlledStory() {
    const [value, setValue] = React.useState('one');
    return (
      <div style=\{{ maxWidth: '480px', display: 'flex', flexDirection: 'column', gap: '12px' }}>
        <div style=\{{ display: 'flex', gap: '8px' }}>
          <button type="button" onClick={() => setValue('one')}>Force One</button>
          <button type="button" onClick={() => setValue('two')}>Force Two</button>
          <button type="button" onClick={() => setValue('three')}>Force Three</button>
        </div>
        <Tabs value={value} onValueChange={setValue}>
          <Tabs.List>
            <Tabs.Trigger value="one">One</Tabs.Trigger>
            <Tabs.Trigger value="two">Two</Tabs.Trigger>
            <Tabs.Trigger value="three">Three</Tabs.Trigger>
          </Tabs.List>
          <Tabs.Content value="one">Current value: <strong>{value}</strong></Tabs.Content>
          <Tabs.Content value="two">Current value: <strong>{value}</strong></Tabs.Content>
          <Tabs.Content value="three">Current value: <strong>{value}</strong></Tabs.Content>
        </Tabs>
      </div>
    );
  },
};
