"import React, {
  createContext,
  useContext,
  useState,
  useMemo,
  useCallback,
  useEffect,
  useRef,
  useId,
} from 'react';

export type AccordionSize = 'sm' | 'md' | 'lg';
export type AccordionVariant = 'default' | 'bordered' | 'separated';
export type AccordionType = 'single' | 'multiple';

export interface AccordionOptions {
  type?: AccordionType;
  value?: string | string[];
  defaultValue?: string | string[];
  onValueChange?: (value: string | string[]) => void;
  collapsible?: boolean;
}

interface TriggerRegistration {
  value: string;
  disabled: boolean;
  el: HTMLButtonElement | null;
}

const toOpenSet = (value: string | string[] | undefined): Set<string> => {
  if (value == null) return new Set();
  return new Set(Array.isArray(value) ? value : [value]);
};

export function useAccordion({
  type = 'single',
  value: controlledValue,
  defaultValue,
  onValueChange,
  collapsible = true,
}: AccordionOptions = {}) {
  const [uncontrolledValue, setUncontrolledValue] = useState<string | string[] | undefined>(
    defaultValue
  );
  const value = controlledValue ?? uncontrolledValue;
  const openSet = useMemo(() => toOpenSet(value), [value]);
  const rootId = useId();
  const triggersRef = useRef<Map<string, TriggerRegistration>>(new Map());
  const orderRef = useRef<string[]>([]);

  const commit = useCallback(
    (next: string | string[]) => {
      if (controlledValue === undefined) {
        setUncontrolledValue(next);
      }
      onValueChange?.(next);
    },
    [controlledValue, onValueChange]
  );

  const toggle = useCallback(
    (val: string) => {
      if (type === 'multiple') {
        const next = new Set(openSet);
        if (next.has(val)) next.delete(val);
        else next.add(val);
        commit(Array.from(next));
        return;
      }
      const isOpen = openSet.has(val);
      if (isOpen) {
        commit(collapsible ? '' : val);
      } else {
        commit(val);
      }
    },
    [type, openSet, collapsible, commit]
  );

  const isOpen = useCallback((val: string) => openSet.has(val), [openSet]);

  const registerTrigger = useCallback(
    (val: string, disabled: boolean, el: HTMLButtonElement | null) => {
      const map = triggersRef.current;
      if (el === null) {
        map.delete(val);
        orderRef.current = orderRef.current.filter((v) => v !== val);
        return;
      }
      if (!map.has(val)) {
        orderRef.current.push(val);
      }
      map.set(val, { value: val, disabled, el });
    },
    []
  );

  const focusTrigger = useCallback((val: string) => {
    const entry = triggersRef.current.get(val);
    entry?.el?.focus();
  }, []);

  const moveFocus = useCallback(
    (current: string, direction: 1 | -1) => {
      const order = orderRef.current;
      const enabled = order.filter((v) => !triggersRef.current.get(v)?.disabled);
      if (enabled.length === 0) return null;
      const idx = enabled.indexOf(current);
      const nextIdx = idx === -1 ? 0 : (idx + direction + enabled.length) % enabled.length;
      const next = enabled[nextIdx];
      focusTrigger(next);
      return next;
    },
    [focusTrigger]
  );

  const focusEdge = useCallback(
    (edge: 'first' | 'last') => {
      const enabled = orderRef.current.filter((v) => !triggersRef.current.get(v)?.disabled);
      if (enabled.length === 0) return null;
      const next = edge === 'first' ? enabled[0] : enabled[enabled.length - 1];
      focusTrigger(next);
      return next;
    },
    [focusTrigger]
  );

  return useMemo(
    () => ({
      type,
      isOpen,
      toggle,
      rootId,
      registerTrigger,
      focusTrigger,
      moveFocus,
      focusEdge,
    }),
    [type, isOpen, toggle, rootId, registerTrigger, focusTrigger, moveFocus, focusEdge]
  );
}

type AccordionContextType = ReturnType<typeof useAccordion> | null;
const AccordionContext = createContext<AccordionContextType>(null);

const useAccordionContext = () => {
  const context = useContext(AccordionContext);
  if (context == null) {
    throw new Error('Accordion components must be wrapped in <Accordion.Root />');
  }
  return context;
};

type ItemContextType = { value: string; disabled: boolean } | null;
const ItemContext = createContext<ItemContextType>(null);

const useItemContext = () => {
  const context = useContext(ItemContext);
  if (context == null) {
    throw new Error('Accordion.Trigger / Accordion.Content must be wrapped in <Accordion.Item />');
  }
  return context;
};

const buildTriggerId = (rootId: string, value: string) =>
  \`\${rootId}-trigger-\${value.replace(/[^a-zA-Z0-9_-]/g, '_')}\`;
const buildContentId = (rootId: string, value: string) =>
  \`\${rootId}-content-\${value.replace(/[^a-zA-Z0-9_-]/g, '_')}\`;

const cn = (...parts: Array<string | false | null | undefined>) =>
  parts.filter(Boolean).join(' ');

const ROOT_BASE = 'flex w-full flex-col';

const VARIANT_ROOT: Record<AccordionVariant, string> = {
  default: '',
  bordered: 'border border-[var(--color-border)] rounded-[var(--radius-md)] overflow-hidden',
  separated: 'gap-2',
};

const ITEM_BASE = 'border-b border-[var(--accordion-border-color,var(--color-border))]';

const VARIANT_ITEM: Record<AccordionVariant, string> = {
  default: '',
  bordered: 'last:border-b-0',
  separated:
    'border border-[var(--accordion-border-color,var(--color-border))] rounded-[var(--radius-md)] overflow-hidden',
};

const TRIGGER_BASE = [
  'flex w-full items-center justify-between gap-2 text-left',
  'px-[var(--accordion-trigger-padding-x,8px)] py-[var(--accordion-trigger-padding-y,12px)]',
  'text-[var(--accordion-trigger-color,var(--color-text))] font-medium',
  'transition-colors',
  'hover:not-data-[disabled]:bg-[var(--accordion-trigger-hover-bg,var(--color-secondary))]',
  'disabled:opacity-50 disabled:cursor-not-allowed',
  'data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed',
  'focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--color-primary)]',
].join(' ');

const SIZE_TRIGGER: Record<AccordionSize, string> = {
  sm: 'text-[0.8125rem]',
  md: 'text-sm',
  lg: 'text-[0.9375rem]',
};

const CONTENT_BASE =
  'py-[var(--accordion-content-padding-y,12px)] px-[var(--accordion-trigger-padding-x,8px)] text-[var(--color-text)]';

const CHEVRON_BASE =
  'shrink-0 transition-transform duration-200 group-data-[state=open]/trigger:rotate-180';

const ChevronIcon = () => (
  <svg
    className={CHEVRON_BASE}
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    strokeWidth="2"
    strokeLinecap="round"
    strokeLinejoin="round"
    aria-hidden="true"
  >
    <polyline points="6 9 12 15 18 9" />
  </svg>
);

/**
 * Internal Accordion Components
 */
export interface AccordionRootProps extends AccordionOptions {
  children: React.ReactNode;
  variant?: AccordionVariant;
  size?: AccordionSize;
  className?: string;
}

const InternalRoot = React.forwardRef<HTMLDivElement, AccordionRootProps>(
  function AccordionRoot(
    { children, variant = 'default', size = 'md', className, ...options },
    ref
  ) {
    const accordion = useAccordion(options);
    return (
      <AccordionContext.Provider value={accordion}>
        <div
          ref={ref}
          className={cn(ROOT_BASE, VARIANT_ROOT[variant], className)}
          data-variant={variant}
          data-size={size}
        >
          {children}
        </div>
      </AccordionContext.Provider>
    );
  }
);

export interface AccordionItemProps extends React.HTMLAttributes<HTMLDivElement> {
  value: string;
  disabled?: boolean;
  variant?: AccordionVariant;
}

const InternalItem = React.forwardRef<HTMLDivElement, AccordionItemProps>(
  function AccordionItem(
    { value, disabled = false, className, children, variant = 'default', ...props },
    ref
  ) {
    const ctx = useAccordionContext();
    const open = ctx.isOpen(value);
    const itemValue = useMemo(() => ({ value, disabled }), [value, disabled]);

    return (
      <ItemContext.Provider value={itemValue}>
        <div
          ref={ref}
          className={cn(ITEM_BASE, VARIANT_ITEM[variant], className)}
          data-state={open ? 'open' : 'closed'}
          data-disabled={disabled || undefined}
          {...props}
        >
          {children}
        </div>
      </ItemContext.Provider>
    );
  }
);

export interface AccordionTriggerProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  size?: AccordionSize;
}

const InternalTrigger = React.forwardRef<HTMLButtonElement, AccordionTriggerProps>(
  function AccordionTrigger({ className, onClick, children, size = 'md', ...props }, propRef) {
    const ctx = useAccordionContext();
    const { value, disabled } = useItemContext();
    const open = ctx.isOpen(value);
    const innerRef = useRef<HTMLButtonElement | null>(null);

    const setRef = useCallback(
      (el: HTMLButtonElement | null) => {
        innerRef.current = el;
        if (typeof propRef === 'function') propRef(el);
        else if (propRef) (propRef as React.MutableRefObject<HTMLButtonElement | null>).current = el;
        ctx.registerTrigger(value, disabled, el);
      },
      [ctx, value, disabled, propRef]
    );

    useEffect(() => () => ctx.registerTrigger(value, disabled, null), [ctx, value, disabled]);

    const handleClick = (e: React.MouseEvent<HTMLButtonElement>) => {
      onClick?.(e);
      if (e.defaultPrevented || disabled) return;
      ctx.toggle(value);
    };

    const handleKeyDown = (e: React.KeyboardEvent<HTMLButtonElement>) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        ctx.moveFocus(value, 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        ctx.moveFocus(value, -1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        ctx.focusEdge('first');
      } else if (e.key === 'End') {
        e.preventDefault();
        ctx.focusEdge('last');
      }
    };

    return (
      <h3 className="m-0">
        <button
          ref={setRef}
          type="button"
          id={buildTriggerId(ctx.rootId, value)}
          aria-expanded={open}
          aria-controls={buildContentId(ctx.rootId, value)}
          data-state={open ? 'open' : 'closed'}
          data-value={value}
          data-disabled={disabled || undefined}
          disabled={disabled}
          className={cn('group/trigger', TRIGGER_BASE, SIZE_TRIGGER[size], className)}
          onClick={handleClick}
          onKeyDown={handleKeyDown}
          {...props}
        >
          <span className="flex-1 min-w-0">{children}</span>
          <ChevronIcon />
        </button>
      </h3>
    );
  }
);

export interface AccordionContentProps extends React.HTMLAttributes<HTMLDivElement> {
  forceMount?: boolean;
}

const InternalContent = React.forwardRef<HTMLDivElement, AccordionContentProps>(
  function AccordionContent({ forceMount = false, className, children, ...props }, ref) {
    const ctx = useAccordionContext();
    const { value } = useItemContext();
    const open = ctx.isOpen(value);

    if (!open && !forceMount) {
      return null;
    }

    return (
      <div
        ref={ref}
        role="region"
        id={buildContentId(ctx.rootId, value)}
        aria-labelledby={buildTriggerId(ctx.rootId, value)}
        data-state={open ? 'open' : 'closed'}
        hidden={!open}
        className={cn(CONTENT_BASE, className)}
        {...props}
      >
        {children}
      </div>
    );
  }
);

InternalRoot.displayName = 'Accordion.Root';
InternalItem.displayName = 'Accordion.Item';
InternalTrigger.displayName = 'Accordion.Trigger';
InternalContent.displayName = 'Accordion.Content';

export const AccordionRoot = InternalRoot;
export const AccordionItem = InternalItem;
export const AccordionTrigger = InternalTrigger;
export const AccordionContent = InternalContent;

export const Accordion = Object.assign(AccordionRoot, {
  Root: AccordionRoot,
  Item: AccordionItem,
  Trigger: AccordionTrigger,
  Content: AccordionContent,
});
"
`;

exports[`Accordion snapshots > vue css mode snapshot 1`] = `
"<script lang="ts">
import {
  defineComponent,
  h,
  inject,
  provide,
  reactive,
  computed,
  useId,
  onMounted,
  onBeforeUnmount,
  ref,
  type InjectionKey,
  type PropType,
} from 'vue';

export type AccordionSize = 'sm' | 'md' | 'lg';
export type AccordionVariant = 'default' | 'bordered' | 'separated';
export type AccordionType = 'single' | 'multiple';

export interface AccordionItem {
  value: string;
  label: string;
  content?: string;
  disabled?: boolean;
}

interface TriggerRegistration {
  value: string;
  disabled: boolean;
  el: HTMLButtonElement | null;
}

export interface AccordionApi {
  readonly type: AccordionType;
  isOpen: (value: string) => boolean;
  toggle: (value: string) => void;
  rootId: string;
  registerTrigger: (val: string, disabled: boolean, el: HTMLButtonElement | null) => void;
  moveFocus: (current: string, direction: 1 | -1) => string | null;
  focusEdge: (edge: 'first' | 'last') => string | null;
}

export const AccordionContextKey: InjectionKey<AccordionApi> = Symbol('crucible-accordion');

interface ItemApi {
  value: string;
  disabled: boolean;
}
export const AccordionItemKey: InjectionKey<ItemApi> = Symbol('crucible-accordion-item');

function useAccordionApi(): AccordionApi {
  const ctx = inject(AccordionContextKey, null);
  if (!ctx) throw new Error('Accordion sub-components must be used inside <Accordion />');
  return ctx;
}

function useItemApi(): ItemApi {
  const ctx = inject(AccordionItemKey, null);
  if (!ctx) throw new Error('AccordionTrigger / AccordionContent must be used inside <AccordionItem />');
  return ctx;
}

export const buildTriggerId = (rootId: string, value: string) =>
  \`\${rootId}-trigger-\${value.replace(/[^a-zA-Z0-9_-]/g, '_')}\`;
export const buildContentId = (rootId: string, value: string) =>
  \`\${rootId}-content-\${value.replace(/[^a-zA-Z0-9_-]/g, '_')}\`;

export const AccordionItem = defineComponent({
  name: 'AccordionItem',
  props: {
    value: { type: String, required: true },
    disabled: { type: Boolean, default: false },
  },
  setup(props, { slots }) {
    const accordion = useAccordionApi();
    provide(AccordionItemKey, {
      get value() {
        return props.value;
      },
      get disabled() {
        return props.disabled;
      },
    } as ItemApi);
    return () => {
      const open = accordion.isOpen(props.value);
      return h(
        'div',
        {
          class: 'item',
          'data-state': open ? 'open' : 'closed',
          'data-disabled': props.disabled ? '' : undefined,
        },
        slots.default?.(),
      );
    };
  },
});

export const AccordionTrigger = defineComponent({
  name: 'AccordionTrigger',
  setup(_, { slots }) {
    const accordion = useAccordionApi();
    const item = useItemApi();
    const elRef = ref<HTMLButtonElement | null>(null);

    onMounted(() => accordion.registerTrigger(item.value, item.disabled, elRef.value));
    onBeforeUnmount(() => accordion.registerTrigger(item.value, item.disabled, null));

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); accordion.moveFocus(item.value, 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); accordion.moveFocus(item.value, -1); }
      else if (e.key === 'Home') { e.preventDefault(); accordion.focusEdge('first'); }
      else if (e.key === 'End') { e.preventDefault(); accordion.focusEdge('last'); }
    };

    return () => {
      const open = accordion.isOpen(item.value);
      return h('h3', { class: 'header' }, [
        h(
          'button',
          {
            ref: (el: any) => (elRef.value = el as HTMLButtonElement | null),
            type: 'button',
            id: buildTriggerId(accordion.rootId, item.value),
            'aria-expanded': open,
            'aria-controls': buildContentId(accordion.rootId, item.value),
            'data-state': open ? 'open' : 'closed',
            'data-value': item.value,
            'data-disabled': item.disabled ? '' : undefined,
            disabled: item.disabled,
            class: 'trigger',
            onClick: () => {
              if (item.disabled) return;
              accordion.toggle(item.value);
            },
            onKeydown: onKeyDown,
          },
          [
            h('span', { class: 'label' }, slots.default?.()),
            h(
              'svg',
              {
                class: 'chevron',
                width: '16',
                height: '16',
                viewBox: '0 0 24 24',
                fill: 'none',
                stroke: 'currentColor',
                'stroke-width': '2',
                'stroke-linecap': 'round',
                'stroke-linejoin': 'round',
                'aria-hidden': 'true',
              },
              [h('polyline', { points: '6 9 12 15 18 9' })],
            ),
          ],
        ),
      ]);
    };
  },
});

export const AccordionContent = defineComponent({
  name: 'AccordionContent',
  props: {
    forceMount: { type: Boolean, default: false },
  },
  setup(props, { slots }) {
    const accordion = useAccordionApi();
    const item = useItemApi();
    return () => {
      const open = accordion.isOpen(item.value);
      if (!open && !props.forceMount) return null;
      return h(
        'div',
        {
          role: 'region',
          id: buildContentId(accordion.rootId, item.value),
          'aria-labelledby': buildTriggerId(accordion.rootId, item.value),
          'data-state': open ? 'open' : 'closed',
          hidden: !open,
          class: 'content',
        },
        slots.default?.(),
      );
    };
  },
});
</script>

<script setup lang="ts">
const props = withDefaults(
  defineProps<{
    variant?: AccordionVariant;
    size?: AccordionSize;
    type?: AccordionType;
    value?: string | string[];
    defaultValue?: string | string[];
    collapsible?: boolean;
    /** Schema-driven (monolithic) */
    items?: AccordionItem[];
  }>(),
  { variant: 'default', size: 'md', type: 'single', collapsible: true, items: () => [] },
);

const emit = defineEmits<{
  (e: 'update:value', value: string | string[]): void;
  (e: 'valueChange', value: string | string[]): void;
}>();

const uid = useId();
const rootId = \`accordion-\${uid}\`;

const triggers = new Map<string, TriggerRegistration>();
const order: string[] = [];

const toOpenSet = (value: string | string[] | undefined): Set<string> => {
  if (value == null) return new Set();
  return new Set(Array.isArray(value) ? value : [value]);
};

const internal = reactive({ value: props.value ?? props.defaultValue });

const commit = (next: string | string[]) => {
  if (props.value === undefined) internal.value = next;
  emit('update:value', next);
  emit('valueChange', next);
};

const currentValue = computed(() => props.value ?? internal.value);
const openSet = computed(() => toOpenSet(currentValue.value));

const isOpen = (value: string) => openSet.value.has(value);

const toggle = (value: string) => {
  if (props.type === 'multiple') {
    const next = new Set(openSet.value);
    if (next.has(value)) next.delete(value);
    else next.add(value);
    commit(Array.from(next));
    return;
  }
  if (openSet.value.has(value)) {
    commit(props.collapsible ? '' : value);
  } else {
    commit(value);
  }
};

const registerTrigger = (val: string, disabled: boolean, el: HTMLButtonElement | null) => {
  if (el === null) {
    triggers.delete(val);
    const idx = order.indexOf(val);
    if (idx >= 0) order.splice(idx, 1);
    return;
  }
  if (!triggers.has(val)) order.push(val);
  triggers.set(val, { value: val, disabled, el });
};

const focusTrigger = (val: string) => {
  triggers.get(val)?.el?.focus();
};

const moveFocus = (current: string, direction: 1 | -1) => {
  const enabled = order.filter((v) => !triggers.get(v)?.disabled);
  if (enabled.length === 0) return null;
  const idx = enabled.indexOf(current);
  const nextIdx = idx === -1 ? 0 : (idx + direction + enabled.length) % enabled.length;
  const next = enabled[nextIdx];
  focusTrigger(next);
  return next;
};

const focusEdge = (edge: 'first' | 'last') => {
  const enabled = order.filter((v) => !triggers.get(v)?.disabled);
  if (enabled.length === 0) return null;
  const next = edge === 'first' ? enabled[0] : enabled[enabled.length - 1];
  focusTrigger(next);
  return next;
};

const api: AccordionApi = {
  get type() {
    return props.type;
  },
  isOpen,
  toggle,
  rootId,
  registerTrigger,
  moveFocus,
  focusEdge,
};

provide(AccordionContextKey, api);

const rootClasses = computed(() => [
  'accordion-root',
  \`variant-\${props.variant}\`,
  \`size-\${props.size}\`,
]);
</script>

<template>
  <div :class="rootClasses">
    <slot :api="api" />
  </div>
</template>

<!--
  NOT scoped: AccordionItem/AccordionTrigger/AccordionContent are separate component
  instances, so Vue's scoped styles would not reach their DOM. Each rule is qualified
  by .accordion-root to avoid bleeding into other components.
-->
<style >
.accordion-root {
  display: flex;
  flex-direction: column;
  width: 100%;
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  color: var(--color-text, #1a1a2e);
}
.accordion-root .item {
  border-bottom: 1px solid var(--accordion-border-color, var(--color-border));
}
.accordion-root .header {
  margin: 0;
}
.accordion-root .trigger {
  all: unset;
  box-sizing: border-box;
  cursor: pointer;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-unit, 4px);
  padding: var(--accordion-trigger-padding-y, calc(var(--spacing-unit) * 3))
    var(--accordion-trigger-padding-x, calc(var(--spacing-unit) * 2));
  color: var(--accordion-trigger-color, var(--color-text));
  font-size: 0.875rem;
  font-weight: 500;
  text-align: left;
  transition: var(--accordion-transition, background-color 0.2s ease);
}
.accordion-root .trigger:hover:not([data-disabled]) {
  background-color: var(--accordion-trigger-hover-bg, var(--color-secondary));
}
.accordion-root .trigger[data-disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}
.accordion-root .trigger:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: calc(-1 * 2px);
}
.accordion-root .label {
  flex: 1;
  min-width: 0;
}
.accordion-root .chevron {
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
.accordion-root .trigger[data-state='open'] .chevron {
  transform: rotate(180deg);
}
.accordion-root .content {
  padding-block: var(--accordion-content-padding-y, calc(var(--spacing-unit) * 3));
  padding-inline: var(--accordion-trigger-padding-x, calc(var(--spacing-unit) * 2));
  color: var(--color-text, #1a1a2e);
}
.accordion-root .content[hidden] {
  display: none;
}
.accordion-root.size-sm .trigger {
  font-size: 0.8125rem;
}
.accordion-root.size-md .trigger {
  font-size: 0.875rem;
}
.accordion-root.size-lg .trigger {
  font-size: 0.9375rem;
}
.accordion-root.variant-bordered {
  border: 1px solid var(--accordion-border-color, var(--color-border));
  border-radius: var(--accordion-radius, var(--radius-md));
  overflow: hidden;
}
.accordion-root.variant-bordered .item:last-child {
  border-bottom: none;
}
.accordion-root.variant-separated {
  gap: calc(var(--spacing-unit, 4px) * 2);
}
.accordion-root.variant-separated .item {
  border: 1px solid var(--accordion-border-color, var(--color-border));
  border-radius: var(--accordion-radius, var(--radius-md));
  overflow: hidden;
}
@media (prefers-reduced-motion: reduce) {
  .accordion-root .trigger,
  .accordion-root .chevron { transition: none; }
}
</style>
"
`;
