import type { Meta, StoryObj } from '@storybook/angular';
import { RadioGroupComponent } from './radiogroup.component';

const meta: Meta<RadioGroupComponent> = {
  title: 'Crucible/RadioGroup',
  component: RadioGroupComponent,
  tags: ['autodocs'],
  argTypes: {
    size: { control: 'select', options: ['sm', 'md', 'lg'] },
    orientation: { control: 'select', options: ['vertical', 'horizontal'] },
  },
  args: { size: 'md', orientation: 'vertical' },
};

export default meta;
type Story = StoryObj<RadioGroupComponent>;

const onValueChange = (value: string) => console.log('Radio changed:', value);

export const Default: Story = {
  args: {
    items: [
      { value: 'default', label: 'Default' },
      { value: 'comfortable', label: 'Comfortable' },
      { value: 'compact', label: 'Compact' },
    ],
    defaultValue: 'comfortable',
    name: 'density',
  },
  render: (args) => ({
    props: { ...args, onValueChange },
    template: `<app-radio-group
      [items]="items"
      [defaultValue]="defaultValue"
      [size]="size"
      [orientation]="orientation"
      [name]="name"
      (valueChange)="onValueChange($event)"
    ></app-radio-group>`,
  }),
};

