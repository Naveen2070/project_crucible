exports[`DropdownMenu snapshots > vue css mode snapshot 1`] = `
"<script lang="ts">
import {
  defineComponent,
  h,
  Teleport,
  inject,
  provide,
  ref,
  computed,
  onMounted,
  onBeforeUnmount,
  nextTick,
  getCurrentInstance,
  useId,
  type InjectionKey,
  type PropType,
} from 'vue';
import { useFloating, offset, flip, shift, autoUpdate, type Placement } from '@floating-ui/vue';
import { RovingFocusManager } from './utils/roving-focus';

export type DropdownMenuSize = 'sm' | 'md' | 'lg';
export type DropdownMenuVariant = 'default' | 'minimal';

export interface DropdownMenuItemModel {
  value: string;
  label: string;
  disabled?: boolean;
  separatorBefore?: boolean;
  onSelect?: () => void;
}

export interface DropdownMenuApi {
  readonly open: boolean;
  setOpen: (next: boolean) => void;
  closeOnSelect: boolean;
  rootId: string;
  triggerRef: ReturnType<typeof ref<HTMLElement | null>>;
  contentRef: ReturnType<typeof ref<HTMLElement | null>>;
  floatingStyles: ReturnType<typeof useFloating>['floatingStyles'];
  isPositioned: ReturnType<typeof useFloating>['isPositioned'];
  registerItem: (id: number, disabled: boolean, el: HTMLButtonElement | null) => void;
  onItemSelect: (onSelect?: () => void) => void;
  moveFocus: (current: number, direction: 1 | -1) => void;
  focusEdge: (edge: 'first' | 'last') => void;
}

export const DropdownMenuContextKey: InjectionKey<DropdownMenuApi> = Symbol('crucible-dropdown-menu');

function useDropdownMenuApi(): DropdownMenuApi {
  const ctx = inject(DropdownMenuContextKey, null);
  if (!ctx) throw new Error('DropdownMenu sub-components must be used inside <DropdownMenu />');
  return ctx;
}

let itemUid = 0;

export const DropdownMenuTrigger = defineComponent({
  name: 'DropdownMenuTrigger',
  setup(_, { slots }) {
    const menu = useDropdownMenuApi();
    return () =>
      h(
        'button',
        {
          ref: (el: any) => (menu.triggerRef.value = el as HTMLElement | null),
          type: 'button',
          class: 'trigger',
          'aria-haspopup': 'menu',
          'aria-expanded': menu.open,
          'data-state': menu.open ? 'open' : 'closed',
          onClick: () => menu.setOpen(!menu.open),
        },
        slots.default?.(),
      );
  },
});

export const DropdownMenuContent = defineComponent({
  name: 'DropdownMenuContent',
  props: {
    size: { type: String as PropType<DropdownMenuSize>, default: 'md' },
    variant: { type: String as PropType<DropdownMenuVariant>, default: 'default' },
  },
  setup(props, { slots }) {
    const menu = useDropdownMenuApi();
    const onKeydown = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const idAttr = target.getAttribute('data-item-id');
      const current = idAttr != null ? Number(idAttr) : -1;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        menu.moveFocus(current, 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        menu.moveFocus(current, -1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        menu.focusEdge('first');
      } else if (e.key === 'End') {
        e.preventDefault();
        menu.focusEdge('last');
      } else if (e.key === 'Escape') {
        e.preventDefault();
        menu.setOpen(false);
      }
    };

    return () => {
      if (!menu.open) return null;
      return h(Teleport, { to: 'body' }, [
        h(
          'div',
          {
            ref: (el: any) => (menu.contentRef.value = el as HTMLElement | null),
            role: 'menu',
            class: ['menu-content', \`size-\${props.size}\`, \`variant-\${props.variant}\`],
            style: [menu.floatingStyles.value, { visibility: menu.isPositioned.value ? 'visible' : 'hidden' }],
            'data-state': menu.open && menu.isPositioned.value ? 'open' : 'closed',
            tabindex: -1,
            onKeydown,
          },
          slots.default?.(),
        ),
      ]);
    };
  },
});

export const DropdownMenuItem = defineComponent({
  name: 'DropdownMenuItem',
  props: {
    disabled: { type: Boolean, default: false },
    onSelect: { type: Function as PropType<() => void>, default: undefined },
  },
  emits: ['select'],
  setup(props, { slots, emit }) {
    const menu = useDropdownMenuApi();
    const elRef = ref<HTMLButtonElement | null>(null);
    const id = itemUid++;

    onMounted(() => menu.registerItem(id, props.disabled, elRef.value));
    onBeforeUnmount(() => menu.registerItem(id, props.disabled, null));

    return () =>
      h(
        'button',
        {
          ref: (el: any) => (elRef.value = el as HTMLButtonElement | null),
          type: 'button',
          role: 'menuitem',
          class: 'item',
          'data-item-id': id,
          'data-disabled': props.disabled ? '' : undefined,
          disabled: props.disabled,
          tabindex: -1,
          onClick: () => {
            if (props.disabled) return;
            emit('select');
            menu.onItemSelect(props.onSelect);
          },
        },
        slots.default?.(),
      );
  },
});

export const DropdownMenuSeparator = defineComponent({
  name: 'DropdownMenuSeparator',
  setup() {
    return () => h('div', { role: 'separator', class: 'separator' });
  },
});

export const DropdownMenuLabel = defineComponent({
  name: 'DropdownMenuLabel',
  setup(_, { slots }) {
    return () => h('div', { class: 'label' }, slots.default?.());
  },
});
</script>

<script setup lang="ts">
const props = withDefaults(
  defineProps<{
    placement?: Placement;
    open?: boolean;
    variant?: DropdownMenuVariant;
    size?: DropdownMenuSize;
    closeOnSelect?: boolean;
    /** Schema-driven (monolithic) */
    triggerLabel?: string;
    items?: DropdownMenuItemModel[];
  }>(),
  {
    placement: 'bottom-start',
    variant: 'default',
    size: 'md',
    closeOnSelect: true,
    triggerLabel: 'Open',
    items: () => [],
  },
);

const emit = defineEmits<{
  (e: 'update:open', value: boolean): void;
  (e: 'select', value: string): void;
}>();

const instance = getCurrentInstance();
const isControlled = computed(() => {
  if (!instance) return false;
  const propsObj = instance.vnode.props || {};
  return 'open' in propsObj;
});

const uid = useId();
const rootId = \`menu-\${uid}\`;

const internalOpen = ref(false);
const open = computed(() => (isControlled.value ? !!props.open : internalOpen.value));

const triggerRef = ref<HTMLElement | null>(null);
const contentRef = ref<HTMLElement | null>(null);

const roving = new RovingFocusManager<number>();

const setOpen = (next: boolean) => {
  if (!isControlled.value) internalOpen.value = next;
  emit('update:open', next);
  if (next) {
    nextTick(() => {
      const first = enabledOrder()[0];
      if (first !== undefined) roving.focus(first);
    });
  } else {
    triggerRef.value?.focus();
  }
};

const enabledOrder = () => roving.enabled();

const registerItem = (id: number, disabled: boolean, el: HTMLButtonElement | null) =>
  roving.register(id, disabled, el);

const moveFocus = (current: number, direction: 1 | -1) => {
  roving.moveFocus(current, direction);
};

const focusEdge = (edge: 'first' | 'last') => {
  roving.focusEdge(edge);
};

const onItemSelect = (onSelect?: () => void) => {
  onSelect?.();
  if (props.closeOnSelect) setOpen(false);
};

const placementRef = computed<Placement>(() => props.placement);
const openRef = computed(() => open.value);

const { floatingStyles, isPositioned } = useFloating(triggerRef, contentRef, {
  placement: placementRef,
  open: openRef,
  // Position via top/left (not transform) so the menu-show scale animation
  // does not clobber floating-ui's positioning transform.
  transform: false,
  middleware: [offset(4), flip({ padding: 8 }), shift({ padding: 8 })],
  whileElementsMounted: autoUpdate,
});

const handleClickOutside = (event: MouseEvent) => {
  if (!open.value) return;
  const t = event.target as Node;
  if (
    contentRef.value &&
    !contentRef.value.contains(t) &&
    triggerRef.value &&
    !triggerRef.value.contains(t)
  ) {
    setOpen(false);
  }
};

const handleKeydown = (event: KeyboardEvent) => {
  if (open.value && event.key === 'Escape') {
    setOpen(false);
  }
};

onMounted(() => {
  document.addEventListener('mousedown', handleClickOutside);
  document.addEventListener('keydown', handleKeydown);
});

onBeforeUnmount(() => {
  document.removeEventListener('mousedown', handleClickOutside);
  document.removeEventListener('keydown', handleKeydown);
});

const api: DropdownMenuApi = {
  get open() {
    return open.value;
  },
  setOpen,
  get closeOnSelect() {
    return props.closeOnSelect;
  },
  rootId,
  triggerRef,
  contentRef,
  floatingStyles,
  isPositioned,
  registerItem,
  onItemSelect,
  moveFocus,
  focusEdge,
};

provide(DropdownMenuContextKey, api);

const handleMonolithicSelect = (item: DropdownMenuItemModel) => {
  if (item.disabled) return;
  emit('select', item.value);
  onItemSelect(item.onSelect);
};
</script>

<template>
  <div class="menu-root">
    <slot :api="api" :open="open" />
  </div>
</template>

<!--
  NOT scoped: DropdownMenuTrigger/Content/Item are separate component instances
  (and Content teleports to body), so Vue's scoped styles would not reach them.
  Each rule is qualified by .menu-root / .menu-content to avoid bleeding into other components.
-->
<style >
.menu-root {
  display: inline-block;
}
.menu-root .trigger {
  all: unset;
  box-sizing: border-box;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
