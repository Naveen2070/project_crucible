{
  "Card.stories.tsx": "// Crucible preview examples for Card (React Native / StyleSheet).
// ponytail: Storybook for React Native isn't wired up in this release (needs Expo +
// @storybook/react-native) — these are ready-to-spread prop presets for manual/visual QA
// (e.g. \`<Card {...CardPreviews.default}>Card content</Card>\`), not a Storybook CSF file.
import type { CardProps } from './Card';

export const CardPreviews: Record<string, Omit<CardProps, 'children'>> = {
  default: { variant: 'default', title: 'Default Card' },
  hoverable: { variant: 'hoverable', title: 'Hoverable Card' },
  clickable: { variant: 'clickable', title: 'Clickable Card' },
  smSize: { size: 'sm', title: 'Sm Size' },
  mdSize: { size: 'md', title: 'Md Size' },
  lgSize: { size: 'lg', title: 'Lg Size' },
};
",
  "Card.tsx": "import React from 'react';
import { View, Text, Pressable, Linking, StyleSheet } from 'react-native';
import { theme } from '../../../theme';

// 'hoverable' has no touchscreen equivalent — same style as 'default' on RN, kept as a distinct
// variant only so switching \`variant\` doesn't require a framework-specific branch upstream.
const variantStyles: Record<string, object> = {
  default:   { backgroundColor: theme.colorSurface, borderColor: theme.colorBorder },
  hoverable: { backgroundColor: theme.colorSurface, borderColor: theme.colorBorder },
  clickable: { backgroundColor: theme.colorSurface, borderColor: theme.colorBorder },
};

const sizeStyles: Record<string, object> = {
  sm: { padding: 16 },
  md: { padding: 24 },
  lg: { padding: 32 },
};

const styles = StyleSheet.create({
  base: { borderRadius: Number.parseInt(theme.radiusLg, 10) || 12, borderWidth: 1 },
  pressed: { opacity: 0.8 },
  title: { fontWeight: '600', fontSize: 18, color: theme.foreground },
  flatTitle: { fontWeight: '700', fontSize: 18, marginBottom: 8, color: theme.foreground },
  description: { fontSize: 14, color: theme.colorTextMuted },
  header: { marginBottom: 16 },
  action: { flexDirection: 'row', alignItems: 'center', gap: 8, alignSelf: 'flex-end' },
  footer: { marginTop: 16, flexDirection: 'row', alignItems: 'center' },
});

export type CardVariant = 'default' | 'hoverable' | 'clickable';
export type CardSize    = 'sm' | 'md' | 'lg';

export interface CardProps {
  variant?: CardVariant;
  size?:    CardSize;
  title?:   string;
  children: React.ReactNode;
  onPress?: () => void;
  style?:   object;
  href?:    string;
}

export const CardRoot = ({ variant = 'default', size = 'md', children, onPress, style, href }: CardProps) => {
  const isClickable = variant === 'clickable' || !!onPress || !!href;
  const cardStyle = [styles.base, variantStyles[variant], sizeStyles[size], style];

  const handlePress = () => {
    onPress?.();
    if (href) Linking.openURL(href);
  };

  return isClickable ? (
    <Pressable
      style={({ pressed }) => [...cardStyle, pressed && styles.pressed]}
      onPress={handlePress}
      accessibilityRole="button"
    >
      {children}
    </Pressable>
  ) : (
    <View style={cardStyle}>{children}</View>
  );
};

export const CardHeader = ({ children, style }: { children: React.ReactNode; style?: object }) => (
  <View style={[styles.header, style]}>{children}</View>
);

export const CardTitle = ({ children, style }: { children: React.ReactNode; style?: object }) => (
  <Text style={[styles.title, style]}>{children}</Text>
);

export const CardDescription = ({ children, style }: { children: React.ReactNode; style?: object }) => (
  <Text style={[styles.description, style]}>{children}</Text>
);

export const CardAction = ({ children, style }: { children: React.ReactNode; style?: object }) => (
  <View style={[styles.action, style]}>{children}</View>
);

export const CardContent = ({ children, style }: { children: React.ReactNode; style?: object }) => (
  <View style={style}>{children}</View>
);

export const CardFooter = ({ children, style }: { children: React.ReactNode; style?: object }) => (
  <View style={[styles.footer, style]}>{children}</View>
);

export const Card = Object.assign(CardRoot, {
  Header: CardHeader,
  Title: CardTitle,
  Description: CardDescription,
  Action: CardAction,
  Content: CardContent,
  Footer: CardFooter,
}) as typeof CardRoot & {
  Header: typeof CardHeader;
  Title: typeof CardTitle;
  Description: typeof CardDescription;
  Action: typeof CardAction;
  Content: typeof CardContent;
  Footer: typeof CardFooter;
  displayName: string;
};

Card.displayName = 'Card';
",
  "README.md": "# Card

