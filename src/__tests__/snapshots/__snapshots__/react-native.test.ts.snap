_This file is auto-generated. Edit the source template or run \`crucible upgrade\` after updating your config._
",
  "Textarea.stories.tsx": "// Crucible preview examples for Textarea (React Native / NativeWind).
// ponytail: Storybook for React Native isn't wired up in this release (needs Expo +
// @storybook/react-native) — these are ready-to-spread prop presets for manual/visual QA
// (e.g. \`<Textarea {...TextareaPreviews.default} />\`), not a Storybook CSF file.
import type { TextareaProps } from './Textarea';

export const TextareaPreviews: Record<string, TextareaProps> = {
  default: { label: 'Default variant', variant: 'default' },
  error: { label: 'Error variant', variant: 'error', error: 'This field is required' },
  smSize: { label: 'Sm size', size: 'sm' },
  mdSize: { label: 'Md size', size: 'md' },
  lgSize: { label: 'Lg size', size: 'lg' },
  withHint: { label: 'Project brief', hint: 'Markdown is supported', placeholder: 'Describe the project…' },
  disabled: { label: 'Locked notes', editable: false, value: 'Read-only content' },
  required: { label: 'Release notes', required: true, placeholder: 'What changed?' },
};
",
  "Textarea.tsx": "import React, { useId } from 'react';
import { Text, TextInput, View, type TextInputProps } from 'react-native';

const variantClasses: Record<string, string> = {
  default: 'border-border text-foreground',
  error: 'border-destructive text-foreground',
 };
const sizeClasses: Record<string, string> = {
  sm: 'px-3 py-2 text-sm min-h-16',
  md: 'px-3 py-2 text-base min-h-[88px]',
  lg: 'px-4 py-3 text-lg min-h-[120px]',
};

export type TextareaVariant = 'default' | 'error';
export type TextareaSize    = 'sm' | 'md' | 'lg';

export interface TextareaProps extends TextInputProps {
  label?:      string;
  variant?:    TextareaVariant;
  size?:       TextareaSize;
  error?:      string;
  hint?:       string;
  required?:   boolean;
  /** ponytail: rows is a web layout hint — height comes from minHeight per size on mobile */
  rows?:       number;
  className?:  string;
}

// ponytail: aria-describedby/aria-invalid from the web version become visible hint/error
// text below the field plus error text folded into accessibilityLabel.
// Hoisted so Handlebars never parses an inline object literal as a helper.
const DISABLED_STATE = { disabled: true } as const;

export const Textarea = React.forwardRef<TextInput, TextareaProps>(
  ({ label, variant = 'default', size = 'md', error, hint, required, id: providedId, className, rows, multiline = true, editable, maxLength, ...props }, ref) => {
    const generatedId = useId();
    const id = providedId || generatedId;

    const cls = [
      'w-full rounded-md border bg-surface text-foreground',
      variantClasses[error ? 'error' : variant],
      sizeClasses[size],
      error && 'border-destructive',
      editable === false && 'opacity-60',
      className,
    ].filter(Boolean).join(' ');

    return (
      <View className="flex-col gap-1.5 w-full">
        {label && (
          <Text className="font-medium text-foreground text-sm">
            {label}
            {required && <Text className="text-destructive"> *</Text>}
          </Text>
        )}
        <TextInput
          ref={ref}
          nativeID={id}
          className={cls}
          multiline={multiline}
          textAlignVertical="top"
          maxLength={maxLength}
          editable={editable}
          accessibilityLabel={label ? (error ? \`\${label}. \${error}\` : label) : undefined}
          accessibilityState={editable === false ? DISABLED_STATE : undefined}
          {...props}
        />
        {hint && !error && <Text className="text-xs text-text-muted">{hint}</Text>}
        {error && <Text className="text-xs text-destructive" accessibilityRole="alert">{error}</Text>}
      </View>
    );
  }
);

Textarea.displayName = 'Textarea';
",
}
`;

