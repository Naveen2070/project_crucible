};

export const Circular: Story = {
  args: { variant: 'circular', value: 70, size: 'md', label: 'Loading 70%' },
  render: (args) => <Progress {...args} />,
};

export const CircularLoader: Story = {
  args: { variant: 'circular', indeterminate: true, size: 'md', label: 'Loading' },
  render: (args) => <Progress {...args} />,
};
"
`;

