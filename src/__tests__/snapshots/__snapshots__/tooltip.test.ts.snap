",
  "tooltip.component.css": ".tooltip-root {
  position: relative;
  display: inline-block;
}

.tooltip-trigger {
  cursor: pointer;
  display: inline-block;
}

.tooltip-content {
  position: absolute;
  z-index: var(--tooltip-z-index, 60);
  background: var(--tooltip-background, var(--color-surface));
  color: var(--tooltip-text, var(--color-text, #1A1A2E));
  border: 1px solid var(--tooltip-border, var(--color-border));
  border-radius: var(--tooltip-radius, var(--radius-md));
  box-shadow: var(
    --tooltip-shadow,
    0 4px 6px -1px rgba(0, 0, 0, 0.1),
    0 2px 4px -1px rgba(0, 0, 0, 0.06)
  );
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  line-height: 1.4;
  outline: none;
  pointer-events: none;
  max-width: 280px;
}

.tooltip-arrow {
  position: absolute;
  width: 8px;
  height: 8px;
  background: inherit;
  border: 1px solid transparent;
  transform: rotate(45deg);
}

.arrow-top {
  border-right-color: var(--tooltip-border, var(--color-border));
  border-bottom-color: var(--tooltip-border, var(--color-border));
}

.arrow-bottom {
  border-left-color: var(--tooltip-border, var(--color-border));
  border-top-color: var(--tooltip-border, var(--color-border));
}

.arrow-left {
  border-top-color: var(--tooltip-border, var(--color-border));
  border-right-color: var(--tooltip-border, var(--color-border));
}

.arrow-right {
  border-left-color: var(--tooltip-border, var(--color-border));
  border-bottom-color: var(--tooltip-border, var(--color-border));
}

/* Variants */
.variant-default {
  /* uses defaults above */
}

.variant-minimal {
  border: none;
  box-shadow:
    0 2px 4px -1px rgba(0, 0, 0, 0.08),
    0 1px 2px -1px rgba(0, 0, 0, 0.04);
}

/* Sizes */
.size-sm {
  font-size: 0.75rem;
  padding: 4px 8px;
}

.size-md {
  font-size: 0.8125rem;
  padding: 6px 10px;
}

.size-lg {
  font-size: 0.875rem;
  padding: 8px 12px;
}

/* Animation — gated on data-state so it only runs after positioning settles */
.tooltip-content[data-state='open'] {
  animation: tooltip-show 150ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tooltip-content[data-state='open'][data-side='top'] {
  animation-name: tooltip-slide-down;
}
.tooltip-content[data-state='open'][data-side='bottom'] {
  animation-name: tooltip-slide-up;
}
.tooltip-content[data-state='open'][data-side='left'] {
  animation-name: tooltip-slide-right;
}
.tooltip-content[data-state='open'][data-side='right'] {
  animation-name: tooltip-slide-left;
}

@keyframes tooltip-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes tooltip-slide-up {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tooltip-slide-down {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tooltip-slide-left {
  from {
    opacity: 0;
    transform: translateX(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes tooltip-slide-right {
  from {
    opacity: 0;
    transform: translateX(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .tooltip-content[data-state='open'] {
    animation: none;
  }
}
",
  "tooltip.component.html": "<div [class]="'tooltip-root ' + className" (mouseenter)="onMouseEnter()" (mouseleave)="onMouseLeave()">
  <div
    #triggerRef
    class="tooltip-trigger"
    (click)="toggle()"
    (focusin)="onFocus()"
    (focusout)="onBlur()"
    [attr.aria-describedby]="isOpen ? contentId : null"
  >
    <ng-content select="[trigger]">
      <button type="button" class="px-4 py-2 bg-primary text-primary-foreground rounded-md">
        Trigger
      </button>
    </ng-content>
  </div>

  @if (isOpen) {
    <div
      #contentRef
      [id]="contentId"
      [ngClass]="getContentClasses()"
      [style.visibility]="isPositioned ? 'visible' : 'hidden'"
      [attr.data-placement]="placement"
      [attr.data-side]="arrowSide"
      [attr.data-state]="isOpen && isPositioned ? 'open' : 'closed'"
      role="tooltip"
      (mouseenter)="onMouseEnter()"
      (mouseleave)="onMouseLeave()"
    >
      <ng-content></ng-content>

      @if (showArrow) {
        <div
          #arrowRef
          class="tooltip-arrow"
          [ngClass]="'arrow-' + arrowSide"
          aria-hidden="true"
        ></div>
      }
    </div>
  }
</div>
",
  "tooltip.component.ts": "import { Component, Input, Output, EventEmitter, HostListener, ElementRef, ViewChild, AfterViewInit, OnDestroy, Renderer2, Inject, PLATFORM_ID } from '@angular/core';
import { CommonModule, isPlatformBrowser } from '@angular/common';
import { computePosition, autoUpdate, offset, flip, shift, arrow, Placement } from '@floating-ui/dom';

let tooltipIdCounter = 0;

@Component({
  selector: 'app-tooltip',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './tooltip.component.html',
  styleUrls: ['./tooltip.component.css']
})
export class TooltipComponent implements AfterViewInit, OnDestroy {
  private _isOpen = false;
  private isViewInit = false;

  @Input()
  get isOpen(): boolean {
    return this._isOpen;
  }
  set isOpen(value: boolean) {
    const prev = this._isOpen;
    this._isOpen = value;
    if (prev !== value) {
      this.handleOpenStateChange(value);
    }
  }

  isPositioned = false;
  arrowSide = 'bottom';
  readonly contentId = \`tooltip-content-\${++tooltipIdCounter}\`;

  @Input() placement: 'top' | 'bottom' | 'left' | 'right' = 'top';
  @Input() alignment: 'start' | 'center' | 'end' = 'center';
  @Input() variant: 'default' | 'minimal' = 'default';
  @Input() size: 'sm' | 'md' | 'lg' = 'md';
  @Input() trigger: 'click' | 'hover' = 'hover';
  @Input() closeOnEscape = true;
  @Input() className = '';
  @Input() showArrow = true;

  @Output() isOpenChange = new EventEmitter<boolean>();

  @ViewChild('contentRef') contentRef?: ElementRef<HTMLElement>;
  @ViewChild('triggerRef') triggerRef?: ElementRef<HTMLElement>;
  @ViewChild('arrowRef') arrowRef?: ElementRef<HTMLElement>;

  private cleanupFloating?: () => void;
  private contentMoved = false;
  private closeTimeout?: any;

  constructor(
    private renderer: Renderer2,
    @Inject(PLATFORM_ID) private platformId: Object
  ) {}

  ngAfterViewInit() {
    this.isViewInit = true;
    if (this.isOpen) {
      this.initFloating();
    }
  }

  private handleOpenStateChange(isOpen: boolean) {
    if (!this.isViewInit) return;
    if (isOpen) {
      setTimeout(() => {
        this.initFloating();
      }, 0);
    } else {
      this.destroyFloating();
    }
  }

  ngOnDestroy() {
    this.destroyFloating();
    if (this.closeTimeout) {
      clearTimeout(this.closeTimeout);
    }
  }

  private initFloating() {
    if (!isPlatformBrowser(this.platformId)) return;
    if (!this.triggerRef?.nativeElement || !this.contentRef?.nativeElement) return;

    this.destroyFloating();

    const triggerEl = this.triggerRef.nativeElement;
    const contentEl = this.contentRef.nativeElement;

    if (!this.contentMoved) {
      this.renderer.appendChild(document.body, contentEl);
      this.contentMoved = true;
    }

    const floatingPlacement = \`\${this.placement}\${this.alignment === 'center' ? '' : '-' + this.alignment}\` as Placement;

    this.cleanupFloating = autoUpdate(triggerEl, contentEl, () => {
      const middleware = [
        offset(this.showArrow ? 12 : 8),
        flip(),
        shift({ padding: 8 }),
      ];

      if (this.showArrow && this.arrowRef) {
        middleware.push(arrow({ element: this.arrowRef.nativeElement }));
      }

      computePosition(triggerEl, contentEl, {
        placement: floatingPlacement,
        middleware,
      }).then(({ x, y, placement, middlewareData }) => {
        Object.assign(contentEl.style, {
          left: \`\${x}px\`,
          top: \`\${y}px\`,
          position: 'absolute',
          visibility: 'visible',
        });

        this.arrowSide = placement.split('-')[0];

        if (this.showArrow && this.arrowRef && middlewareData.arrow) {
          const { x: arrowX, y: arrowY } = middlewareData.arrow;
          const staticSide = {
            top: 'bottom',
            right: 'left',
            bottom: 'top',
            left: 'right',
          }[this.arrowSide];

          Object.assign(this.arrowRef.nativeElement.style, {
            left: arrowX != null ? \`\${arrowX}px\` : '',
            top: arrowY != null ? \`\${arrowY}px\` : '',
            right: '',
            bottom: '',
            [staticSide as string]: '-4px',
          });
        }

        this.isPositioned = true;
      });
    });
  }

  private destroyFloating() {
    if (this.cleanupFloating) {
      this.cleanupFloating();
      this.cleanupFloating = undefined;
    }

    if (this.contentMoved && this.contentRef?.nativeElement) {
      this.renderer.removeChild(document.body, this.contentRef.nativeElement);
      this.contentMoved = false;
    }

    this.isPositioned = false;
  }

  toggle() {
    if (this.trigger === 'click') {
      this.isOpen = !this.isOpen;
      this.isOpenChange.emit(this.isOpen);
    }
  }

  close() {
    this.isOpen = false;
    this.isOpenChange.emit(this.isOpen);
  }

  onMouseEnter() {
    if (this.trigger === 'hover') {
      if (this.closeTimeout) {
        clearTimeout(this.closeTimeout);
        this.closeTimeout = undefined;
      }
      this.isOpen = true;
      this.isOpenChange.emit(this.isOpen);
    }
  }

  onMouseLeave() {
    if (this.trigger === 'hover') {
      this.closeTimeout = setTimeout(() => {
        this.isOpen = false;
        this.isOpenChange.emit(this.isOpen);
      }, 150);
    }
  }

  // Keyboard parity: a focused trigger always reveals the tooltip (a11y).
  onFocus() {
    this.isOpen = true;
    this.isOpenChange.emit(this.isOpen);
  }

  onBlur() {
    this.isOpen = false;
    this.isOpenChange.emit(this.isOpen);
  }

  @HostListener('document:keydown', ['$event'])
  handleDocumentKeydown(event: KeyboardEvent) {
    if (!this.isOpen) return;
    if (this.closeOnEscape && event.key === 'Escape') {
      this.close();
    }
  }

  getContentClasses() {
    return {
      'tooltip-content': true,
      ['variant-' + this.variant]: true,
      ['size-' + this.size]: true,
      [this.className]: !!this.className,
    };
  }
}
",
}
`;

