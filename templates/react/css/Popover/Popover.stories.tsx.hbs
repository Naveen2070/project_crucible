export const AllPlacements: Story = {
  parameters: { layout: 'centered' },
  decorators: [
    (Story) => (
      <div style=\{{ minHeight: '480px', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '80px' }}>
        <Story />
      </div>
    ),
  ],
  render: (args) => {
    const sides = ['top', 'bottom', 'left', 'right'] as const;
    const alignments = ['start', 'center', 'end'] as const;
    const placements = sides.flatMap((side) =>
      alignments.map((alignment) => ({
        placement: (alignment === 'center' ? side : `${side}-${alignment}`) as any,
        label: `${side}-${alignment}`,
      }))
    );
    return (
      <div style=\{{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '16px' }}>
        {placements.map((p) => (
          <Popover.Root key={p.label} {...args} placement={p.placement}>
            <Popover.Trigger asChild>
              <Button size="sm" variant="outline">{p.label}</Button>
            </Popover.Trigger>
            <Popover.Portal>
              <Popover.Content size="sm">
                <p style=\{{ margin: 0, fontSize: '0.8125rem' }}>
                  Placement: <strong>{p.label}</strong>
                </p>
                <Popover.Arrow />
              </Popover.Content>
            </Popover.Portal>
          </Popover.Root>
        ))}
      </div>
    );
  },
};

export const VariantsAndSizes: Story = {
  render: (args) => {
    const variants = ['default', 'minimal'] as const;
    const sizes = ['sm', 'md', 'lg'] as const;
    const cells = variants.flatMap((variant) =>
      sizes.map((size) => ({ variant, size, label: `${variant} / ${size}` }))
    );
    return (
      <div style=\{{ display: 'grid', gridTemplateColumns: 'repeat(3, auto)', gap: '24px', alignItems: 'center', justifyItems: 'center' }}>
        {cells.map((cell) => (
          <Popover.Root key={cell.label} {...args}>
            <Popover.Trigger asChild>
              <Button size={cell.size}>{cell.label}</Button>
            </Popover.Trigger>
            <Popover.Portal>
              <Popover.Content size={cell.size} variant={cell.variant}>
                <div style=\{{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
                  <strong style=\{{ fontSize: '0.875rem' }}>{cell.variant} · {cell.size}</strong>
                  <p style=\{{ margin: 0, fontSize: 'inherit', color: 'var(--color-text-muted, #6B6B8A)' }}>
                    Body text scales with the size token.
                  </p>
                </div>
                <Popover.Arrow />
              </Popover.Content>
            </Popover.Portal>
          </Popover.Root>
        ))}
      </div>
    );
  },
};

export const Controlled: Story = {
  render: function ControlledStory(args) {
    const [open, setOpen] = React.useState(false);
    return (
      <div style=\{{ display: 'flex', flexDirection: 'column', gap: '20px', alignItems: 'center' }}>
        <Button variant="ghost" onClick={() => setOpen(!open)}>
          External toggle &mdash; currently {open ? 'open' : 'closed'}
        </Button>

        <Popover.Root {...args} open={open} onOpenChange={setOpen}>
          <Popover.Trigger asChild>
            <Button variant="outline">Popover Trigger</Button>
          </Popover.Trigger>
          <Popover.Portal>
            <Popover.Content>
              <div style=\{{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                <p style=\{{ margin: 0, fontSize: '0.875rem' }}>
                  This popover's open state is controlled by the parent component.
                </p>
                <Button size="sm" onClick={() => setOpen(false)}>Close from inside</Button>
              </div>
              <Popover.Arrow />
            </Popover.Content>
          </Popover.Portal>
        </Popover.Root>
      </div>
    );
  },
};

