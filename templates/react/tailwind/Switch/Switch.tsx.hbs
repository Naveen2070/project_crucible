import React, { useId, useState } from 'react';

export type SwitchSize = {{> shared/size-types}};

export interface SwitchProps extends Omit<React.ButtonHTMLAttributes<HTMLButtonElement>, 'onChange' | 'type'> {
  /** Controlled checked state */
  checked?: boolean;
  /** Initial checked state when uncontrolled */
  defaultChecked?: boolean;
  /** Called with the next checked value on toggle */
  onCheckedChange?: (checked: boolean) => void;
  label?: string;
  size?: SwitchSize;
}

const TRACK_CLASSES: Record<SwitchSize, string> = {
  sm: 'w-8 h-[18px]',
  md: 'w-10 h-[22px]',
  lg: 'w-12 h-[26px]',
};

const THUMB_CLASSES: Record<SwitchSize, string> = {
  sm: 'w-3.5 h-3.5',
  md: 'w-[18px] h-[18px]',
  lg: 'w-[22px] h-[22px]',
};

const THUMB_TRANSLATE: Record<SwitchSize, string> = {
  sm: 'translate-x-[14px]',
  md: 'translate-x-[18px]',
  lg: 'translate-x-[22px]',
};

export const Switch = React.forwardRef<HTMLButtonElement, SwitchProps>(
  (
    { checked: controlled, defaultChecked = false, onCheckedChange, label, size = 'md', id: providedId, className, disabled, ...props },
    ref
  ) => {
    const generatedId = useId();
    const id = providedId || generatedId;
    const [uncontrolled, setUncontrolled] = useState(defaultChecked);
    const checked = controlled ?? uncontrolled;

    const toggle = () => {
      if (disabled) return;
      const next = !checked;
      if (controlled === undefined) setUncontrolled(next);
      onCheckedChange?.(next);
    };

    const trackCls = [
      'relative inline-flex items-center shrink-0 p-0 border-none rounded-full cursor-pointer transition-colors',
      'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]',
      'disabled:opacity-60 disabled:cursor-not-allowed',
      checked ? 'bg-[var(--switch-track-on,var(--color-primary))]' : 'bg-[var(--switch-track-off,var(--color-secondary))]',
      TRACK_CLASSES[size],
      className || '',
    ].filter(Boolean).join(' ');

    const thumbCls = [
      'absolute left-0.5 rounded-full bg-[var(--switch-thumb,#fff)] shadow transition-transform',
      THUMB_CLASSES[size],
      checked ? THUMB_TRANSLATE[size] : 'translate-x-0',
    ].join(' ');

    return (
      <span className="inline-flex items-center gap-2">
        <button
          ref={ref}
          type="button"
          role="switch"
          id={id}
          aria-checked={checked}
          aria-label={!label ? props['aria-label'] : label}
          disabled={disabled}
          onClick={toggle}
          className={trackCls}
          {...props}
        >
          <span className={thumbCls} aria-hidden="true" />
        </button>
        {label && (
          <label htmlFor={id} className="text-sm text-[var(--color-text)] cursor-pointer select-none">
            {label}
          </label>
        )}
      </span>
    );
  }
);

Switch.displayName = 'Switch';
