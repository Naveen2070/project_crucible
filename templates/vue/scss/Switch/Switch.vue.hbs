<script setup lang="ts">
import { computed{{#if vueUseId}}, useId{{else}}, getCurrentInstance{{/if}} } from 'vue';

export type SwitchSize = {{> shared/size-types}};

interface Props {
  id?:         string;
  modelValue?: boolean;
  label?:      string;
  size?:       SwitchSize;
  disabled?:   boolean;
}

const props = withDefaults(defineProps<Props>(), {
  id: '',
  modelValue: false,
  label: '',
  size: 'md',
  disabled: false,
});

const emit = defineEmits(['update:modelValue']);

const generatedId = {{#if vueUseId}}`switch-${useId()}`{{else}}`switch-${getCurrentInstance()?.uid ?? 0}`{{/if}};
const switchId = computed(() => props.id || generatedId);

const toggle = () => {
  if (props.disabled) return;
  emit('update:modelValue', !props.modelValue);
};
</script>

<template>
  <span class="switch-wrapper">
    <button
      type="button"
      role="switch"
      :id="switchId"
      :aria-checked="modelValue"
      :aria-label="label || undefined"
      :disabled="disabled"
      :class="['switch', `switch--${size}`, { 'switch--checked': modelValue }]"
      @click="toggle"
    >
      <span class="thumb" aria-hidden="true" />
    </button>
    <label v-if="label" :for="switchId" class="label">\{{ label }}</label>
  </span>
</template>

