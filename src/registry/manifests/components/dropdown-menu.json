{
  "id": "DropdownMenu",
  "name": "DropdownMenu",
  "description": "Dropdown menu with floating-ui positioning, roving menu items, and typeahead",
  "frameworks": ["react", "vue", "angular"],
  "styleSystems": ["css", "tailwind", "scss"],
  "variants": ["default", "minimal"],
  "sizes": ["sm", "md", "lg"],
  "states": ["open", "closed"],
  "props": ["open", "onOpenChange", "placement", "trigger", "closeOnSelect"],
  "prefix": "menu",
  "a11y": { "role": "menu", "keyboardNav": true },
  "dependencies": ["Button"],
  "peerDependencies": {
    "react": ["@floating-ui/react"],
    "vue": ["@floating-ui/vue"],
    "angular": ["@floating-ui/dom"]
  },
  "tailwindDefaults": {
    "default": "bg-[var(--color-surface)] border border-[var(--color-border)] shadow-lg",
    "minimal": "bg-[var(--color-surface)] shadow-md"
  }
}
