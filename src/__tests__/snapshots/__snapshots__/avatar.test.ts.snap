exports[`Avatar snapshots > react tailwind mode snapshot 1`] = `
"import React, { useState } from 'react';

export type AvatarVariant = 'circle' | 'square';
export type AvatarSize    = 'xs' | 'sm' | 'md' | 'lg';

export interface AvatarProps extends React.HTMLAttributes<HTMLDivElement> {
  /** Image source; falls back to initials when missing or failed to load */
  src?: string;
  /** Accessible label and image alt text */
  alt?: string;
  /** Explicit fallback text (defaults to initials derived from alt) */
  fallback?: string;
  /** Shape of the avatar */
  variant?: AvatarVariant;
  /** Size of the avatar */
  size?: AvatarSize;
}

const SHAPE_CLASSES: Record<AvatarVariant, string> = {
  circle: 'rounded-full',
  square: 'rounded-[var(--avatar-radius,var(--radius-md))]',
};

const SIZE_CLASSES: Record<AvatarSize, string> = {
  xs: 'w-6 h-6 text-[0.625rem]',
  sm: 'w-8 h-8 text-xs',
  md: 'w-10 h-10 text-sm',
  lg: 'w-14 h-14 text-lg',
};

export const Avatar = React.forwardRef<HTMLDivElement, AvatarProps>(
  ({ src, alt = '', fallback, variant = 'circle', size = 'md', className, ...props }, ref) => {
    const [errored, setErrored] = useState(false);
    const showImage = Boolean(src) && !errored;
    const initials = (fallback ?? alt ?? '').trim().slice(0, 2).toUpperCase();

    const cls = [
      'inline-flex items-center justify-center shrink-0 overflow-hidden select-none font-semibold leading-none',
      'bg-[var(--avatar-fallback-bg,var(--color-secondary))] text-[var(--avatar-fallback-color,var(--color-text))]',
      SHAPE_CLASSES[variant],
      SIZE_CLASSES[size],
      className || '',
    ].filter(Boolean).join(' ');

    return (
      <div ref={ref} className={cls} role="img" aria-label={alt || fallback || undefined} {...props}>
        {showImage ? (
          <img
            className="w-full h-full object-cover"
            src={src}
            alt={alt}
            onError={() => setErrored(true)}
          />
        ) : (
          <span aria-hidden="true">{initials}</span>
        )}
      </div>
    );
  }
);

Avatar.displayName = 'Avatar';
"
`;

exports[`Avatar snapshots > vue css mode snapshot 1`] = `
"<script setup lang="ts">
import { ref, computed } from 'vue';

export type AvatarVariant = 'circle' | 'square';
export type AvatarSize    = 'xs' | 'sm' | 'md' | 'lg';

interface Props {
  src?:      string;
  alt?:      string;
  fallback?: string;
  variant?:  AvatarVariant;
  size?:     AvatarSize;
}

const props = withDefaults(defineProps<Props>(), {
  src: '',
  alt: '',
  fallback: '',
  variant: 'circle',
  size: 'md',
});

const errored = ref(false);
const showImage = computed(() => Boolean(props.src) && !errored.value);
const initials = computed(() => (props.fallback || props.alt || '').trim().slice(0, 2).toUpperCase());
</script>

<template>
  <div
    :class="['avatar', \`avatar--\${variant}\`, \`avatar--\${size}\`]"
    role="img"
    :aria-label="alt || fallback || undefined"
  >
    <img
      v-if="showImage"
      class="avatar-image"
      :src="src"
      :alt="alt"
      @error="errored = true"
    />
    <span v-else class="avatar-fallback" aria-hidden="true">{{ initials }}</span>
  </div>
</template>

<style scoped>
