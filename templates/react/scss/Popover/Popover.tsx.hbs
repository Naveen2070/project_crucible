import React, { 
  createContext, 
  useContext, 
  useState, 
  useMemo, 
  useCallback 
} from 'react';
import {
  useFloating,
  autoUpdate,
  offset,
  flip,
  shift,
  useClick,
  useHover,
  useDismiss,
  useRole,
  useInteractions,
  safePolygon,
  Placement,
  FloatingFocusManager,
  FloatingPortal,
  FloatingArrow,
  arrow,
  useMergeRefs,
  limitShift,
} from '@floating-ui/react';
{{> react/styles-import}}

export interface PopoverOptions {
  initialOpen?: boolean;
  placement?: Placement;
  modal?: boolean;
  open?: boolean;
  onOpenChange?: (open: boolean) => void;
  trigger?: 'click' | 'hover';
  offset?: number;
}

export function usePopover({
  initialOpen = false,
  placement = 'bottom',
  modal = false,
  open: controlledOpen,
  onOpenChange: setControlledOpen,
  trigger = 'click',
  offset: offsetValue = 8,
}: PopoverOptions = {}) {
  const [uncontrolledOpen, setUncontrolledOpen] = useState(initialOpen);
  const [arrowElement, setArrowElement] = useState<SVGSVGElement | null>(null);

  const open = controlledOpen ?? uncontrolledOpen;
  const setOpen = useCallback(
    (open: boolean) => {
      if (controlledOpen === undefined) {
        setUncontrolledOpen(open);
      }
      setControlledOpen?.(open);
    },
    [controlledOpen, setControlledOpen]
  );

  const data = useFloating({
    placement,
    open,
    onOpenChange: setOpen,
    whileElementsMounted: autoUpdate,
    middleware: [
      offset(offsetValue),
      flip({
        fallbackAxisSideDirection: 'end',
        padding: 5,
      }),
      shift({ padding: 5, limiter: limitShift() }),
      arrow({
        element: arrowElement,
      }),
    ],
  });

  const context = data.context;

  const click = useClick(context, {
    enabled: trigger === 'click',
  });
  const hover = useHover(context, {
    enabled: trigger === 'hover',
    handleClose: safePolygon(),
  });
  const dismiss = useDismiss(context);
  const role = useRole(context);

  const interactions = useInteractions([click, hover, dismiss, role]);

  return useMemo(
    () => ({
      open,
      setOpen,
      ...interactions,
      ...data,
      modal,
      arrowElement,
      setArrowElement,
    }),
    [open, setOpen, interactions, data, modal, arrowElement]
  );
}

type ContextType = ReturnType<typeof usePopover> | null;

const PopoverContext = createContext<ContextType>(null);

const usePopoverContext = () => {
  const context = useContext(PopoverContext);
  if (context == null) {
    throw new Error("Popover components must be wrapped in <Popover.Root />");
  }
  return context;
};

/**
 * Internal Popover Components
 */
const InternalRoot = ({
  children,
  ...options
}: {
  children: React.ReactNode;
} & PopoverOptions) => {
  const popover = usePopover(options);
  return (
    <PopoverContext.Provider value={popover}>
      {children}
    </PopoverContext.Provider>
  );
};

const InternalTrigger = React.forwardRef<
  HTMLElement,
  React.HTMLProps<HTMLElement> & { asChild?: boolean }
>(function PopoverTrigger({ children, asChild = false, ...props }, propRef) {
  const context = usePopoverContext();
  const childrenRef = (children as any).ref;
  const ref = useMergeRefs([context.refs.setReference, propRef, childrenRef]);

  if (asChild && React.isValidElement(children)) {
    return React.cloneElement(
      children,
      context.getReferenceProps({
        ref,
        ...props,
        ...children.props,
        "data-state": context.open ? "open" : "closed",
      })
    );
  }

  return (
    <button
      ref={ref}
      type="button"
      className={styles.trigger}
      data-state={context.open ? "open" : "closed"}
      {...context.getReferenceProps(props)}
    >
      {children}
    </button>
  );
});

const InternalPortal = ({ children }: { children: React.ReactNode }) => (
  <FloatingPortal>{children}</FloatingPortal>
);

const InternalContent = React.forwardRef<
  HTMLDivElement,
  React.HTMLProps<HTMLDivElement>
>(function PopoverContent({ style, className, children, ...props }, propRef) {
  const { context: floatingContext, isPositioned, ...context } = usePopoverContext();
  const ref = useMergeRefs([context.refs.setFloating, propRef]);

  if (!floatingContext.open) return null;

  return (
    <FloatingFocusManager context={floatingContext} modal={context.modal}>
      <div
        ref={ref}
        style=\{{
          position: floatingContext.strategy,
          top: floatingContext.y ?? 0,
          left: floatingContext.x ?? 0,
          width: 'max-content',
          visibility: isPositioned ? 'visible' : 'hidden',
          ...style,
        }}
        className={`${styles.content} ${className || ''}`}
        data-state={context.open && isPositioned ? "open" : "closed"}
        data-placement={floatingContext.placement}
        {...context.getFloatingProps(props)}
      >
        {children}
      </div>
    </FloatingFocusManager>
  );
});

const InternalArrow = React.forwardRef<
  SVGSVGElement,
  React.SVGProps<SVGSVGElement>
>(function PopoverArrow(props, propRef) {
  const { context: floatingContext, setArrowElement } = usePopoverContext();
  const ref = useMergeRefs([setArrowElement, propRef]);

  return (
    <FloatingArrow
      ref={ref}
      context={floatingContext}
      fill="white"
      stroke="var(--popover-border)"
      strokeWidth={1}
      {...props}
    />
  );
});

const InternalClose = React.forwardRef<
  HTMLButtonElement,
  React.ButtonHTMLAttributes<HTMLButtonElement>
>(function PopoverClose(props, ref) {
  const { setOpen } = usePopoverContext();
  return (
    <button
      type="button"
      ref={ref}
      {...props}
      onClick={(event) => {
        props.onClick?.(event);
        setOpen(false);
      }}
    />
  );
});

{{#if features.compoundComponents}}
export const PopoverRoot = InternalRoot;
export const PopoverTrigger = InternalTrigger;
export const PopoverPortal = InternalPortal;
export const PopoverContent = InternalContent;
export const PopoverArrow = InternalArrow;
export const PopoverClose = InternalClose;

/**
 * Popover - Main export with compound components
 */
export const Popover = Object.assign(PopoverRoot, {
  Root: PopoverRoot,
  Trigger: PopoverTrigger,
  Portal: PopoverPortal,
  Content: PopoverContent,
  Arrow: PopoverArrow,
  Close: PopoverClose,
});
{{else}}
/**
 * Popover - Monolithic wrapper for the compound components
 */
export const Popover: React.FC<PopoverOptions & { children: React.ReactNode }> = ({
  children,
  ...options
}) => {
  const childrenArray = React.Children.toArray(children);
  const trigger = childrenArray[0];
  const content = childrenArray.slice(1);

  return (
    <InternalRoot {...options}>
      <InternalTrigger asChild>{trigger}</InternalTrigger>
      <InternalPortal>
        <InternalContent>
          {content}
        </InternalContent>
      </InternalPortal>
    </InternalRoot>
  );
};
{{/if}}

export default Popover;
