import { Meta, StoryObj } from '@storybook/angular';
import { AlertComponent } from './alert.component';

const meta: Meta<AlertComponent> = {
  title: 'Crucible/Alert',
  component: AlertComponent,
  tags: ['autodocs'],
  argTypes: {
    variant:   { control: 'select', options: {{> shared/variant-options}} },
    title:     { control: 'text' },
    closeable: { control: 'boolean' },
  },
};

export default meta;
type Story = StoryObj<AlertComponent>;

export const Default: Story = {
  args: { variant: 'default', title: 'Heads up' },
  render: (args) => ({
    props: args,
    template: `<app-alert [variant]="variant" [title]="title" [closeable]="closeable">This is a general message for your attention.</app-alert>`,
  }),
};

{{#each variants}}
{{#unless (eq this "default")}}
export const {{capitalize this}}: Story = {
  args: { variant: '{{this}}', title: '{{capitalize this}}' },
  render: (args) => ({
    props: args,
    template: `<app-alert [variant]="variant" [title]="title" [closeable]="closeable">This is a {{this}} alert message.</app-alert>`,
  }),
};
{{/unless}}
{{/each}}

export const Closeable: Story = {
  args: { variant: 'info', title: 'Dismissible', closeable: true },
  render: (args) => ({
    props: args,
    template: `<app-alert [variant]="variant" [title]="title" [closeable]="closeable">Click the × to dismiss this alert.</app-alert>`,
  }),
};
