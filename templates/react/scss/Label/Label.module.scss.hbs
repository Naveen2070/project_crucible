.label {
  display: inline-flex;
  align-items: center;
  gap: var(--label-gap, {{tokens.componentTokens.label.gap}});
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  font-weight: var(--label-weight, {{tokens.componentTokens.label.weight}});
  color: var(--label-color, {{tokens.componentTokens.label.color}});
  line-height: 1.4;
  cursor: default;

  &--sm {
    font-size: 0.75rem;
  }

  &--md {
    font-size: 0.875rem;
  }

  &--lg {
    font-size: 1rem;
  }

  &--disabled {
    opacity: var(--label-disabled-opacity, {{tokens.componentTokens.label.disabledOpacity}});
    cursor: not-allowed;
  }
}

.required {
  color: var(--label-required-color, {{tokens.componentTokens.label.requiredColor}});
  margin-left: calc(var(--spacing-unit, 4px) * 0.5);
}
