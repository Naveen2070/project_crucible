import {
  Component,
  Input,
  OnDestroy,
  OnInit,
  computed,
  signal,
  effect,
  HostListener,
  type Signal,
} from '@angular/core';
import { CommonModule } from '@angular/common';

// ===== Types =====
export type ToastVariant = 'default' | 'success' | 'error' | 'warning' | 'info' | 'loading';
export type ToastPosition =
  | 'top-left'
  | 'top-center'
  | 'top-right'
  | 'bottom-left'
  | 'bottom-center'
  | 'bottom-right';

export interface ToastAction {
  label: string;
  onClick: (event: MouseEvent) => void;
}

export interface ToastOptions {
  id?: string | number;
  description?: string;
  duration?: number;
  variant?: ToastVariant;
  action?: ToastAction;
  onDismiss?: (id: string | number) => void;
  onAutoClose?: (id: string | number) => void;
  className?: string;
}

export interface ToastData extends ToastOptions {
  id: string | number;
  message: string;
  variant: ToastVariant;
  createdAt: number;
}

// ===== Module-level signal store =====
let nextId = 1;
export const toastsSignal = signal<ToastData[]>([]);

function upsert(
  partial: Partial<ToastOptions> & { message: string; variant: ToastVariant },
): string | number {
  const id = partial.id ?? nextId++;
  const list = toastsSignal();
  const idx = list.findIndex((t) => t.id === id);
  if (idx >= 0) {
    const merged: ToastData = { ...list[idx], ...partial, id };
    toastsSignal.set(list.map((t, i) => (i === idx ? merged : t)));
  } else {
    toastsSignal.set([...list, { id, createdAt: Date.now(), ...partial } as ToastData]);
  }
  return id;
}

export function removeToast(id: string | number) {
  toastsSignal.set(toastsSignal().filter((t) => t.id !== id));
}

function dismissImpl(id?: string | number) {
  if (id == null) {
    toastsSignal().forEach((t) => t.onDismiss?.(t.id));
    toastsSignal.set([]);
    return;
  }
  const t = toastsSignal().find((x) => x.id === id);
  if (!t) return;
  t.onDismiss?.(t.id);
  removeToast(id);
}

// ===== Public toast() function =====
interface ToastFunction {
  (message: string, options?: ToastOptions): string | number;
  success: (m: string, o?: ToastOptions) => string | number;
  error: (m: string, o?: ToastOptions) => string | number;
  warning: (m: string, o?: ToastOptions) => string | number;
  info: (m: string, o?: ToastOptions) => string | number;
  loading: (m: string, o?: ToastOptions) => string | number;
  custom: (m: string, o?: ToastOptions) => string | number;
  dismiss: (id?: string | number) => void;
  promise: <T>(
    p: Promise<T>,
    msgs: {
      loading: string;
      success: string | ((v: T) => string);
      error: string | ((e: unknown) => string);
    },
    options?: ToastOptions,
  ) => string | number;
}

const toastFn = ((message: string, options: ToastOptions = {}) =>
  upsert({ ...options, message, variant: options.variant ?? 'default' })) as ToastFunction;

toastFn.success = (m, o) => upsert({ ...o, message: m, variant: 'success' });
toastFn.error = (m, o) => upsert({ ...o, message: m, variant: 'error' });
toastFn.warning = (m, o) => upsert({ ...o, message: m, variant: 'warning' });
toastFn.info = (m, o) => upsert({ ...o, message: m, variant: 'info' });
toastFn.loading = (m, o) =>
  upsert({ ...o, message: m, variant: 'loading', duration: o?.duration ?? Infinity });
toastFn.custom = (m, o) => upsert({ ...o, message: m, variant: o?.variant ?? 'default' });
toastFn.dismiss = dismissImpl;
toastFn.promise = (p, msgs, options) => {
  const id = upsert({ ...options, message: msgs.loading, variant: 'loading', duration: Infinity });
  p.then((v) =>
    upsert({
      id,
      message: typeof msgs.success === 'function' ? msgs.success(v) : msgs.success,
      variant: 'success',
      duration: options?.duration,
    }),
  ).catch((err) =>
    upsert({
      id,
      message: typeof msgs.error === 'function' ? msgs.error(err) : msgs.error,
      variant: 'error',
      duration: options?.duration,
    }),
  );
  return id;
};

export const toast = toastFn;

// ===== Default-icon SVG path lookup =====
const ICON_PATHS: Record<string, string> = {
  success: 'M20 6L9 17l-5-5',
  error: 'M18 6L6 18M6 6l12 12',
  warning:
    'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
  info: 'M12 16v-4m0-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};

interface TimerEntry {
  timer: number | null;
  remaining: number;
  startedAt: number;
  dismissed: boolean;
  state: 'enter' | 'visible' | 'exit';
}

@Component({
  selector: 'app-toaster',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './toast.component.html',
  styleUrls: ['./toast.component.css'],
})
export class ToasterComponent implements OnInit, OnDestroy {
  @Input() position: ToastPosition = 'bottom-right';
  @Input() duration = 4000;
  @Input() maxToasts = 5;
  @Input() richColors = false;
  @Input() closeButton = false;
  @Input() pauseWhenPageIsHidden = true;
  @Input() className = '';

  readonly toasts: Signal<ToastData[]> = toastsSignal.asReadonly();

  readonly visibleToasts = computed(() => {
    const all = this.toasts();
    return all.length > this.maxToasts ? all.slice(all.length - this.maxToasts) : all;
  });

  readonly positionSide = computed(() => (this.position.startsWith('top') ? 'top' : 'bottom'));

  private timers = new Map<string | number, TimerEntry>();
  private timerVersion = signal(0);

  constructor() {
    // Auto-drop overflow when maxToasts exceeded
    effect(() => {
      const list = this.toasts();
      if (list.length > this.maxToasts) {
        const overflow = list.length - this.maxToasts;
        list.slice(0, overflow).forEach((t) => removeToast(t.id));
      }
      // Schedule new toasts
      this.visibleToasts().forEach((t) => {
        if (!this.timers.has(t.id)) this.scheduleAutoClose(t);
      });
    });
  }

  ngOnInit() {
    if (this.pauseWhenPageIsHidden) {
      document.addEventListener('visibilitychange', this.onVisibility);
    }
  }

  ngOnDestroy() {
    document.removeEventListener('visibilitychange', this.onVisibility);
    this.timers.forEach((e) => {
      if (e.timer) window.clearTimeout(e.timer);
    });
  }

  private onVisibility = () => {
    if (document.visibilityState === 'hidden') {
      this.visibleToasts().forEach((t) => this.pause(t.id));
    } else {
      this.visibleToasts().forEach((t) => this.resume(t));
    }
  };

  private getEntry(id: string | number, duration: number): TimerEntry {
    let entry = this.timers.get(id);
    if (!entry) {
      entry = {
        timer: null,
        remaining: duration,
        startedAt: Date.now(),
        dismissed: false,
        state: 'enter',
      };
      this.timers.set(id, entry);
      requestAnimationFrame(() => {
        const e = this.timers.get(id);
        if (e) e.state = 'visible';
        this.timerVersion.update((v) => v + 1);
      });
    }
    return entry;
  }

  private clearTimer(id: string | number) {
    const e = this.timers.get(id);
    if (e?.timer) {
      window.clearTimeout(e.timer);
      e.timer = null;
    }
  }

  scheduleAutoClose(t: ToastData) {
    const duration = t.duration ?? this.duration;
    if (duration === Infinity) return;
    const e = this.getEntry(t.id, duration);
    if (e.dismissed) return;
    e.startedAt = Date.now();
    this.clearTimer(t.id);
    e.timer = window.setTimeout(() => this.handleAutoClose(t), e.remaining);
  }

  pause(id: string | number) {
    const e = this.timers.get(id);
    if (!e || !e.timer) return;
    window.clearTimeout(e.timer);
    e.timer = null;
    e.remaining = Math.max(0, e.remaining - (Date.now() - e.startedAt));
  }

  resume(t: ToastData) {
    this.scheduleAutoClose(t);
  }

  handleDismiss(t: ToastData) {
    const e = this.getEntry(t.id, t.duration ?? this.duration);
    if (e.dismissed) return;
    e.dismissed = true;
    this.clearTimer(t.id);
    e.state = 'exit';
    this.timerVersion.update((v) => v + 1);
    window.setTimeout(() => {
      t.onDismiss?.(t.id);
      removeToast(t.id);
      this.timers.delete(t.id);
    }, 150);
  }

  private handleAutoClose(t: ToastData) {
    const e = this.timers.get(t.id);
    if (!e || e.dismissed) return;
    e.dismissed = true;
    this.clearTimer(t.id);
    e.state = 'exit';
    this.timerVersion.update((v) => v + 1);
    window.setTimeout(() => {
      t.onAutoClose?.(t.id);
      removeToast(t.id);
      this.timers.delete(t.id);
    }, 150);
  }

  getStateAttr(id: string | number): string {
    // Read timerVersion to subscribe to mutations
    this.timerVersion();
    return this.timers.get(id)?.state ?? 'enter';
  }

  toastClasses(t: ToastData): string {
    return ['toast', `toast--${t.variant}`, t.className].filter(Boolean).join(' ');
  }

  wrapperClasses(): string {
    return [
      'toaster',
      `toaster--${this.position}`,
      this.richColors ? 'toaster--rich' : '',
      this.className,
    ]
      .filter(Boolean)
      .join(' ');
  }

  shouldShowIcon(t: ToastData): boolean {
    return t.variant !== 'default';
  }

  iconPath(variant: ToastVariant): string | null {
    return ICON_PATHS[variant] ?? null;
  }

  actionClick(t: ToastData, event: MouseEvent) {
    t.action?.onClick(event);
    this.handleDismiss(t);
  }

  trackById(_index: number, t: ToastData): string | number {
    return t.id;
  }

  ariaRole(t: ToastData): string {
    return t.variant === 'error' ? 'alert' : 'status';
  }

  ariaLive(t: ToastData): 'assertive' | 'polite' {
    return t.variant === 'error' ? 'assertive' : 'polite';
  }
}
