import type { Meta, StoryObj } from '@storybook/vue3';
import Alert from './Alert.vue';

const meta: Meta<typeof Alert> = {
  title: 'Crucible/{{name}}',
  component: Alert,
  tags: ['autodocs'],
  argTypes: {
    variant:   { control: 'select', options: {{> shared/variant-options}} },
    title:     { control: 'text' },
    closeable: { control: 'boolean' },
  },
};

export default meta;
type Story = StoryObj<typeof Alert>;

export const Default: Story = {
  args: { variant: 'default', title: 'Heads up' },
  render: (args) => ({
    components: { Alert },
    setup() {
      return { args };
    },
    template: `<Alert v-bind="args">This is a general message for your attention.</Alert>`,
  }),
};

{{#each variants}}
{{#unless (eq this "default")}}
export const {{capitalize this}}: Story = {
  args: { variant: '{{this}}', title: '{{capitalize this}}' },
  render: (args) => ({
    components: { Alert },
    setup() {
      return { args };
    },
    template: `<Alert v-bind="args">This is a {{this}} alert message.</Alert>`,
  }),
};
{{/unless}}
{{/each}}

export const Closeable: Story = {
  args: { variant: 'info', title: 'Dismissible', closeable: true },
  render: (args) => ({
    components: { Alert },
    setup() {
      return { args };
    },
    template: `<Alert v-bind="args">Click the × to dismiss this alert.</Alert>`,
  }),
};
