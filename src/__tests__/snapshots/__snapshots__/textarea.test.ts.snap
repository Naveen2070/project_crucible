exports[`Textarea snapshots > react tailwind mode snapshot 1`] = `
"import React, { useId } from 'react';

export type TextareaVariant = 'default' | 'error';
export type TextareaSize    = 'sm' | 'md' | 'lg';

export interface TextareaProps extends Omit<React.TextareaHTMLAttributes<HTMLTextAreaElement>, 'size'> {
  label?:    string;
  variant?:  TextareaVariant;
  size?:     TextareaSize;
  error?:    string;
  hint?:     string;
  required?: boolean;
}

const VARIANT_CLASSES: Record<TextareaVariant, string> = {
  default: 'border-[var(--color-border)] focus:border-[var(--color-primary)]',
  error: 'border-[var(--color-destructive)] focus:border-[var(--color-destructive)]',
};

const SIZE_CLASSES: Record<TextareaSize, string> = {
  sm: 'text-[0.8125rem] min-h-[4rem]',
  md: 'text-sm min-h-[5rem]',
  lg: 'text-base min-h-[7rem]',
};

export const Textarea = React.forwardRef<HTMLTextAreaElement, TextareaProps>(
  (
    { label, variant = 'default', size = 'md', error, hint, required, id: providedId, className, rows = 4, ...props },
    ref
  ) => {
    const generatedId = useId();
    const id = providedId || generatedId;
    const errorId = \`\${id}-error\`;
    const hintId = \`\${id}-hint\`;

    const cls = [
      'w-full rounded-[var(--radius-md)] border bg-[var(--color-surface)] text-[var(--color-text)] px-3 py-2 leading-relaxed resize-y outline-none transition-colors',
      'focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/30 focus-visible:ring-offset-0',
      'disabled:opacity-60 disabled:cursor-not-allowed disabled:bg-[var(--color-background)]',
      'placeholder:text-[var(--color-text-muted)]',
      (error ? 'error' : variant) === 'error' ? VARIANT_CLASSES.error : VARIANT_CLASSES[variant],
      SIZE_CLASSES[size],
      className || '',
    ].filter(Boolean).join(' ');

    const describedBy = [
      error ? errorId : null,
      hint ? hintId : null,
    ].filter(Boolean).join(' ') || undefined;

    return (
      <div className="flex flex-col gap-1.5">
        {label && (
          <label htmlFor={id} className="text-sm font-medium text-[var(--color-text)]">
            {label}
            {required && <span className="ml-0.5 text-[var(--color-destructive)]" aria-hidden="true">*</span>}
          </label>
        )}
        <textarea
          ref={ref}
          id={id}
          rows={rows}
          className={cls}
          aria-invalid={!!error}
          aria-describedby={describedBy}
          aria-required={required}
          {...props}
        />
        {hint && !error && (
          <span id={hintId} className="text-xs text-[var(--color-text-muted)]">
            {hint}
          </span>
        )}
        {error && (
          <span id={errorId} className="text-xs text-[var(--color-destructive)]" role="alert">
            {error}
          </span>
        )}
      </div>
    );
  }
);

Textarea.displayName = 'Textarea';
"
`;

exports[`Textarea snapshots > vue css mode snapshot 1`] = `
"<script setup lang="ts">
import { computed } from 'vue';

export type TextareaVariant = 'default' | 'error';
export type TextareaSize    = 'sm' | 'md' | 'lg';

interface Props {
  id?:          string;
  modelValue?:  string;
  label?:       string;
  placeholder?: string;
  variant?:     TextareaVariant;
  size?:        TextareaSize;
  error?:       string;
  hint?:        string;
  disabled?:    boolean;
  required?:    boolean;
  rows?:        number;
}

const props = withDefaults(defineProps<Props>(), {
  id: '',
  modelValue: '',
  label: '',
  placeholder: '',
  variant: 'default',
  size: 'md',
  error: '',
  hint: '',
  disabled: false,
  required: false,
  rows: 4,
});

const emit = defineEmits(['update:modelValue']);

const generatedId = \`textarea-\${Math.floor(Math.random() * 1000000)}\`;
const textareaId = computed(() => props.id || generatedId);
const errorId = computed(() => \`\${textareaId.value}-error\`);
const hintId = computed(() => \`\${textareaId.value}-hint\`);

const describedBy = computed(() => {
  const ids = [];
  if (props.error) ids.push(errorId.value);
  if (props.hint) ids.push(hintId.value);
  return ids.join(' ') || undefined;
});

const onInput = (event: Event) => {
  emit('update:modelValue', (event.target as HTMLTextAreaElement).value);
};

const textareaClasses = computed(() => [
  'textarea',
  \`textarea--\${props.size}\`,
  {
    'textarea--error': props.variant === 'error' || !!props.error,
    'textarea--disabled': props.disabled,
  },
]);
</script>

<template>
  <div class="textarea-container">
    <label v-if="label" :for="textareaId" class="label">
      {{ label }}
      <span v-if="required" class="required" aria-hidden="true">*</span>
    </label>

    <textarea
      :id="textareaId"
      :class="textareaClasses"
      :rows="rows"
      :placeholder="placeholder"
      :disabled="disabled"
      :value="modelValue"
      @input="onInput"
      :aria-invalid="!!error"
      :aria-required="required"
      :aria-describedby="describedBy"
    />

    <span v-if="hint && !error" :id="hintId" class="hint">{{ hint }}</span>
    <span v-if="error" :id="errorId" class="error" role="alert">{{ error }}</span>
  </div>
</template>

<style scoped>
/* Generated by Crucible — edit freely, re-generate with --force */

.textarea-container {
  display: flex;
  flex-direction: column;
  gap: calc(var(--spacing-unit, 4px) * 1.5);
}

.label {
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  font-weight: 500;
  font-size: 0.875rem;
  color: var(--color-text, #1A1A2E);
}

.required {
  color: var(--color-destructive, #E24B4A);
  margin-left: 2px;
}

.textarea {
  width: 100%;
  min-height: var(--textarea-min-height, calc(var(--spacing-unit) * 20));
  padding: var(--textarea-padding-y, calc(var(--spacing-unit) * 2))
    var(--textarea-padding-x, calc(var(--spacing-unit) * 3));
  border: 1px solid var(--textarea-border-color, var(--color-border));
  border-radius: var(--textarea-radius, var(--radius-md));
  font-family: inherit;
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--color-text, #1A1A2E);
  background-color: var(--color-surface, #FFFFFF);
  resize: vertical;
  outline: none;
  transition: var(--textarea-transition, border-color 0.2s ease, box-shadow 0.2s ease);
}

.textarea:focus-visible {
  border-color: var(--color-primary, #6C63FF);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary, #6C63FF) 20%, transparent);
}

.textarea::placeholder {
  color: var(--color-text-muted, #6B6B8A);
}

.textarea--sm {
  font-size: 0.8125rem;
  min-height: calc(var(--spacing-unit, 4px) * 16);
}

.textarea--lg {
  font-size: 1rem;
  min-height: calc(var(--spacing-unit, 4px) * 28);
}

.textarea--error {
  border-color: var(--color-destructive, #E24B4A);
}

.textarea--disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background-color: var(--color-background, #F8F9FA);
}

.hint {
  font-size: 0.75rem;
  color: var(--color-text-muted, #6B6B8A);
}

.error {
  font-size: 0.75rem;
  color: var(--color-destructive, #E24B4A);
}
</style>
"
`;
