import { Component, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-switch',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './switch.component.html',
})
export class SwitchComponent {
  @Input() checked = false;
  @Input() label = '';
  @Input() disabled = false;
  @Input() size: {{> shared/size-types}} = 'md';

  @Output() checkedChange = new EventEmitter<boolean>();

  id = 'switch-' + Math.random().toString(36).substring(2, 9);

  toggle(): void {
    if (this.disabled) return;
    this.checked = !this.checked;
    this.checkedChange.emit(this.checked);
  }

  getTrackClasses() {
    const trackSize: Record<string, string> = {
      sm: 'w-8 h-[18px]',
      md: 'w-10 h-[22px]',
      lg: 'w-12 h-[26px]',
    };

    return [
      'relative inline-flex items-center shrink-0 p-0 border-none rounded-full cursor-pointer transition-colors',
      'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]',
      'disabled:opacity-60 disabled:cursor-not-allowed',
      this.checked ? 'bg-[var(--switch-track-on,var(--color-primary))]' : 'bg-[var(--switch-track-off,var(--color-secondary))]',
      trackSize[this.size],
    ].join(' ');
  }

  getThumbClasses() {
    const thumbSize: Record<string, string> = {
      sm: 'w-3.5 h-3.5',
      md: 'w-[18px] h-[18px]',
      lg: 'w-[22px] h-[22px]',
    };

    const thumbTranslate: Record<string, string> = {
      sm: 'translate-x-[14px]',
      md: 'translate-x-[18px]',
      lg: 'translate-x-[22px]',
    };

    return [
      'absolute left-0.5 rounded-full bg-[var(--switch-thumb,#fff)] shadow transition-transform',
      thumbSize[this.size],
      this.checked ? thumbTranslate[this.size] : 'translate-x-0',
    ].join(' ');
  }
}
