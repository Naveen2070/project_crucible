.accordion-root {
  display: flex;
  flex-direction: column;
  width: 100%;
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  color: var(--color-text, #1a1a2e);
}

.accordion-root .item {
  border-bottom: 1px solid var(--accordion-border-color, {{tokens.componentTokens.accordion.borderColor}});
}

.accordion-root .header {
  margin: 0;
}

.accordion-root .trigger {
  all: unset;
  box-sizing: border-box;
  cursor: pointer;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-unit, 4px);
  padding: var(--accordion-trigger-padding-y, {{tokens.componentTokens.accordion.triggerPaddingY}})
    var(--accordion-trigger-padding-x, {{tokens.componentTokens.accordion.triggerPaddingX}});
  color: var(--accordion-trigger-color, {{tokens.componentTokens.accordion.triggerColor}});
  font-size: 0.875rem;
  font-weight: 500;
  text-align: left;
  transition: var(--accordion-transition, {{tokens.componentTokens.accordion.transition}});
}

.accordion-root .trigger:hover:not([data-disabled]) {
  background-color: var(--accordion-trigger-hover-bg, {{tokens.componentTokens.accordion.triggerHoverBg}});
}

.accordion-root .trigger[data-disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

{{#if a11y.focusRing}}
.accordion-root .trigger:focus-visible {
  outline: {{a11y.focusRingWidth}} solid {{a11y.focusRingColor}};
  outline-offset: calc(-1 * {{a11y.focusRingWidth}});
}
{{/if}}

.accordion-root .label {
  flex: 1;
  min-width: 0;
}

.accordion-root .chevron {
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.accordion-root .trigger[data-state='open'] .chevron {
  transform: rotate(180deg);
}

.accordion-root .content {
  padding-block: var(--accordion-content-padding-y, {{tokens.componentTokens.accordion.contentPaddingY}});
  padding-inline: var(--accordion-trigger-padding-x, {{tokens.componentTokens.accordion.triggerPaddingX}});
  color: var(--color-text, #1a1a2e);
}

.accordion-root .content[hidden] {
  display: none;
}

.accordion-root.size-sm .trigger {
  font-size: 0.8125rem;
}

.accordion-root.size-md .trigger {
  font-size: 0.875rem;
}

.accordion-root.size-lg .trigger {
  font-size: 0.9375rem;
}

.accordion-root.variant-bordered {
  border: 1px solid var(--accordion-border-color, {{tokens.componentTokens.accordion.borderColor}});
  border-radius: var(--accordion-radius, {{tokens.componentTokens.accordion.radius}});
  overflow: hidden;
}

.accordion-root.variant-bordered .item:last-child {
  border-bottom: none;
}

.accordion-root.variant-separated {
  gap: calc(var(--spacing-unit, 4px) * 2);
}

.accordion-root.variant-separated .item {
  border: 1px solid var(--accordion-border-color, {{tokens.componentTokens.accordion.borderColor}});
  border-radius: var(--accordion-radius, {{tokens.componentTokens.accordion.radius}});
  overflow: hidden;
}

{{#if a11y.reduceMotion}}
@media (prefers-reduced-motion: reduce) {
  .accordion-root .trigger,
  .accordion-root .chevron { transition: none; }
}
{{/if}}
