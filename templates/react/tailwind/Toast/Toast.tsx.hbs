import * as React from 'react';
import { createPortal } from 'react-dom';

// ===== Types =====
export type ToastVariant = 'default' | 'success' | 'error' | 'warning' | 'info' | 'loading';
export type ToastPosition =
  | 'top-left'
  | 'top-center'
  | 'top-right'
  | 'bottom-left'
  | 'bottom-center'
  | 'bottom-right';

export interface ToastAction {
  label: string;
  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;
}

export interface ToastOptions {
  id?: string | number;
  description?: React.ReactNode;
  duration?: number;
  variant?: ToastVariant;
  icon?: React.ReactNode;
  action?: ToastAction;
  cancel?: ToastAction;
  onDismiss?: (id: string | number) => void;
  onAutoClose?: (id: string | number) => void;
  className?: string;
}

interface ToastData extends ToastOptions {
  id: string | number;
  message: React.ReactNode;
  variant: ToastVariant;
  createdAt: number;
}

export interface ToasterProps {
  position?: ToastPosition;
  duration?: number;
  maxToasts?: number;
  richColors?: boolean;
  closeButton?: boolean;
  pauseWhenPageIsHidden?: boolean;
  className?: string;
}

// ===== Module-level store =====
let nextId = 1;
const state: { toasts: ToastData[]; listeners: Set<() => void> } = {
  toasts: [],
  listeners: new Set(),
};
const emit = () => state.listeners.forEach((l) => l());
const subscribe = (l: () => void) => {
  state.listeners.add(l);
  return () => {
    state.listeners.delete(l);
  };
};
const getSnapshot = () => state.toasts;

function upsert(
  partial: Partial<ToastOptions> & { message: React.ReactNode; variant: ToastVariant },
): string | number {
  const id = partial.id ?? nextId++;
  const idx = state.toasts.findIndex((t) => t.id === id);
  if (idx >= 0) {
    const merged: ToastData = { ...state.toasts[idx], ...partial, id };
    state.toasts = state.toasts.map((t, i) => (i === idx ? merged : t));
  } else {
    state.toasts = [...state.toasts, { id, createdAt: Date.now(), ...partial } as ToastData];
  }
  emit();
  return id;
}

function removeToast(id: string | number) {
  state.toasts = state.toasts.filter((t) => t.id !== id);
  emit();
}

function dismiss(id?: string | number) {
  if (id == null) {
    state.toasts.forEach((t) => t.onDismiss?.(t.id));
    state.toasts = [];
    emit();
    return;
  }
  const t = state.toasts.find((x) => x.id === id);
  if (!t) return;
  t.onDismiss?.(t.id);
  removeToast(id);
}

// ===== Public toast() =====
interface ToastFunction {
  (message: React.ReactNode, options?: ToastOptions): string | number;
  success: (m: React.ReactNode, o?: ToastOptions) => string | number;
  error: (m: React.ReactNode, o?: ToastOptions) => string | number;
  warning: (m: React.ReactNode, o?: ToastOptions) => string | number;
  info: (m: React.ReactNode, o?: ToastOptions) => string | number;
  loading: (m: React.ReactNode, o?: ToastOptions) => string | number;
  custom: (n: React.ReactNode, o?: ToastOptions) => string | number;
  dismiss: (id?: string | number) => void;
  promise: <T>(
    p: Promise<T>,
    msgs: {
      loading: React.ReactNode;
      success: React.ReactNode | ((v: T) => React.ReactNode);
      error: React.ReactNode | ((e: unknown) => React.ReactNode);
    },
    options?: ToastOptions,
  ) => string | number;
}

const toastFn = ((message: React.ReactNode, options: ToastOptions = {}) =>
  upsert({ ...options, message, variant: options.variant ?? 'default' })) as ToastFunction;

toastFn.success = (m, o) => upsert({ ...o, message: m, variant: 'success' });
toastFn.error = (m, o) => upsert({ ...o, message: m, variant: 'error' });
toastFn.warning = (m, o) => upsert({ ...o, message: m, variant: 'warning' });
toastFn.info = (m, o) => upsert({ ...o, message: m, variant: 'info' });
toastFn.loading = (m, o) =>
  upsert({ ...o, message: m, variant: 'loading', duration: o?.duration ?? Infinity });
toastFn.custom = (n, o) => upsert({ ...o, message: n, variant: o?.variant ?? 'default' });
toastFn.dismiss = dismiss;
toastFn.promise = (p, msgs, options) => {
  const id = upsert({ ...options, message: msgs.loading, variant: 'loading', duration: Infinity });
  p.then((v) =>
    upsert({
      id,
      message: typeof msgs.success === 'function' ? msgs.success(v) : msgs.success,
      variant: 'success',
      duration: options?.duration,
    }),
  ).catch((err) =>
    upsert({
      id,
      message: typeof msgs.error === 'function' ? msgs.error(err) : msgs.error,
      variant: 'error',
      duration: options?.duration,
    }),
  );
  return id;
};
export const toast = toastFn;

// ===== Tailwind class maps =====
const POSITION_CLASSES: Record<ToastPosition, string> = {
  'top-left': 'top-0 left-0',
  'top-center': 'top-0 left-1/2 -translate-x-1/2',
  'top-right': 'top-0 right-0',
  'bottom-left': 'bottom-0 left-0 flex-col-reverse',
  'bottom-center': 'bottom-0 left-1/2 -translate-x-1/2 flex-col-reverse',
  'bottom-right': 'bottom-0 right-0 flex-col-reverse',
};

const VARIANT_BORDER: Record<ToastVariant, string> = {
  default: 'border-l-[3px] border-l-[var(--color-border)]',
  success: 'border-l-[3px] border-l-[var(--color-success)]',
  error: 'border-l-[3px] border-l-[var(--color-destructive)]',
  warning: 'border-l-[3px] border-l-[#f59e0b]',
  info: 'border-l-[3px] border-l-[var(--color-primary)]',
  loading: 'border-l-[3px] border-l-[var(--color-text-muted)]',
};

const RICH_VARIANT: Record<ToastVariant, string> = {
  default: '',
  success: '!bg-[var(--color-success)] !text-white !border-transparent',
  error: '!bg-[var(--color-destructive)] !text-white !border-transparent',
  warning: '!bg-[#f59e0b] !text-[#1a1a2e] !border-transparent',
  info: '!bg-[var(--color-primary)] !text-[var(--color-primary-foreground)] !border-transparent',
  loading: '',
};

function DefaultIcon({ variant }: { variant: ToastVariant }) {
  if (variant === 'loading') {
    return (
      <span
        className="inline-block w-4 h-4 rounded-full border-2 border-[var(--color-border)] border-t-[var(--color-primary)] animate-[toast-spin_0.8s_linear_infinite] motion-reduce:animate-none"
        aria-hidden="true"
      />
    );
  }
  const path = {
    success: 'M20 6L9 17l-5-5',
    error: 'M18 6L6 18M6 6l12 12',
    warning: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
    info: 'M12 16v-4m0-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    default: '',
  }[variant];
  if (!path) return null;
  return (
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d={path} />
    </svg>
  );
}

interface ToastItemProps {
  toast: ToastData;
  defaultDuration: number;
  showCloseButton: boolean;
  richColors: boolean;
  pauseWhenPageIsHidden: boolean;
}

function ToastItem({
  toast: t,
  defaultDuration,
  showCloseButton,
  richColors,
  pauseWhenPageIsHidden,
}: ToastItemProps) {
  const [dataState, setDataState] = React.useState<'enter' | 'visible' | 'exit'>('enter');
  const duration = t.duration ?? defaultDuration;
  const startedAtRef = React.useRef<number>(Date.now());
  const remainingRef = React.useRef<number>(duration);
  const timerRef = React.useRef<number | null>(null);
  const dismissedRef = React.useRef(false);

  React.useEffect(() => {
    const raf = requestAnimationFrame(() => setDataState('visible'));
    return () => cancelAnimationFrame(raf);
  }, []);

  const handleAutoClose = React.useCallback(() => {
    if (dismissedRef.current) return;
    dismissedRef.current = true;
    if (timerRef.current) window.clearTimeout(timerRef.current);
    setDataState('exit');
    window.setTimeout(() => {
      t.onAutoClose?.(t.id);
      removeToast(t.id);
    }, 150);
  }, [t]);

  const handleDismiss = React.useCallback(() => {
    if (dismissedRef.current) return;
    dismissedRef.current = true;
    if (timerRef.current) window.clearTimeout(timerRef.current);
    setDataState('exit');
    window.setTimeout(() => {
      t.onDismiss?.(t.id);
      removeToast(t.id);
    }, 150);
  }, [t]);

  const startTimer = React.useCallback(() => {
    if (duration === Infinity || dismissedRef.current) return;
    startedAtRef.current = Date.now();
    if (timerRef.current) window.clearTimeout(timerRef.current);
    timerRef.current = window.setTimeout(handleAutoClose, remainingRef.current);
  }, [duration, handleAutoClose]);

  const pauseTimer = React.useCallback(() => {
    if (timerRef.current) {
      window.clearTimeout(timerRef.current);
      timerRef.current = null;
      remainingRef.current = Math.max(0, remainingRef.current - (Date.now() - startedAtRef.current));
    }
  }, []);

  React.useEffect(() => {
    dismissedRef.current = false;
    remainingRef.current = duration;
    startTimer();
    return () => {
      if (timerRef.current) window.clearTimeout(timerRef.current);
    };
  }, [t.variant, duration, startTimer]);

  React.useEffect(() => {
    if (!pauseWhenPageIsHidden) return;
    const onVis = () => {
      if (document.visibilityState === 'hidden') pauseTimer();
      else startTimer();
    };
    document.addEventListener('visibilitychange', onVis);
    return () => document.removeEventListener('visibilitychange', onVis);
  }, [pauseWhenPageIsHidden, pauseTimer, startTimer]);

  const isError = t.variant === 'error';
  const enterAnim =
    dataState === 'enter'
      ? 'animate-[toast-enter-bottom_250ms_cubic-bezier(0.16,1,0.3,1)]'
      : '';
  const exitAnim =
    dataState === 'exit'
      ? 'animate-[toast-exit_150ms_ease-in_forwards] pointer-events-none'
      : '';

  return (
    <li
      className={[
        'pointer-events-auto flex items-start gap-2 box-border',
        'bg-[var(--color-surface)] text-[var(--color-text)]',
        'border border-[var(--color-border)] rounded-[var(--radius-md,8px)]',
        'shadow-[0_10px_15px_-3px_rgba(0,0,0,0.1),0_4px_6px_-2px_rgba(0,0,0,0.05)]',
        'p-4 text-sm leading-tight min-w-[320px] max-w-[420px] w-full',
        'motion-reduce:animate-none',
        VARIANT_BORDER[t.variant],
        richColors ? RICH_VARIANT[t.variant] : '',
        enterAnim,
        exitAnim,
        t.className,
      ]
        .filter(Boolean)
        .join(' ')}
      data-state={dataState}
      role={isError ? 'alert' : 'status'}
      aria-live={isError ? 'assertive' : 'polite'}
      aria-atomic="true"
      onMouseEnter={pauseTimer}
      onMouseLeave={startTimer}
      onFocus={pauseTimer}
      onBlur={startTimer}
    >
      {(t.icon || t.variant !== 'default') && (
        <span className="shrink-0 w-[18px] h-[18px] inline-flex items-center justify-center mt-px">
          {t.icon ?? <DefaultIcon variant={t.variant} />}
        </span>
      )}
      <div className="flex-1 min-w-0 flex flex-col gap-0.5">
        <div className="font-medium leading-tight break-words">{t.message}</div>
        {t.description != null && (
          <div className="text-[13px] text-[var(--color-text-muted)] leading-tight break-words">
            {t.description}
          </div>
        )}
      </div>
      {t.action && (
        <button
          type="button"
          className="shrink-0 self-start px-2.5 py-1 text-xs font-medium font-inherit bg-[var(--color-secondary)] text-[var(--color-secondary-foreground)] border border-[var(--color-border)] rounded cursor-pointer transition-colors hover:bg-[var(--color-border)] focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] focus-visible:outline-offset-2"
          onClick={(e) => {
            t.action!.onClick(e);
            handleDismiss();
          }}
        >
          {t.action.label}
        </button>
      )}
      {showCloseButton && (
        <button
          type="button"
          className="shrink-0 w-5 h-5 p-0 bg-transparent border-none cursor-pointer opacity-60 text-lg leading-none text-current rounded inline-flex items-center justify-center transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] focus-visible:outline-offset-1 focus-visible:opacity-100"
          aria-label="Close notification"
          onClick={handleDismiss}
        >
          ×
        </button>
      )}
    </li>
  );
}

// Inline keyframes — injected once per app (no Tailwind config edit required)
const TOAST_KEYFRAMES = `
@keyframes toast-enter-bottom { from { opacity: 0; transform: translateY(100%) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes toast-enter-top { from { opacity: 0; transform: translateY(-100%) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes toast-exit { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(0.96); } }
@keyframes toast-spin { to { transform: rotate(360deg); } }
[data-position-side='top'] [data-state='enter'] { animation-name: toast-enter-top !important; }
`;

export function Toaster({
  position = 'bottom-right',
  duration = 4000,
  maxToasts = 5,
  richColors = false,
  closeButton = false,
  pauseWhenPageIsHidden = true,
  className,
}: ToasterProps) {
  const toasts = React.useSyncExternalStore(subscribe, getSnapshot, getSnapshot);
  const [mounted, setMounted] = React.useState(false);
  React.useEffect(() => setMounted(true), []);
  React.useEffect(() => {
    if (toasts.length > maxToasts) {
      const overflow = toasts.length - maxToasts;
      toasts.slice(0, overflow).forEach((t) => removeToast(t.id));
    }
  }, [toasts, maxToasts]);
  if (!mounted) return null;
  const positionSide = position.startsWith('top') ? 'top' : 'bottom';
  return createPortal(
    <>
      <style>{TOAST_KEYFRAMES}</style>
      <ol
        className={[
          'fixed z-[9999] flex flex-col gap-2 p-4 max-w-[420px] w-full list-none m-0 pointer-events-none font-[system-ui,_-apple-system,_sans-serif]',
          POSITION_CLASSES[position],
          className,
        ]
          .filter(Boolean)
          .join(' ')}
        data-position-side={positionSide}
        aria-label="Notifications"
      >
        {toasts.map((t) => (
          <ToastItem
            key={t.id}
            toast={t}
            defaultDuration={duration}
            showCloseButton={closeButton}
            richColors={richColors}
            pauseWhenPageIsHidden={pauseWhenPageIsHidden}
          />
        ))}
      </ol>
    </>,
    document.body,
  );
}

export default Toaster;
