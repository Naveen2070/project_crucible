import { Meta, StoryObj } from '@storybook/angular';
import { ProgressComponent } from './progress.component';

const meta: Meta<ProgressComponent> = {
  title: 'Crucible/Progress',
  component: ProgressComponent,
  tags: ['autodocs'],
  argTypes: {
    variant:       { control: 'select', options: {{> shared/variant-options}} },
    size:          { control: 'select', options: {{> shared/size-options}} },
    value:         { control: { type: 'range', min: 0, max: 100 } },
    indeterminate: { control: 'boolean' },
    label:         { control: 'text' },
  },
};

export default meta;
type Story = StoryObj<ProgressComponent>;

export const Default: Story = {
  args: { value: 60, max: 100, variant: 'linear', size: 'md', label: 'Upload progress' },
  render: (args) => ({
    props: args,
    template: `<div style="width:320px"><app-progress [value]="value" [max]="max" [variant]="variant" [size]="size" [label]="label" [indeterminate]="indeterminate"></app-progress></div>`,
  }),
};

export const Indeterminate: Story = {
  args: { variant: 'linear', indeterminate: true, label: 'Loading' },
  render: (args) => ({
    props: args,
    template: `<div style="width:320px"><app-progress [value]="value" [max]="max" [variant]="variant" [size]="size" [label]="label" [indeterminate]="indeterminate"></app-progress></div>`,
  }),
};

export const Circular: Story = {
  args: { variant: 'circular', value: 70, size: 'md', label: 'Loading 70%' },
