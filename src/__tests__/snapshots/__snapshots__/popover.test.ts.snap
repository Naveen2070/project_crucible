export const PopoverRoot = InternalRoot;
export const PopoverTrigger = InternalTrigger;
export const PopoverPortal = InternalPortal;
export const PopoverContent = InternalContent;
export const PopoverArrow = InternalArrow;
export const PopoverClose = InternalClose;

