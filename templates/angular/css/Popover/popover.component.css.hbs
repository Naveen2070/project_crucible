.popover-root {
  position: relative;
  display: inline-block;
}

.popover-trigger {
  cursor: pointer;
  display: inline-block;
}

.popover-content {
  position: absolute;
  z-index: var(--popover-z-index, {{tokens.componentTokens.popover.zIndex}});
  background: var(--popover-background, {{tokens.componentTokens.popover.background}});
  border: 1px solid var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-radius: var(--popover-radius, {{tokens.componentTokens.popover.radius}});
  box-shadow: var(--popover-shadow, {{tokens.componentTokens.popover.shadow}});
  padding: var(--popover-padding, {{tokens.componentTokens.popover.padding}});
  min-width: 200px;
  outline: none;
}

.popover-arrow {
  position: absolute;
  width: 8px;
  height: 8px;
  background: inherit;
  border: 1px solid transparent;
  transform: rotate(45deg);
}

.arrow-top {
  border-right-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-bottom-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-bottom {
  border-left-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-top-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-left {
  border-top-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-right-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

.arrow-right {
  border-left-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
  border-bottom-color: var(--popover-border, {{tokens.componentTokens.popover.border}});
}

/* Variants */
.variant-minimal {
  border: none;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

/* Sizes */
.size-sm {
  font-size: 0.875rem;
  padding: calc(var(--popover-padding) * 0.75);
}

.size-md {
  font-size: 1rem;
}

.size-lg {
  font-size: 1.125rem;
  padding: calc(var(--popover-padding) * 1.5);
}

/* Animation */
.content-open[data-state='open'] {
  animation: popover-show 150ms cubic-bezier(0.16, 1, 0.3, 1);
}

.popover-content[data-state='closed'] {
  animation: popover-hide 100ms ease-in;
}

/* Directional Animations */
.content-open[data-placement^='top'] {
  animation-name: popover-slide-down;
}
.content-open[data-placement^='bottom'] {
  animation-name: popover-slide-up;
}
.content-open[data-placement^='left'] {
  animation-name: popover-slide-right;
}
.content-open[data-placement^='right'] {
  animation-name: popover-slide-left;
}

@keyframes popover-show {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes popover-hide {
  from {
    opacity: 1;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(0.96);
  }
}

@keyframes popover-slide-up {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-down {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popover-slide-left {
  from {
    opacity: 0;
    transform: translateX(4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes popover-slide-right {
  from {
    opacity: 0;
    transform: translateX(-4px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}


