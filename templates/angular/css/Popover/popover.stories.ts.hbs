export const Controlled: Story = {
  render: (args) => ({
    props: {
      ...args,
      controlledOpen: false,
      setOpen(this: any, val: boolean) {
        this.controlledOpen = val;
      }

    },
    template: `
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: center;">
        <button class="btn btn--primary" (click)="controlledOpen = !controlledOpen">
          Externally Toggle: \{{controlledOpen ? 'Close' : 'Open'}}
        </button>
        
        <app-popover [placement]="placement" [trigger]="trigger" [variant]="variant" [size]="size" [showArrow]="showArrow" [isOpen]="controlledOpen" (isOpenChange)="setOpen($event)">
          {{#if features.compoundComponents}}
          <button popover-trigger type="button" class="btn btn--outline">Popover Trigger</button>
          <div popover-content style="display: flex; flex-direction: column; gap: 8px;">
            <p style="margin: 0 0 8px 0;">I am controlled by external state.</p>
            <button class="btn btn--sm" (click)="setOpen(false)">Close me</button>
          </div>
          {{else}}
          <button trigger type="button" class="btn btn--outline">Popover Trigger</button>
          <div>
            <p style="margin: 0 0 8px 0;">I am controlled by external state.</p>
            <button class="btn btn--sm" (click)="setOpen(false)">Close me</button>
          </div>
          {{/if}}
        </app-popover>
      </div>
    `,
  }),
};
