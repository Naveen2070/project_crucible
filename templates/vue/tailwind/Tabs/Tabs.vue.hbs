<script lang="ts">
import {
  defineComponent,
  h,
  inject,
  provide,
  reactive,
  computed,
{{#if vueUseId}}  useId,{{else}}  getCurrentInstance,{{/if}}
  onMounted,
  onBeforeUnmount,
  ref,
  type InjectionKey,
} from 'vue';
import { RovingFocusManager } from './utils/roving-focus';

export type TabsSize = 'sm' | 'md' | 'lg';
export type TabsVariant = 'default' | 'underline' | 'pills';
export type TabsOrientation = 'horizontal' | 'vertical';
export type TabsActivationMode = 'manual' | 'automatic';

export interface TabsItem {
  value: string;
  label: string;
  content?: string;
  disabled?: boolean;
}

export interface TabsApi {
  readonly value: string | undefined;
  setValue: (next: string) => void;
  orientation: TabsOrientation;
  activationMode: TabsActivationMode;
  rootId: string;
  variant: TabsVariant;
  size: TabsSize;
  registerTrigger: (val: string, disabled: boolean, el: HTMLButtonElement | null) => void;
  moveFocus: (current: string, direction: 1 | -1) => string | null;
  focusEdge: (edge: 'first' | 'last') => string | null;
}

export const TabsContextKey: InjectionKey<TabsApi> = Symbol('crucible-tabs');

function useTabsApi(): TabsApi {
  const ctx = inject(TabsContextKey, null);
  if (!ctx) throw new Error('Tabs sub-components must be used inside <Tabs />');
  return ctx;
}

export const buildTriggerId = (rootId: string, value: string) =>
  `${rootId}-trigger-${value.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
export const buildContentId = (rootId: string, value: string) =>
  `${rootId}-content-${value.replace(/[^a-zA-Z0-9_-]/g, '_')}`;

const TW = {
  root: 'flex w-full flex-col data-[orientation=vertical]:flex-row data-[orientation=vertical]:items-start',
  list: 'flex flex-row items-center gap-[var(--tabs-list-gap,4px)] shrink-0 data-[orientation=vertical]:flex-col data-[orientation=vertical]:items-stretch',
  trigger:
    'inline-flex items-center justify-center whitespace-nowrap px-[var(--tabs-trigger-padding-x,12px)] rounded-[var(--tabs-trigger-radius,6px)] text-[var(--tabs-trigger-color,var(--color-text-muted))] text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed hover:not-data-[disabled]:not-data-[state=active]:bg-[var(--tabs-trigger-hover-bg,var(--color-secondary))] data-[state=active]:text-[var(--tabs-trigger-active-color,var(--color-text))] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]',
  content:
    'flex-1 py-[var(--tabs-content-padding-y,16px)] text-[var(--color-text)] outline-none data-[orientation=vertical]:py-0 data-[orientation=vertical]:px-[var(--tabs-content-padding-y,16px)]',
  variantList: {
    default: 'border-b border-[var(--color-border)]',
    underline: 'border-b border-[var(--color-border)]',
    pills: '',
  } as Record<TabsVariant, string>,
  variantTriggerActive: {
    default:
      'data-[state=active]:shadow-[inset_0_-2px_0_var(--tabs-trigger-active-indicator,var(--color-primary))]',
    underline:
      'data-[state=active]:shadow-[inset_0_-2px_0_var(--tabs-trigger-active-indicator,var(--color-primary))] !rounded-none',
    pills:
      'data-[state=active]:bg-[var(--tabs-trigger-active-bg,var(--color-surface))] data-[state=active]:shadow-sm',
  } as Record<TabsVariant, string>,
  sizeTrigger: {
    sm: 'h-[var(--tabs-trigger-h,32px)] text-[0.8125rem]',
    md: 'h-[var(--tabs-trigger-h,36px)] text-sm',
    lg: 'h-[var(--tabs-trigger-h,44px)] text-[0.9375rem]',
  } as Record<TabsSize, string>,
};

export const TabsList = defineComponent({
  name: 'TabsList',
  setup(_, { slots }) {
    const tabs = useTabsApi();
    const onKeyDown = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const currentValue = target.getAttribute('data-value') ?? tabs.value ?? '';
      const isHorizontal = tabs.orientation === 'horizontal';
      const nextKey = isHorizontal ? 'ArrowRight' : 'ArrowDown';
      const prevKey = isHorizontal ? 'ArrowLeft' : 'ArrowUp';
      let nextValue: string | null = null;
      if (e.key === nextKey) { e.preventDefault(); nextValue = tabs.moveFocus(currentValue, 1); }
      else if (e.key === prevKey) { e.preventDefault(); nextValue = tabs.moveFocus(currentValue, -1); }
      else if (e.key === 'Home') { e.preventDefault(); nextValue = tabs.focusEdge('first'); }
      else if (e.key === 'End') { e.preventDefault(); nextValue = tabs.focusEdge('last'); }
      if (nextValue && tabs.activationMode === 'automatic') tabs.setValue(nextValue);
    };
    return () =>
      h(
        'div',
        {
          class: [TW.list, TW.variantList[tabs.variant]],
          role: 'tablist',
          'aria-orientation': tabs.orientation,
          'data-orientation': tabs.orientation,
          onKeydown: onKeyDown,
        },
        slots.default?.(),
      );
  },
});

export const TabsTrigger = defineComponent({
  name: 'TabsTrigger',
  props: {
    value: { type: String, required: true },
    disabled: { type: Boolean, default: false },
  },
  setup(props, { slots }) {
    const tabs = useTabsApi();
    const elRef = ref<HTMLButtonElement | null>(null);
    onMounted(() => tabs.registerTrigger(props.value, props.disabled, elRef.value));
    onBeforeUnmount(() => tabs.registerTrigger(props.value, props.disabled, null));
    return () => {
      const isActive = tabs.value === props.value;
      return h(
        'button',
        {
          ref: (el: any) => (elRef.value = el as HTMLButtonElement | null),
          type: 'button',
          role: 'tab',
          id: buildTriggerId(tabs.rootId, props.value),
          'aria-selected': isActive,
          'aria-controls': buildContentId(tabs.rootId, props.value),
          'data-state': isActive ? 'active' : 'inactive',
          'data-value': props.value,
          'data-disabled': props.disabled ? '' : undefined,
          disabled: props.disabled,
          tabindex: isActive ? 0 : -1,
          class: [TW.trigger, TW.sizeTrigger[tabs.size], TW.variantTriggerActive[tabs.variant]],
          onClick: () => { if (!props.disabled) tabs.setValue(props.value); },
        },
        slots.default?.(),
      );
    };
  },
});

export const TabsContent = defineComponent({
  name: 'TabsContent',
  props: {
    value: { type: String, required: true },
    forceMount: { type: Boolean, default: false },
  },
  setup(props, { slots }) {
    const tabs = useTabsApi();
    return () => {
      const isActive = tabs.value === props.value;
      if (!isActive && !props.forceMount) return null;
      return h(
        'div',
        {
          role: 'tabpanel',
          id: buildContentId(tabs.rootId, props.value),
          'aria-labelledby': buildTriggerId(tabs.rootId, props.value),
          'data-state': isActive ? 'active' : 'inactive',
          'data-orientation': tabs.orientation,
          hidden: !isActive,
          tabindex: 0,
          class: TW.content,
        },
        slots.default?.(),
      );
    };
  },
});
</script>

<script setup lang="ts">
const props = withDefaults(
  defineProps<{
    variant?: TabsVariant;
    size?: TabsSize;
    value?: string;
    defaultValue?: string;
    orientation?: TabsOrientation;
    activationMode?: TabsActivationMode;
    items?: TabsItem[];
  }>(),
  { variant: 'default', size: 'md', orientation: 'horizontal', activationMode: 'manual', items: () => [] },
);

const emit = defineEmits<{
  (e: 'update:value', value: string): void;
  (e: 'valueChange', value: string): void;
}>();

{{#if vueUseId}}
const uid = useId();
{{else}}
const uid = (getCurrentInstance()?.uid ?? 0).toString(36);
{{/if}}
const rootId = `tabs-${uid}`;
const roving = new RovingFocusManager();
const internal = reactive({ value: props.value ?? props.defaultValue ?? props.items?.[0]?.value });

const setValue = (next: string) => {
  if (props.value === undefined) internal.value = next;
  emit('update:value', next);
  emit('valueChange', next);
};

const registerTrigger = (val: string, disabled: boolean, el: HTMLButtonElement | null) =>
  roving.register(val, disabled, el);

const focusTrigger = (val: string) => roving.focus(val);

const moveFocus = (current: string, direction: 1 | -1) => roving.moveFocus(current, direction);

const focusEdge = (edge: 'first' | 'last') => roving.focusEdge(edge);

const api: TabsApi = {
  get value() { return props.value ?? internal.value; },
  setValue,
  get orientation() { return props.orientation; },
  get activationMode() { return props.activationMode; },
  rootId,
  get variant() { return props.variant; },
  get size() { return props.size; },
  registerTrigger,
  moveFocus,
  focusEdge,
};

provide(TabsContextKey, api);

const tw = TW;
</script>

<template>
  <div :class="tw.root" :data-orientation="orientation" :data-variant="variant" :data-size="size">
    {{#if features.compoundComponents}}
    <slot :api="api" />
    {{else}}
    <TabsList>
      <TabsTrigger v-for="item in items" :key="item.value" :value="item.value" :disabled="item.disabled">
        <slot :name="`trigger-${item.value}`" :item="item">\{{ item.label }}</slot>
      </TabsTrigger>
    </TabsList>
    <TabsContent v-for="item in items" :key="item.value" :value="item.value">
      <slot :name="`content-${item.value}`" :item="item">\{{ item.content }}</slot>
    </TabsContent>
    {{/if}}
  </div>
</template>
