export const Controlled: Story = {
  render: (args) => ({
    components: { Popover, Button },
    setup() {
      const isOpen = ref(false);
      return { args, isOpen };
    },
    template: `
      <div style="display: flex; flex-direction: column; gap: 20px; align-items: center;">
        <Button @click="isOpen = !isOpen">
          Externally Toggle: \{{isOpen ? 'Close' : 'Open'}}
        </Button>
        
        <Popover v-bind="args" v-model:isOpen="isOpen">
          {{#if features.compoundComponents}}
          <template #trigger>
            <Button variant="outline">Popover Trigger</Button>
          </template>
          <template #content>
            <p style="margin: 0 0 8px 0;">I am controlled by external state.</p>
            <Button size="sm" @click="isOpen = false">Close me</Button>
          </template>
          {{else}}
          <template #trigger>
            <Button variant="outline">Popover Trigger</Button>
          </template>
          <div>
            <p style="margin: 0 0 8px 0;">I am controlled by external state.</p>
            <Button size="sm" @click="isOpen = false">Close me</Button>
          </div>
          {{/if}}
        </Popover>
      </div>
    `,
  }),
};

