exports[`React Native snapshots > StyleSystem: stylesheet > Component: Badge > renders correctly 1`] = `
{
  "Badge.stories.tsx": "// Crucible preview examples for Badge (React Native / StyleSheet).
// ponytail: Storybook for React Native isn't wired up in this release (needs Expo +
// @storybook/react-native) — these are ready-to-spread prop presets for manual/visual QA
// (e.g. \`<Badge {...BadgePreviews.default}>New</Badge>\`), not a Storybook CSF file.
import type { BadgeProps } from './Badge';

export const BadgePreviews: Record<string, BadgeProps> = {
  default: { variant: 'default' },
  primary: { variant: 'primary' },
  secondary: { variant: 'secondary' },
  outline: { variant: 'outline' },
  success: { variant: 'success' },
  warning: { variant: 'warning' },
  destructive: { variant: 'destructive' },
  smSize: { size: 'sm' },
  mdSize: { size: 'md' },
  lgSize: { size: 'lg' },
};
",
  "Badge.tsx": "import React from 'react';
import { Text, StyleSheet, type TextProps } from 'react-native';
import { theme } from '../../../theme';

export type BadgeVariant = 'default' | 'primary' | 'secondary' | 'outline' | 'success' | 'warning' | 'destructive';
export type BadgeSize    = 'sm' | 'md' | 'lg';

export interface BadgeProps extends TextProps {
  variant?: BadgeVariant;
  size?:    BadgeSize;
}

const variantStyles: Record<BadgeVariant, object> = {
  default:     { backgroundColor: theme.colorSecondary, color: theme.foreground },
  primary:     { backgroundColor: theme.colorPrimary, color: '#ffffff' },
  secondary:   { backgroundColor: theme.colorSecondary, color: theme.foreground },
  outline:     { backgroundColor: 'transparent', borderWidth: 1, borderColor: theme.colorBorder, color: theme.foreground },
  success:     { backgroundColor: theme.colorSuccess, color: '#ffffff' },
  warning:     { backgroundColor: '#f59e0b', color: '#ffffff' },
  destructive: { backgroundColor: theme.colorDestructive, color: '#ffffff' },
};

const sizeStyles: Record<BadgeSize, object> = {
  sm: { fontSize: 11, paddingHorizontal: 6,  paddingVertical: 2 },
  md: { fontSize: 12, paddingHorizontal: 8,  paddingVertical: 2 },
  lg: { fontSize: 13, paddingHorizontal: 10, paddingVertical: 4 },
};

const styles = StyleSheet.create({
  base: { alignSelf: 'flex-start', borderRadius: Number.parseInt(theme.radiusSm, 10) || 4, fontWeight: '500' },
});

// ponytail: RN \`Text\` (unlike \`View\`) can hold background/padding/radius AND its own text color
// at once, so — unlike Button — Badge needs no separate container element or inheritance trick.
export const Badge = React.forwardRef<Text, BadgeProps>(
  ({ variant = 'default', size = 'md', style, children, ...props }, ref) => {
    return (
      <Text ref={ref} style={[styles.base, variantStyles[variant], sizeStyles[size], style]} {...props}>
        {children}
      </Text>
    );
  }
);

Badge.displayName = 'Badge';
