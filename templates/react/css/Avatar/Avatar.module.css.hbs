.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  background-color: var(--avatar-fallback-bg, {{tokens.componentTokens.avatar.fallbackBg}});
  color: var(--avatar-fallback-color, {{tokens.componentTokens.avatar.fallbackColor}});
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
  font-weight: var(--avatar-font-weight, {{tokens.componentTokens.avatar.fontWeight}});
  line-height: 1;
  user-select: none;
}

/* Shapes */
.avatar--circle {
  border-radius: 9999px;
}

.avatar--square {
  border-radius: var(--avatar-radius, {{tokens.componentTokens.avatar.radius}});
}

/* Sizes */
.avatar--xs {
  width: 24px;
  height: 24px;
  font-size: 0.625rem;
}

.avatar--sm {
  width: 32px;
  height: 32px;
  font-size: 0.75rem;
}

.avatar--md {
  width: 40px;
  height: 40px;
  font-size: 0.875rem;
}

.avatar--lg {
  width: 56px;
  height: 56px;
  font-size: 1.125rem;
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-fallback {
  line-height: 1;
}
