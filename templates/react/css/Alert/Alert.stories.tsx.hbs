{{> react/stories-header}}
  argTypes: {
    variant:   { control: 'select', options: {{> shared/variant-options}} },
    title:     { control: 'text' },
    closeable: { control: 'boolean' },
  },
{{> react/stories-footer}}

export const Default: Story = {
  args: { variant: 'default', title: 'Heads up', children: 'This is a general message for your attention.' },
  render: ({ children, ...args }) => <Alert {...args}>{children}</Alert>,
};

{{#each variants}}
{{#unless (eq this "default")}}
export const {{capitalize this}}: Story = {
  args: { variant: '{{this}}', title: '{{capitalize this}}', children: 'This is a {{this}} alert message.' },
  render: ({ children, ...args }) => <Alert {...args}>{children}</Alert>,
};
{{/unless}}
{{/each}}

export const Closeable: Story = {
  args: { variant: 'info', title: 'Dismissible', children: 'Click the × to dismiss this alert.', closeable: true },
  render: ({ children, ...args }) => <Alert {...args}>{children}</Alert>,
};

export const TitleOnly: Story = {
  args: { variant: 'success', title: 'Saved successfully' },
  render: (args) => <Alert {...args} />,
};
