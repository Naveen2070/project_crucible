export const DismissAndCustom: Story = {
  render: (args) => ({
    components: { Toaster, Button },
    setup() {
      const stackThree = () => {
        toast('First');
        window.setTimeout(() => toast.success('Second'), 200);
        window.setTimeout(() => toast.info('Third'), 400);
      };
      const dismissAll = () => toast.dismiss();
      return { args, stackThree, dismissAll };
    },
    template: `
      <Toaster v-bind="args" />
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        <Button @click="stackThree">Stack 3 toasts</Button>
        <Button variant="outline" @click="dismissAll">Dismiss all</Button>
      </div>
    `,
  }),
};
