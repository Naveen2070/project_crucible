exports[`Breadcrumb snapshots > angular css mode snapshot (monolithic) 1`] = `
"import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

type DisplayItem = BreadcrumbItem & { ellipsis?: boolean };

@Component({
  selector: 'app-breadcrumb',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './breadcrumb.component.html',
  styleUrls: ['./breadcrumb.component.css'],
})
export class BreadcrumbComponent {
  @Input() items: BreadcrumbItem[] = [];
  @Input() separator = '/';
  @Input() maxItems = 0;
  @Input() size: 'sm' | 'md' | 'lg' = 'md';

  get display(): DisplayItem[] {
    const items = this.items;
    if (this.maxItems && this.maxItems >= 2 && items.length > this.maxItems) {
      return [items[0], { label: '…', ellipsis: true }, ...items.slice(items.length - (this.maxItems - 1))];
    }
    return items;
  }
}
"
`;

exports[`Breadcrumb snapshots > angular css mode snapshot (monolithic) 2`] = `
"<nav
  aria-label="Breadcrumb"
  class="breadcrumb"
  [class.breadcrumb--sm]="size === 'sm'"
  [class.breadcrumb--md]="size === 'md'"
  [class.breadcrumb--lg]="size === 'lg'"
>
  <ol class="breadcrumb-list">
    @for (item of display; track $index) {
      <li class="breadcrumb-item">
        @if (item.ellipsis) {
          <span class="breadcrumb-ellipsis" aria-hidden="true">{{ item.label }}</span>
        } @else if (item.href && !$last) {
          <a [href]="item.href" class="breadcrumb-link">{{ item.label }}</a>
        } @else {
          <span class="breadcrumb-current" [attr.aria-current]="$last ? 'page' : null">{{ item.label }}</span>
        }
        @if (!$last) {
          <span class="breadcrumb-separator" aria-hidden="true">{{ separator }}</span>
        }
      </li>
    }
  </ol>
</nav>
"
`;

exports[`Breadcrumb snapshots > react css mode snapshot 1`] = `
"import React from 'react';
import styles from './Breadcrumb.module.css';
export type BreadcrumbSize = 'sm' | 'md' | 'lg';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

type DisplayItem = BreadcrumbItem & { ellipsis?: boolean };

export interface BreadcrumbProps extends Omit<React.HTMLAttributes<HTMLElement>, 'children'> {
  /** Ordered trail of crumbs (last item is the current page) */
  items: BreadcrumbItem[];
  /** Separator between crumbs */
  separator?: React.ReactNode;
  size?: BreadcrumbSize;
  /** Collapse the middle of long trails to an ellipsis */
  maxItems?: number;
}

function buildDisplay(items: BreadcrumbItem[], maxItems?: number): DisplayItem[] {
  if (maxItems && maxItems >= 2 && items.length > maxItems) {
    return [items[0], { label: '…', ellipsis: true }, ...items.slice(items.length - (maxItems - 1))];
  }
  return items;
}

export const Breadcrumb = React.forwardRef<HTMLElement, BreadcrumbProps>(
  ({ items, separator = '/', size = 'md', maxItems, className, ...props }, ref) => {
    const display = buildDisplay(items, maxItems);
    const cls = [styles.breadcrumb, styles[\`breadcrumb--\${size}\`], className].filter(Boolean).join(' ');

    return (
      <nav ref={ref} aria-label="Breadcrumb" className={cls} {...props}>
        <ol className={styles['breadcrumb-list']}>
          {display.map((item, i) => {
            const isLast = i === display.length - 1;
            return (
              <li key={i} className={styles['breadcrumb-item']}>
                {item.ellipsis ? (
                  <span className={styles['breadcrumb-ellipsis']} aria-hidden="true">{item.label}</span>
                ) : item.href && !isLast ? (
                  <a href={item.href} className={styles['breadcrumb-link']}>{item.label}</a>
                ) : (
                  <span className={styles['breadcrumb-current']} aria-current={isLast ? 'page' : undefined}>
                    {item.label}
                  </span>
                )}
                {!isLast && (
                  <span className={styles['breadcrumb-separator']} aria-hidden="true">
                    {separator}
                  </span>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
    );
  }
);

Breadcrumb.displayName = 'Breadcrumb';
"
`;

exports[`Breadcrumb snapshots > react css mode snapshot 2`] = `
".breadcrumb {
  font-family: var(--font-family, system-ui, -apple-system, sans-serif);
}

.breadcrumb-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--breadcrumb-gap, calc(var(--spacing-unit) * 2));
  margin: 0;
  padding: 0;
  list-style: none;
}

.breadcrumb-item {
  display: inline-flex;
  align-items: center;
  gap: var(--breadcrumb-gap, calc(var(--spacing-unit) * 2));
}

.breadcrumb-link {
  color: var(--breadcrumb-link-color, var(--color-text-muted));
  text-decoration: none;
}

.breadcrumb-link:hover {
  color: var(--breadcrumb-active-color, var(--color-text));
  text-decoration: underline;
}

.breadcrumb-link:focus-visible {
  outline: 2px solid var(--color-primary, #6C63FF);
  outline-offset: 2px;
  border-radius: 2px;
}

.breadcrumb-current {
  color: var(--breadcrumb-active-color, var(--color-text));
  font-weight: 500;
}

.breadcrumb-separator,
.breadcrumb-ellipsis {
  color: var(--breadcrumb-separator-color, var(--color-text-muted));
  user-select: none;
}

.breadcrumb--sm {
  font-size: 0.75rem;
}

.breadcrumb--md {
  font-size: 0.875rem;
}

.breadcrumb--lg {
  font-size: 1rem;
}
"
`;

