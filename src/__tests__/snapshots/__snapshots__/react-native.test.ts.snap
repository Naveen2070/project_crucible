exports[`React Native snapshots > StyleSystem: nativewind > Component: Alert > renders correctly 1`] = `
{
  "Alert.stories.tsx": "// Crucible preview examples for Alert (React Native / NativeWind).
// ponytail: Storybook for React Native isn't wired up in this release (needs Expo +
// @storybook/react-native) — these are ready-to-spread prop presets for manual/visual QA
// (e.g. \`<Alert {...AlertPreviews.info}>Message</Alert>\`), not a Storybook CSF file.
import type { AlertProps } from './Alert';

export const AlertPreviews: Record<string, AlertProps> = {
  default: { variant: 'default', title: 'Default' },
  info: { variant: 'info', title: 'Info' },
  success: { variant: 'success', title: 'Success' },
  warning: { variant: 'warning', title: 'Warning' },
  destructive: { variant: 'destructive', title: 'Destructive' },
  closeable: { variant: 'info', title: 'Dismissible', closeable: true },
};
",
  "Alert.tsx": "import React from 'react';
import { View, Text, Pressable, type ViewProps } from 'react-native';

export type AlertVariant = 'default' | 'info' | 'success' | 'warning' | 'destructive';

export interface AlertProps extends ViewProps {
  variant?:   AlertVariant;
  title?:     string;
  closeable?: boolean;
  onClose?:   () => void;
  icon?:      React.ReactNode;
  children?:  React.ReactNode;
  className?: string;
}

const DEFAULT_ICONS: Record<AlertVariant, string> = {
  default: 'ℹ',
  info: 'ℹ',
  success: '✓',
  warning: '⚠',
  destructive: '✕',
};

const VARIANT_CLASSES: Record<AlertVariant, string> = {
  default: 'bg-surface border-border text-foreground',
  info: 'bg-primary/10 border-primary text-foreground',
  success: 'bg-success/10 border-success text-foreground',
  warning: 'bg-[#f59e0b]/10 border-[#f59e0b] text-foreground',
  destructive: 'bg-destructive/10 border-destructive text-foreground',
};

// ponytail: title/description/icon carry no color of their own — they inherit \`text-*\` from the
// container's className via NativeWind's style inheritance, same pattern as Button.Label.
export const Alert = React.forwardRef<View, AlertProps>(
  ({ variant = 'default', title, closeable = false, onClose, icon, className, children, ...props }, ref) => {
    const cls = [
      'flex-row items-start gap-3 p-3 rounded-md border',
      VARIANT_CLASSES[variant],
      className || '',
    ].filter(Boolean).join(' ');

    return (
      <View ref={ref} accessibilityRole="alert" className={cls} {...props}>
        <Text className="leading-snug" accessibilityElementsHidden importantForAccessibility="no-hide-descendants">
          {icon ?? DEFAULT_ICONS[variant]}
        </Text>
        <View className="flex-1">
          {title && <Text className="font-semibold text-sm mb-0.5">{title}</Text>}
          {children && (typeof children === 'string' ? <Text className="text-[0.8125rem]">{children}</Text> : children)}
        </View>
        {closeable && (
          <Pressable
            className="active:opacity-60"
            onPress={onClose}
            accessibilityRole="button"
            accessibilityLabel="Dismiss"
          >
            <Text className="text-lg leading-none">×</Text>
          </Pressable>
        )}
      </View>
    );
  }
);

Alert.displayName = 'Alert';
",
  "README.md": "# Alert

