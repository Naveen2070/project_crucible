import { moduleMetadata } from '@storybook/angular';
import type { Meta, StoryObj } from '@storybook/angular';
import { TabsComponent, TabTemplateDirective } from './tabs.component';

const meta: Meta<TabsComponent> = {
  title: 'Crucible/Tabs',
  component: TabsComponent,
  tags: ['autodocs'],
  argTypes: {
    variant: { control: 'select', options: ['default', 'underline', 'pills'] },
    size: { control: 'select', options: ['sm', 'md', 'lg'] },
    orientation: { control: 'select', options: ['horizontal', 'vertical'] },
    activationMode: { control: 'select', options: ['manual', 'automatic'] },
  },
  args: { variant: 'default', size: 'md', orientation: 'horizontal', activationMode: 'manual' },
};

export default meta;
type Story = StoryObj<TabsComponent>;

const onValueChange = (value: string) => console.log('Tab changed:', value);

const baseItems = [
  { value: 'overview', label: 'Overview', content: 'Overview panel content.' },
  { value: 'analytics', label: 'Analytics', content: 'Analytics panel.' },
  { value: 'settings', label: 'Settings', content: 'Settings panel.' },
];

export const Default: Story = {
  args: { items: baseItems, defaultValue: 'overview' },
  render: (args) => ({
    props: { ...args, onValueChange },
    template: `<app-tabs
      [items]="items"
      [defaultValue]="defaultValue"
      [variant]="variant"
      [size]="size"
      [orientation]="orientation"
      [activationMode]="activationMode"
      (valueChange)="onValueChange($event)"
    ></app-tabs>`,
  }),
};

