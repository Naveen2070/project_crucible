/**
 * Custom per-tab content + trigger via the `appTabTemplate` directive on `<ng-template>`.
 * Falls back to `item.label` / `item.content` when no template is provided for a tab.
 */
export const WithTemplates: Story = {
  args: {
    items: [
      { value: 'home', label: 'Home', content: 'Default home panel.' },
      { value: 'profile', label: 'Profile', content: 'Default profile panel.' },
      { value: 'inbox', label: 'Inbox', content: 'Default inbox panel.' },
    ],
    defaultValue: 'home',
  },
  decorators: [moduleMetadata({ imports: [TabTemplateDirective] })],
  render: (args) => ({
    props: { ...args, onValueChange },
    template: `<app-tabs
      [items]="items"
      [defaultValue]="defaultValue"
      [variant]="variant"
      [size]="size"
      [orientation]="orientation"
      [activationMode]="activationMode"
      (valueChange)="onValueChange($event)"
    >
      <ng-template appTabTemplate="home" appTabTemplateSlot="trigger">
        <span style="display:inline-flex; align-items:center; gap:6px">
          <span style="width:8px; height:8px; border-radius:9999px; background: var(--color-primary)"></span>
          Home
        </span>
      </ng-template>
      <ng-template appTabTemplate="inbox" appTabTemplateSlot="trigger" let-item>
        <span style="display:inline-flex; align-items:center; gap:6px">
          ✋ {{ item.label }} <strong style="font-size:0.75rem">3</strong>
        </span>
      </ng-template>
      <ng-template appTabTemplate="profile" appTabTemplateSlot="content">
        <div style="padding: 12px; border: 1px dashed var(--color-border); border-radius: 8px">
          <strong>Custom profile panel</strong> — supplied via appTabTemplate.
        </div>
      </ng-template>
    </app-tabs>`,
  }),
};
